{% extends 'base.html.twig' %}
{% block title %}Folio Browser{% endblock %}
{% block body %}
<div class="container-xl py-4">
    <h1>Folios</h1>
    <ul>
        {% for folio in folios %}
            <li><a href="{{ path('survos_folio_show', {folioCode: folio.datasetKey}) }}">{{ folio.title ?? folio.datasetKey }}</a></li>
        {% else %}
            <li>No published folios in the configured catalog.</li>
        {% endfor %}
    </ul>
</div>
{% endblock %}
