{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set title = attribute(row.dtoData, 'title')|default(row.label ?: row.localId) %}
{% set description = attribute(row.dtoData, 'description')|default(attribute(row.extras, 'dcterms:description')|default(null)) %}

{% block title %}Ask the Scholar · {{ title }}{% endblock %}

{% block body %}
    <div class="container-xl py-4 py-lg-5">
        <div class="mb-3">
            <a class="text-decoration-none text-secondary" href="{{ path('survos_folio_row_show', {
                provider: provider,
                dataset: dataset,
                coreCode: core.code,
                dtoType: row.dtoType ?: 'row',
                localId: row.localId,
            }) }}">
                {{ ux_icon('tabler:arrow-left', {class: 'icon'}) }} {{ title }}
            </a>
        </div>

        <div class="row g-3">
            <div class="col-lg-7">
                <div class="card mb-3">
                    <div class="card-header">
                        <div>
                            <h1 class="card-title h2 mb-1">Ask the Scholar</h1>
                            <div class="text-muted">Document scope</div>
                        </div>
                    </div>
                    <div class="card-body">
                        <div class="alert alert-info">
                            I can answer from the source metadata for this document. Page-specific historical knowledge is available from each page scope.
                        </div>

                        <form method="post" action="{{ path('survos_folio_item_chat', {
                            provider: provider,
                            dataset: dataset,
                            coreCode: core.code,
                            dtoType: row.dtoType ?: 'row',
                            localId: row.localId,
                        }) }}">
                            <input type="hidden" name="conversation" value="{{ conversationId }}">
                            <div class="mb-3">
                                <label class="form-label" for="folio-document-question">Question</label>
                                <textarea class="form-control" id="folio-document-question" name="q" rows="4" required>{{ question }}</textarea>
                            </div>
                            <button class="btn btn-primary" type="submit">
                                {{ ux_icon('tabler:message-question', {class: 'icon'}) }} Ask document
                            </button>
                        </form>

                        {% if result %}
                            <div class="border-top mt-4 pt-4">
                                <h2 class="h4">Scholar response</h2>
                                <div class="prose">{{ result.answer|markdown_to_html }}</div>
                            </div>
                        {% endif %}
                    </div>
                </div>

                {% if description %}
                    <div class="card mb-3">
                        <div class="card-header"><h2 class="card-title mb-0">Source description</h2></div>
                        <div class="card-body" style="white-space: pre-wrap; word-break: break-word;">{{ description|trim }}</div>
                    </div>
                {% endif %}

                {% if pages is not empty %}
                    <div class="card">
                        <div class="card-header"><h2 class="card-title mb-0">Pages</h2></div>
                        <div class="list-group list-group-flush">
                            {% for page in pages %}
                                <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" href="{{ path('survos_folio_page_chat', {
                                    provider: provider,
                                    dataset: dataset,
                                    coreCode: core.code,
                                    dtoType: row.dtoType ?: 'row',
                                    localId: row.localId,
                                    seq: page.seq,
                                }) }}">
                                    <span>Page {{ page.seq }}</span>
                                    <span class="text-muted small">{{ page.text ? 'OCR' : 'source only' }}</span>
                                </a>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>

            <div class="col-lg-5">
                <div class="card">
                    <div class="card-header"><h2 class="card-title mb-0">Source data</h2></div>
                    <div class="card-body">
                        <dl class="row mb-0">
                            <dt class="col-sm-4">ID</dt><dd class="col-sm-8 font-monospace">{{ row.localId }}</dd>
                            <dt class="col-sm-4">Core</dt><dd class="col-sm-8">{{ core.code }}</dd>
                            <dt class="col-sm-4">Type</dt><dd class="col-sm-8">{{ row.dtoType ?: 'row' }}</dd>
                        </dl>
                    </div>
                    <details class="border-top p-3">
                        <summary class="text-muted small">DTO data</summary>
                        <pre class="small mt-2 mb-0" style="white-space: pre-wrap; word-break: break-word;">{{ row.dtoData|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                    </details>
                    {% if row.extras %}
                        <details class="border-top p-3">
                            <summary class="text-muted small">Extras</summary>
                            <pre class="small mt-2 mb-0" style="white-space: pre-wrap; word-break: break-word;">{{ row.extras|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                        </details>
                    {% endif %}
                </div>

                <div class="card mt-3">
                    <div class="card-header"><h2 class="card-title mb-0">Context sent to Scholar</h2></div>
                    {% if result %}
                        <div class="card-body">
                            <pre class="small mb-0" style="white-space: pre-wrap; word-break: break-word;">{{ result.contextPrompt }}</pre>
                        </div>
                    {% else %}
                        <div class="list-group list-group-flush">
                            {% for label, section in contextSections %}
                                <details class="list-group-item">
                                    <summary>{{ label }}</summary>
                                    <pre class="small mt-2 mb-0" style="white-space: pre-wrap; word-break: break-word;">{{ section is iterable ? section|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) : section }}</pre>
                                </details>
                            {% endfor %}
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>
{% endblock %}