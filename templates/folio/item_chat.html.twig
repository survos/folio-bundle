{% extends '@SurvosFolioBundle/folio/row/base.html.twig' %}

{% import _self as item_chat %}

{% macro render_metadata_value(value) %}
    {% import _self as item_chat %}

    {% if value is iterable %}
        {% if value is empty %}
            <span class="text-muted">none</span>
        {% else %}
            <div class="vstack gap-2">
                {% for key, child in value %}
                    <div class="rounded border bg-light-subtle p-2">
                        {% if key is not same as(loop.index0) %}
                            <div class="font-monospace text-muted small mb-1">{{ key }}</div>
                        {% endif %}
                        <div class="text-break">{{ item_chat.render_metadata_value(child) }}</div>
                    </div>
                {% endfor %}
            </div>
        {% endif %}
    {% elseif value is same as(true) %}
        <span class="badge text-bg-success">yes</span>
    {% elseif value is same as(false) %}
        <span class="badge text-bg-secondary">no</span>
    {% elseif value is url %}
        <a href="{{ value }}" target="_blank" rel="noopener" class="text-break">
            {{ value }}
            {{ ux_icon('tabler:external-link', {class: 'icon icon-sm ms-1'}) }}
        </a>
    {% else %}
        <span style="white-space: pre-wrap; word-break: break-word;">{{ value }}</span>
    {% endif %}
{% endmacro %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set title = attribute(row.dtoData, 'title')|default(attribute(row.extras, 'dcterms:title')|default(row.label ?: row.localId)) %}
{% if title starts with '"' and title ends with '"' %}
    {% set title = title|trim('"') %}
{% endif %}
{% set description = attribute(row.dtoData, 'description')|default(attribute(row.extras, 'dcterms:description')|default(null)) %}
{% set denseSummary = attribute(row.dtoData, 'denseSummary')|default(attribute(row.extras, 'ai:denseSummary')|default(null)) %}
{% set date = attribute(row.dtoData, 'date')|default(attribute(row.extras, 'dcterms:date')|default(null)) %}
{% set year = attribute(row.dtoData, 'year')|default(date) %}
{% set dimensions = attribute(row.dtoData, 'dimensions')|default(null) %}
{% set dimensionsRaw = attribute(row.dtoData, 'dimensionsRaw')|default(null) %}
{% set citationUrl = row.citationUrl ?: attribute(row.dtoData, 'citationUrl')|default(null) %}
{% set sourceUrl = attribute(row.dtoData, 'url')|default(null) %}
{% set credit = attribute(row.dtoData, 'citation')|default(null) %}
{% set firstPage = pages is not empty ? pages|first : null %}
{% set heroImage = row.thumbnailSource ?: attribute(row.dtoData, 'largeImageUrl')|default(attribute(row.dtoData, 'thumbnailUrl')|default(null)) %}
{% if not heroImage and firstPage %}
    {% set heroImage = firstPage.url|default(null) %}
{% endif %}
{% set dtoData = row.dtoData|default({}) %}
{% set extras = row.extras|default({}) %}
{% set featuredFields = ['title', 'description', 'denseSummary', 'date', 'year', 'dimensions', 'dimensionsRaw', 'citation', 'citationUrl', 'url'] %}
{% set metadataRows = dtoData|filter((value, field) => value is not empty and field not in featuredFields) %}
{% set extraRows = extras|filter(value => value is not empty) %}
{% set chatController = 'survos--folio-bundle--chat' %}

{% block title %}Ask the Scholar · {{ title }}{% endblock %}

{% block head %}
    {{ parent() }}
    <meta name="turbo-cache-control" content="no-cache">
{% endblock %}

{% block body_start %}data-turbo="false"{% endblock %}

{% block body %}
    <style>
        .folio-scholar-chat {
            min-height: 32rem;
        }

        .folio-scholar-thread {
            background: linear-gradient(180deg, rgba(32, 107, 196, .05), rgba(32, 107, 196, 0));
            max-height: 42rem;
            overflow: auto;
        }

        .folio-scholar-bubble {
            border-radius: 1rem;
            max-width: 46rem;
        }

        .folio-scholar-bubble-user {
            background: var(--tblr-primary, #206bc4);
            color: #fff;
            margin-left: auto;
        }

        .folio-scholar-bubble-assistant {
            background: var(--tblr-bg-surface, #fff);
            border: 1px solid rgba(98, 105, 118, .16);
        }

        .folio-scholar-bubble-assistant .prose > :first-child { margin-top: 0; }
        .folio-scholar-bubble-assistant .prose > :last-child { margin-bottom: 0; }
        .folio-scholar-bubble-assistant .prose p { line-height: 1.65; margin: 0 0 .85rem; }
        .folio-scholar-bubble-assistant .prose h1,
        .folio-scholar-bubble-assistant .prose h2,
        .folio-scholar-bubble-assistant .prose h3,
        .folio-scholar-bubble-assistant .prose h4 {
            font-weight: 700;
            letter-spacing: 0;
            margin: 1rem 0 .5rem;
        }
        .folio-scholar-bubble-assistant .prose h1 { font-size: 1.35rem; }
        .folio-scholar-bubble-assistant .prose h2 { font-size: 1.2rem; }
        .folio-scholar-bubble-assistant .prose h3 { font-size: 1.08rem; }
        .folio-scholar-bubble-assistant .prose h4 { font-size: 1rem; }
        .folio-scholar-bubble-assistant .prose ul,
        .folio-scholar-bubble-assistant .prose ol { margin: .25rem 0 .9rem 1.25rem; padding: 0; }
        .folio-scholar-bubble-assistant .prose li { line-height: 1.55; margin: .25rem 0; }
        .folio-scholar-bubble-assistant .prose blockquote {
            border-left: 3px solid rgba(32, 107, 196, .25);
            color: #475467;
            margin: .9rem 0;
            padding: .15rem 0 .15rem .9rem;
        }
        .folio-scholar-bubble-assistant .prose code {
            background: #f2f4f7;
            border-radius: .35rem;
            color: #111827;
            padding: .1rem .3rem;
        }
        .folio-scholar-bubble-assistant .prose img {
            background: #f6f8fb;
            border: 1px solid rgba(98, 105, 118, .18);
            border-radius: .75rem;
            display: block;
            margin: .85rem 0;
            max-height: 420px;
            max-width: 100%;
            object-fit: contain;
        }

        .folio-scholar-loading span {
            animation: folio-scholar-pulse 1.2s infinite ease-in-out;
            display: inline-block;
        }

        .folio-scholar-loading span:nth-child(2) {
            animation-delay: .15s;
        }

        .folio-scholar-loading span:nth-child(3) {
            animation-delay: .3s;
        }

        @keyframes folio-scholar-pulse {
            0%, 80%, 100% { opacity: .35; transform: translateY(0); }
            40% { opacity: 1; transform: translateY(-2px); }
        }

        .folio-document-image {
            aspect-ratio: 4 / 3;
            background: var(--tblr-bg-surface-secondary, #f6f8fb);
            object-fit: contain;
            width: 100%;
        }

        .folio-document-panel {
            position: sticky;
            top: 1rem;
        }
    </style>

    <div class="container-xl py-4 py-lg-5">
        <div class="mb-3">
            <a class="text-decoration-none text-secondary" data-turbo="false" href="{{ path('survos_folio_row_show', {
                folioCode: row.folioCode,
                coreCode: core.code,
                dtoType: row.dtoType ?: 'row',
                localId: row.localId,
            }) }}">
                {{ ux_icon('tabler:arrow-left', {class: 'icon'}) }} Back to {{ title }}
            </a>
        </div>

        <div class="row g-4 align-items-start">
            <div class="col-lg-7">
                <div class="card folio-scholar-chat mb-3" data-folio-chat-panel>
                    <div class="card-header d-flex align-items-center justify-content-between gap-3">
                        <div>
                            <h1 class="card-title h2 mb-1">Ask the Scholar</h1>
                            <div class="text-muted">Document scope · {{ pages|length }} page{{ pages|length == 1 ? '' : 's' }}</div>
                        </div>
                        <span class="badge bg-primary-lt">
                            {{ ux_icon('tabler:file-text-ai', {class: 'icon me-1'}) }}
                            {{ core.code }}
                        </span>
                    </div>

                    <div class="card-body folio-scholar-thread" data-folio-chat-thread>
                        <div class="vstack gap-3" data-folio-chat-messages>
                            <div class="folio-scholar-bubble folio-scholar-bubble-assistant p-3">
                                <div class="d-flex gap-2 align-items-center mb-2 text-primary">
                                    {{ ux_icon('tabler:sparkles', {class: 'icon'}) }}
                                    <strong>Scholar</strong>
                                </div>
                                <div class="text-muted">
                                    Ask about this object, its catalog metadata, its source description, or the page inventory.
                                    For page-specific OCR and visual context, open one of the page chats.
                                </div>
                            </div>

                            {% for turn in chatHistory|default([]) %}
                                <div class="folio-scholar-bubble folio-scholar-bubble-user p-3">
                                    <div class="small opacity-75 mb-1">You</div>
                                    <div style="white-space: pre-wrap; word-break: break-word;">{{ turn.question }}</div>
                                </div>

                                <div data-folio-chat-copy-root data-controller="{{ chatController }}">
                                    <div class="folio-scholar-bubble folio-scholar-bubble-assistant p-3">
                                        <div class="d-flex gap-2 align-items-center mb-2 text-primary">
                                            {{ ux_icon('tabler:message-chatbot', {class: 'icon'}) }}
                                            <strong>Scholar</strong>
                                        </div>
                                        <template data-folio-chat-copy-source data-{{ chatController }}-target="source">{{ turn.answer }}</template>
                                        <div class="prose" data-folio-chat-copy-content data-{{ chatController }}-target="content">{{ turn.answer|markdown_to_html }}</div>
                                        {% if app.debug and turn.error|default(null) %}
                                            <div class="alert alert-warning mt-3 mb-0">
                                                <div class="fw-semibold mb-1">Scholar diagnostic</div>
                                                <code class="text-break">{{ turn.error }}</code>
                                            </div>
                                        {% endif %}
                                    </div>
                                    <div class="mt-1">
                                        <button
                                            data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Copy Response"
                                            class="btn btn-action p-1 lh-1"
                                            type="button"
                                            aria-label="Copy Response"
                                            data-folio-chat-copy-button
                                            data-copied-content="{{ ux_icon('tabler:check', {class: 'icon'})|e('html_attr') }}"
                                            data-{{ chatController }}-target="button"
                                        >
                                            {{ ux_icon('tabler:copy', {class: 'icon'}) }}
                                        </button>
                                    </div>
                                </div>
                            {% endfor %}
                        </div>
                    </div>

                    <div class="card-footer bg-white">
                        <form method="post" data-turbo="false" data-folio-chat-form data-folio-chat-stream-action="{{ path('survos_folio_item_chat_stream', {
                            folioCode: row.folioCode,
                            coreCode: core.code,
                            dtoType: row.dtoType ?: 'row',
                            localId: row.localId,
                        }) }}" action="{{ path('survos_folio_item_chat', {
                            folioCode: row.folioCode,
                            coreCode: core.code,
                            dtoType: row.dtoType ?: 'row',
                            localId: row.localId,
                        }) }}">
                            <input type="hidden" name="conversation" value="{{ conversationId }}">
                            <label class="form-label" for="folio-document-question">Question</label>
                            <div class="input-group input-group-flat">
                                <textarea class="form-control" data-folio-chat-input id="folio-document-question" name="q" rows="3" required placeholder="Ask about this document..."></textarea>
                                <button class="btn btn-primary align-self-stretch" data-folio-chat-submit type="submit">
                                    {{ ux_icon('tabler:send', {class: 'icon'}) }}
                                    <span data-folio-chat-submit-label>Ask</span>
                                </button>
                            </div>
                        </form>
                    </div>
                </div>

                {% if description %}
                    <div class="card mb-3">
                        <div class="card-header"><h2 class="card-title mb-0">Source Description</h2></div>
                        <div class="card-body" style="white-space: pre-wrap; word-break: break-word;">{{ description|trim }}</div>
                    </div>
                {% endif %}

                <div class="card">
                    <div class="card-header"><h2 class="card-title mb-0">Scholar Source Context</h2></div>
                    <div class="list-group list-group-flush">
                        {% for label, section in contextSections %}
                            <details class="list-group-item">
                                <summary class="fw-semibold">{{ label }}</summary>
                                <div class="mt-3 small">{{ item_chat.render_metadata_value(section) }}</div>
                            </details>
                        {% endfor %}
                    </div>
                </div>
            </div>

            <div class="col-lg-5">
                <aside class="folio-document-panel vstack gap-3">
                    <div class="card overflow-hidden">
                        {% if heroImage %}
                            {% set displayImage = heroImage %}
                            {% guard filter imgproxy %}
                                {% set displayImage = heroImage|imgproxy('display') %}
                            {% endguard %}
                            <img src="{{ displayImage }}" class="folio-document-image border-bottom" alt="{{ title }}">
                        {% else %}
                            <div class="folio-document-image d-flex align-items-center justify-content-center border-bottom text-muted">
                                {{ ux_icon('tabler:photo-off', {class: 'icon me-2'}) }}
                                No image available
                            </div>
                        {% endif %}

                        <div class="card-body">
                            <div class="text-muted small mb-2">{{ provider }} / {{ dataset }} / {{ core.code }}</div>
                            <h2 class="h3 mb-3">{{ title }}</h2>

                            {% if denseSummary %}
                                <p class="text-muted">{{ denseSummary }}</p>
                            {% elseif description %}
                                <p class="text-muted">{{ description|striptags|u.truncate(260, '...') }}</p>
                            {% endif %}

                            <dl class="row mb-0">
                                <dt class="col-sm-4">ID</dt>
                                <dd class="col-sm-8 font-monospace text-break">{{ row.localId }}</dd>

                                <dt class="col-sm-4">Type</dt>
                                <dd class="col-sm-8">{{ row.dtoType ?: 'row' }}</dd>

                                {% if year %}
                                    <dt class="col-sm-4">Date</dt>
                                    <dd class="col-sm-8">{{ year }}</dd>
                                {% endif %}

                                {% if dimensions is iterable and dimensions is not empty %}
                                    <dt class="col-sm-4">Dimensions</dt>
                                    <dd class="col-sm-8">{{ item_chat.render_metadata_value(dimensions) }}</dd>
                                {% elseif dimensions or dimensionsRaw %}
                                    <dt class="col-sm-4">Dimensions</dt>
                                    <dd class="col-sm-8">{{ dimensions ?: dimensionsRaw }}</dd>
                                {% endif %}

                                {% if credit %}
                                    <dt class="col-sm-4">Credit</dt>
                                    <dd class="col-sm-8">{{ credit }}</dd>
                                {% endif %}
                            </dl>

                            <div class="btn-list mt-3">
                                {% if citationUrl %}
                                    <a href="{{ citationUrl }}" target="_blank" rel="noopener" class="btn btn-outline-primary btn-sm">
                                        {{ ux_icon('tabler:external-link', {class: 'icon me-1'}) }}
                                        Citation
                                    </a>
                                {% endif %}

                                {% if sourceUrl and sourceUrl != citationUrl %}
                                    <a href="{{ sourceUrl }}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                                        {{ ux_icon('tabler:world', {class: 'icon me-1'}) }}
                                        Source
                                    </a>
                                {% endif %}

                                {% if heroImage %}
                                    <a href="{{ heroImage }}" target="_blank" rel="noopener" class="btn btn-outline-secondary btn-sm">
                                        {{ ux_icon('tabler:photo', {class: 'icon me-1'}) }}
                                        Image
                                    </a>
                                {% endif %}
                            </div>
                        </div>
                    </div>

                    <div class="card">
                        <div class="card-header"><h2 class="card-title mb-0">Metadata</h2></div>
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <tbody>
                                    {% for field, value in metadataRows %}
                                        <tr>
                                            <th class="w-25 align-top font-monospace text-muted small">{{ field }}</th>
                                            <td class="small">{{ item_chat.render_metadata_value(value) }}</td>
                                        </tr>
                                    {% else %}
                                        <tr><td class="text-muted">No DTO metadata captured.</td></tr>
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {% if extraRows is not empty %}
                            <details class="border-top p-3">
                                <summary class="fw-semibold">Additional Source Fields</summary>
                                <div class="table-responsive mt-3">
                                    <table class="table table-sm mb-0">
                                        <tbody>
                                            {% for field, value in extraRows %}
                                                <tr>
                                                    <th class="w-25 align-top font-monospace text-muted small">{{ field }}</th>
                                                    <td class="small">{{ item_chat.render_metadata_value(value) }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                </div>
                            </details>
                        {% endif %}
                    </div>

                    {% if pages is not empty %}
                        <div class="card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h2 class="card-title mb-0">Pages</h2>
                                <span class="badge bg-secondary-lt">{{ pages|length }}</span>
                            </div>
                            <div class="list-group list-group-flush">
                                {% for page in pages %}
                                    <a class="list-group-item list-group-item-action d-flex justify-content-between align-items-center" data-turbo="false" href="{{ path('survos_folio_page_chat', {
                                        folioCode: row.folioCode,
                                        coreCode: core.code,
                                        dtoType: row.dtoType ?: 'row',
                                        localId: row.localId,
                                        seq: page.seq,
                                    }) }}">
                                        <span>
                                            {{ ux_icon('tabler:file', {class: 'icon me-1 text-muted'}) }}
                                            Page {{ page.seq }}
                                        </span>
                                        <span class="text-muted small">{{ page.text ? 'OCR' : 'source only' }}</span>
                                    </a>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}
                </aside>
            </div>
        </div>
    </div>

    <script>
        (function () {
            if (window.folioScopedChatCleanup) {
                window.folioScopedChatCleanup();
            }

            const listenerController = new AbortController();
            const activeStreams = new Set();
            let isLeavingPage = false;

            window.folioScopedChatCleanup = function () {
                isLeavingPage = true;
                listenerController.abort();
                activeStreams.forEach(function (controller) {
                    controller.abort();
                });
                activeStreams.clear();
                window.folioScopedChatCleanup = null;
            };

            document.addEventListener('turbo:before-cache', window.folioScopedChatCleanup, { once: true });
            window.addEventListener('pagehide', window.folioScopedChatCleanup, { once: true });

            function scrollThread(panel) {
                const thread = panel.querySelector('[data-folio-chat-thread]');
                if (thread) {
                    thread.scrollTop = thread.scrollHeight;
                }
            }

            function escapeHtml(value) {
                return value.replace(/[&<>"']/g, function (char) {
                    return ({
                        '&': '&amp;',
                        '<': '&lt;',
                        '>': '&gt;',
                        '"': '&quot;',
                        "'": '&#039;'
                    })[char];
                });
            }

            function chatCopySourceText(source) {
                if (!source) {
                    return '';
                }

                if (source instanceof HTMLTemplateElement) {
                    return source.content.textContent || '';
                }

                return source.textContent || '';
            }

            function chatCopyRenderedText(content) {
                return (content?.innerText || content?.textContent || '')
                    .replace(/[ \t]+\n/g, '\n')
                    .replace(/\n{3,}/g, '\n\n')
                    .trim();
            }

            async function writeChatCopyText(text) {
                if (navigator.clipboard?.writeText) {
                    try {
                        await navigator.clipboard.writeText(text);
                        return;
                    } catch {
                        // Fall back when clipboard permissions are denied.
                    }
                }

                const textarea = document.createElement('textarea');
                textarea.value = text;
                textarea.setAttribute('readonly', '');
                textarea.style.position = 'fixed';
                textarea.style.opacity = '0';
                document.body.appendChild(textarea);
                textarea.select();
                document.execCommand('copy');
                textarea.remove();
            }

            function showChatCopyFeedback(button) {
                const original = button.dataset.originalContent || button.innerHTML;

                button.dataset.originalContent = original;
                button.innerHTML = button.dataset.copiedContent || 'Copied';
                button.disabled = true;

                window.setTimeout(function () {
                    button.innerHTML = original;
                    button.disabled = false;
                }, 1200);
            }

            async function copyChatAnswer(button) {
                const root = button.closest('[data-folio-chat-copy-root]');
                const source = root?.querySelector('[data-folio-chat-copy-source]');
                const content = root?.querySelector('[data-folio-chat-copy-content]');
                const text = (chatCopySourceText(source).trim() || chatCopyRenderedText(content)).trim();

                if (!text) {
                    return;
                }

                await writeChatCopyText(text);
                showChatCopyFeedback(button);
            }

            function showChatActions(turn) {
                turn?.querySelector('[data-folio-chat-actions]')?.classList.remove('d-none');
            }

            function renderMarkdown(markdown) {
                const blocks = escapeHtml(markdown).split(/\n{2,}/).map(function (block) {
                    const trimmed = block.trim();
                    if (!trimmed) {
                        return '';
                    }

                    if (/^#{1,6}\s/.test(trimmed)) {
                        const level = Math.min(6, trimmed.match(/^#+/)[0].length);
                        return '<h' + level + '>' + inlineMarkdown(trimmed.replace(/^#{1,6}\s+/, '')) + '</h' + level + '>';
                    }

                    if (/^[-*]\s/m.test(trimmed)) {
                        const items = trimmed.split(/\n/).map(function (line) {
                            return line.replace(/^[-*]\s+/, '');
                        }).filter(Boolean).map(function (line) {
                            return '<li>' + inlineMarkdown(line) + '</li>';
                        }).join('');

                        return '<ul>' + items + '</ul>';
                    }

                    if (/^\d+\.\s/m.test(trimmed)) {
                        const items = trimmed.split(/\n/).map(function (line) {
                            return line.replace(/^\d+\.\s+/, '');
                        }).filter(Boolean).map(function (line) {
                            return '<li>' + inlineMarkdown(line) + '</li>';
                        }).join('');

                        return '<ol>' + items + '</ol>';
                    }

                    if (/^&gt;\s/m.test(trimmed)) {
                        return '<blockquote>' + inlineMarkdown(trimmed.replace(/^&gt;\s?/gm, '')).replace(/\n/g, '<br>') + '</blockquote>';
                    }

                    return '<p>' + inlineMarkdown(trimmed).replace(/\n/g, '<br>') + '</p>';
                }).join('');

                return blocks || '';
            }

            function inlineMarkdown(value) {
                return value
                    .replace(/!\[([^\]]*)\]\((https?:\/\/[^)\s]+)\)/g, '<img src="$2" alt="$1" loading="lazy">')
                    .replace(/`([^`]+)`/g, '<code>$1</code>')
                    .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                    .replace(/\*([^*]+)\*/g, '<em>$1</em>')
                    .replace(/\[([^\]]+)\]\((https?:\/\/[^)\s]+)\)/g, '<a href="$2" target="_blank" rel="noopener">$1</a>');
            }

            function appendPendingTurn(panel, question) {
                const messages = panel.querySelector('[data-folio-chat-messages]');
                if (!messages) {
                    return;
                }

                messages.insertAdjacentHTML('beforeend', `
                    <div class="folio-scholar-bubble folio-scholar-bubble-user p-3">
                        <div class="small opacity-75 mb-1">You</div>
                        <div style="white-space: pre-wrap; word-break: break-word;">${escapeHtml(question)}</div>
                    </div>
                    <div data-folio-chat-copy-root data-controller="{{ chatController }}" data-folio-chat-pending>
                        <div class="folio-scholar-bubble folio-scholar-bubble-assistant p-3">
                            <div class="d-flex gap-2 align-items-center mb-2 text-primary">
                                <strong>Scholar</strong>
                            </div>
                            <template data-folio-chat-copy-source data-{{ chatController }}-target="source"></template>
                            <div class="folio-scholar-loading text-muted" data-folio-chat-loading>
                                Thinking<span>.</span><span>.</span><span>.</span>
                            </div>
                            <div class="prose" data-folio-chat-copy-content data-folio-chat-pending-answer data-{{ chatController }}-target="content"></div>
                        </div>
                        <div class="mt-1 d-none" data-folio-chat-actions>
                            <button
                                data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Copy Response"
                                class="btn btn-action p-1 lh-1"
                                type="button"
                                aria-label="Copy Response"
                                data-folio-chat-copy-button
                                data-copied-content="{{ ux_icon('tabler:check', {class: 'icon'})|e('html_attr') }}"
                                data-{{ chatController }}-target="button"
                            >
                                {{ ux_icon('tabler:copy', {class: 'icon'}) }}
                            </button>
                        </div>
                    </div>
                `);
                scrollThread(panel);

                return messages.lastElementChild;
            }

            async function readSse(response, handlers) {
                if (!response.body) {
                    throw new Error('Streaming is not available in this browser.');
                }

                const reader = response.body.getReader();
                const decoder = new TextDecoder();
                let buffer = '';

                while (true) {
                    const chunk = await reader.read();
                    if (chunk.done) {
                        break;
                    }

                    buffer += decoder.decode(chunk.value, { stream: true });
                    const parts = buffer.split(/\n\n/);
                    buffer = parts.pop() || '';

                    for (const part of parts) {
                        const lines = part.split(/\n/);
                        let event = 'message';
                        const data = [];

                        for (const line of lines) {
                            if (line.startsWith('event:')) {
                                event = line.slice(6).trim();
                            } else if (line.startsWith('data:')) {
                                data.push(line.slice(5).trimStart());
                            }
                        }

                        const payload = data.length ? JSON.parse(data.join('\n')) : {};
                        handlers[event]?.(payload);
                    }
                }
            }

            document.addEventListener('submit', async function (event) {
                const form = event.target.closest('[data-folio-chat-form]');
                if (!form) {
                    return;
                }

                event.preventDefault();

                const panel = form.closest('[data-folio-chat-panel]');
                const input = form.querySelector('[data-folio-chat-input]');
                const submit = form.querySelector('[data-folio-chat-submit]');
                const submitLabel = form.querySelector('[data-folio-chat-submit-label]');
                const question = input ? input.value.trim() : '';

                if (!panel || !input || question === '') {
                    input?.focus();
                    return;
                }

                const formData = new FormData(form);

                const pending = appendPendingTurn(panel, question);
                input.value = '';
                input.style.height = '';

                if (submit) {
                    submit.disabled = true;
                    submit.classList.add('btn-loading');
                }
                if (submitLabel) {
                    submitLabel.textContent = 'Thinking...';
                }

                const streamController = new AbortController();
                activeStreams.add(streamController);

                try {
                    const response = await fetch(form.dataset.folioChatStreamAction || form.action, {
                        method: form.method || 'POST',
                        body: formData,
                        signal: streamController.signal,
                        headers: {
                            'Accept': 'text/event-stream',
                            'X-Requested-With': 'XMLHttpRequest'
                        }
                    });

                    if (!response.ok) {
                        throw new Error('Chat request failed with HTTP ' + response.status);
                    }

                    const pendingAnswer = pending?.querySelector('[data-folio-chat-pending-answer]');
                    const pendingCopySource = pending?.querySelector('[data-folio-chat-copy-source]');
                    const loading = pending?.querySelector('[data-folio-chat-loading]');
                    let streamedMarkdown = '';

                    await readSse(response, {
                        delta(payload) {
                            if (loading) {
                                loading.remove();
                            }
                            if (pendingAnswer) {
                                streamedMarkdown += payload.text || '';
                                if (pendingCopySource) {
                                    if (pendingCopySource instanceof HTMLTemplateElement) {
                                        pendingCopySource.content.textContent = streamedMarkdown;
                                    } else {
                                        pendingCopySource.textContent = streamedMarkdown;
                                    }
                                }
                                pendingAnswer.innerHTML = renderMarkdown(streamedMarkdown);
                                scrollThread(panel);
                            }
                        },
                        html(payload) {
                            if (pendingAnswer && payload.html) {
                                pendingAnswer.innerHTML = payload.html;
                                scrollThread(panel);
                            }
                        },
                        done(payload) {
                            if (loading) {
                                loading.remove();
                            }
                            if (pendingAnswer && payload.answerHtml) {
                                pendingAnswer.innerHTML = payload.answerHtml;
                                scrollThread(panel);
                            }
                            if (payload.error && pending) {
                                pending.insertAdjacentHTML('beforeend', '<div class="alert alert-warning mt-3 mb-0"><code class="text-break">' + escapeHtml(payload.error) + '</code></div>');
                            }
                            showChatActions(pending);
                            pending?.removeAttribute('data-folio-chat-pending');
                        }
                    });

                    loading?.remove();
                    showChatActions(pending);
                    pending?.removeAttribute('data-folio-chat-pending');

                    if (submit) {
                        submit.disabled = false;
                        submit.classList.remove('btn-loading');
                    }
                    if (submitLabel) {
                        submitLabel.textContent = 'Ask';
                    }
                    input.focus();
                } catch (error) {
                    if (isLeavingPage || streamController.signal.aborted) {
                        return;
                    }

                    if (pending) {
                        pending.innerHTML = `
                            <div class="d-flex gap-2 align-items-center mb-2 text-danger">
                                <strong>Scholar</strong>
                            </div>
                            <div class="alert alert-warning mb-0">${escapeHtml(error.message)}</div>
                        `;
                        pending.removeAttribute('data-folio-chat-pending');
                    }
                    if (submit) {
                        submit.disabled = false;
                        submit.classList.remove('btn-loading');
                    }
                    if (submitLabel) {
                        submitLabel.textContent = 'Ask';
                    }
                    input.focus();
                } finally {
                activeStreams.delete(streamController);
                }
            }, { signal: listenerController.signal });

            document.addEventListener('click', function (event) {
                const button = event.target.closest('[data-folio-chat-copy-button]');

                if (!button) {
                    return;
                }

                event.preventDefault();
                copyChatAnswer(button);
            }, { signal: listenerController.signal });

            document.querySelectorAll('[data-folio-chat-panel]').forEach(scrollThread);

            document.addEventListener('keydown', function (event) {
                const input = event.target.closest('[data-folio-chat-input]');
                if (!input || event.key !== 'Enter' || event.shiftKey || event.ctrlKey || event.metaKey || event.altKey) {
                    return;
                }

                event.preventDefault();
                input.closest('[data-folio-chat-form]')?.requestSubmit();
            }, { signal: listenerController.signal });
        })();
    </script>
{% endblock %}
