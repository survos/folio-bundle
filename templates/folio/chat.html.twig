{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set folioLabel = app.request.attributes.get('current_folio_title', ctx.folioCode) %}

{% block body_class %}folio-layout{% endblock %}

{#
{% block page_pretitle %}Folio Chat{% endblock %}

{% block page_title %}
    {{ folioLabel }}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    Ask questions against the folio FTS5 index
{% endblock %}
#}

{% block title %}Chat: {{ ctx.folioCode }}{% endblock %}

{% block body %}
    <div class="mb-3">
        <h1 class="h2 mb-1">{{ folioLabel }}</h1>
        <div class="text-muted">
            Ask anything about this collection — your guide answers from the items it holds, with pictures and links to the originals.
        </div>
    </div>

    <div class="row row-cards">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    <form method="post" class="vstack gap-3" data-turbo="false">
                        <div>
                            <label class="form-label" for="folio-chat-q">Ask a question</label>
                            <textarea
                                id="folio-chat-q"
                                name="q"
                                class="form-control"
                                rows="3"
                                autofocus
                                placeholder="e.g. What schools are documented here? · Tell me about the oldest items · Are there any maps?"
                            >{{ question }}</textarea>
                        </div>

                        {% if promptSuggestions %}
                            <div>
                                <div class="form-label text-muted mb-1">Not sure where to start? Try one of these:</div>
                                <div class="d-flex flex-wrap gap-2">
                                    {% for prompt in promptSuggestions %}
                                        <button
                                            class="btn btn-sm btn-outline-primary text-start"
                                            type="submit"
                                            name="q"
                                            value="{{ prompt }}"
                                        >
                                            {{ prompt }}
                                        </button>
                                    {% endfor %}
                                </div>
                            </div>
                        {% endif %}

                        <div class="row g-2">
                            <div class="col-md-4">
                                <label class="form-label" for="folio-chat-core">Core</label>
                                <select id="folio-chat-core" name="core" class="form-select">
                                    <option value="">All cores</option>
                                    {% for core in cores %}
                                        <option value="{{ core.code }}" {{ selectedCore == core.code ? 'selected' }}>
                                            {{ core.code }} · {{ core.rowCount|number_format }}
                                        </option>
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-md-5">
                                <label class="form-label" for="folio-chat-dto">DTO Type</label>
                                <select id="folio-chat-dto" name="dtoType" class="form-select">
                                    <option value="">All DTO types</option>
                                    {% for coreCode, choices in dtoChoices %}
                                        {% for dto in choices %}
                                            <option value="{{ dto.type }}" {{ selectedDtoType == dto.type ? 'selected' }}>
                                                {{ coreCode }} / {{ dto.label }} · {{ dto.count|number_format }}
                                            </option>
                                        {% endfor %}
                                    {% endfor %}
                                </select>
                            </div>

                            <div class="col-md-3 d-flex align-items-end">
                                <button class="btn btn-primary w-100" type="submit">Ask</button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            {% if error %}
                <div class="alert alert-warning">
                    {{ error }}
                </div>
            {% endif %}

            {% if result %}
                <div class="card mb-3">
                    <div class="card-header">
                        <h2 class="card-title mb-0">Answer</h2>
                    </div>

                    <div class="card-body">
                        {# The model answers in Markdown (bold, lists, [n] citations) — render it.
                           Source [n] badges on the cards below map each citation to its row. #}
                        <div class="markdown mb-0">{{ result.answer|markdown_to_html }}</div>
                    </div>
                </div>

                {# Each cited item: the AI's narration paired with the row's photo (the natural
                   response); the database record sits below as a supporting footnote + a link to
                   open the full document. #}
                <div class="vstack gap-3">
                    {% for card in result.cards %}
                        {% set hit = card.hit %}
                        {% set th = hit.thumbnailSource %}
                        {% set detailPath = path('survos_folio_row_show', hit.routeParams) %}

                        <div class="card" id="source-{{ loop.index }}">
                            <div class="row g-0">
                                {% if th %}
                                    <div class="col-sm-4 col-lg-3">
                                        {% set imageUrl = hit.thumbnailUrl %}
                                        {% guard filter imgproxy %}
                                            {% set imageUrl = th|imgproxy('thumb') %}
                                        {% endguard %}

                                        <a href="{{ detailPath }}" class="d-block ratio ratio-4x3 bg-light h-100">
                                            <img
                                                src="{{ imageUrl }}"
                                                alt="{{ hit.label }}"
                                                loading="lazy"
                                                class="w-100 h-100 object-fit-cover rounded-start"
                                            >
                                        </a>
                                    </div>
                                {% endif %}

                                <div class="col">
                                    <div class="card-body">
                                        {# AI narration (or the row's own summary when there's no caption). #}
                                        <p class="mb-2">
                                            <span class="badge bg-primary align-text-bottom me-1">{{ loop.index }}</span>
                                            {{ card.caption ?? hit.denseSummary ?? hit.description }}
                                        </p>

                                        {# Footnote: the supporting database record + open the full document. #}
                                        <div class="text-muted small d-flex flex-wrap gap-2 align-items-center">
                                            <a href="{{ detailPath }}" class="fw-semibold link-secondary">
                                                {{ hit.label ?: hit.localId }}
                                            </a>
                                            <span class="font-monospace">{{ hit.localId }}</span>
                                            <span>·</span>
                                            <a href="{{ detailPath }}">Open full doc</a>
                                            {% if hit.citationUrl %}
                                                <span>·</span>
                                                <a href="{{ hit.citationUrl }}" target="_blank" rel="noopener">Original</a>
                                            {% endif %}
                                        </div>
                                    </div>
                                </div>
                            </div>
                        </div>
                    {% else %}
                        <div class="card">
                            <div class="card-body text-muted">
                                No closely matching items — see the answer above.
                            </div>
                        </div>
                    {% endfor %}
                </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title mb-0">Word Cloud</h2>
                </div>

                <div class="card-body">
                    {% if wordCloud %}
                        {% set topTerm = wordCloud|first %}
                        {% set topValue = topTerm.value ?: 1 %}

                        <div class="d-flex flex-wrap gap-2">
                            {% for term in wordCloud %}
                                {% set scale = min(1.55, max(0.85, 0.85 + (term.value / topValue))) %}

                                <form method="post" data-turbo="false">
                                    <input type="hidden" name="q" value="Tell me about {{ term.text }} in this collection.">

                                    <button
                                        class="btn btn-sm btn-outline-secondary"
                                        style="font-size: {{ scale }}rem"
                                        type="submit"
                                        title="Tell me about {{ term.text }}"
                                    >
                                        {{ term.text }}
                                    </button>
                                </form>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-muted">
                            Word-cloud terms will appear after the folio FTS vocabulary is rebuilt.
                        </div>
                    {% endif %}
                </div>
            </div>

            <div class="card mt-3">
                <div class="card-header">
                    <h2 class="card-title mb-0">Context</h2>
                </div>

                <div class="card-body">
                    {% if result and result.contextPrompt %}
                        <pre class="small mb-0" style="white-space: pre-wrap">{{ result.contextPrompt }}</pre>
                    {% else %}
                        <div class="text-muted">
                            Sources and the generated context prompt will appear after a question.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>
    </div>

    <style>
        .page-header {
            display: none !important;
        }
    </style>
{% endblock %}
