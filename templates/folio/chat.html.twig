{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set folioLabel = app.request.attributes.get('current_folio_title', ctx.folioCode) %}
{% set chatController = 'survos--folio-bundle--chat' %}

{% block body_class %}folio-layout folio-chat-page{% endblock %}
{% block title %}Chat: {{ ctx.folioCode }}{% endblock %}

{% block body %}
    <div class="mb-3">
        <h1 class="h2 mb-1">{{ folioLabel }}</h1>
        <div class="text-muted">
            Ask anything about this collection — your guide answers from the items it holds, with pictures and links to the originals.
        </div>
    </div>

    <div class="row row-cards">
        <div class="col-lg-8">
            <div class="card mb-3">
                <div class="card-body">
                    <form method="post" class="vstack gap-3" data-turbo="false" id="folio-chat-form">
                        <input type="hidden" name="core" value="{{ selectedCore }}">
                        <input type="hidden" name="dtoType" value="{{ selectedDtoType }}">
                        <input type="hidden" name="conversation" value="{{ conversationId }}">

                        <div>
                            <details class="folio-sample-questions" {{ promptSuggestions ? '' : 'hidden' }}>
                                <summary class="folio-sample-summary d-flex justify-content-between align-items-center mb-2">
                                    <span class="form-label fw-semibold mb-0">
                                        {{ ux_icon('tabler:message-question', { class: 'icon me-1 text-primary' }) }}
                                        Ask a question
                                    </span>
                                    <span class="text-muted small d-inline-flex align-items-center">
                                        Sample questions
                                        {{ ux_icon('tabler:chevron-down', { class: 'icon ms-1 folio-sample-chevron' }) }}
                                    </span>
                                </summary>

                                <div class="d-flex flex-wrap gap-2 mb-2">
                                    {% for prompt in promptSuggestions|slice(0, 8) %}
                                        <button
                                            type="button"
                                            class="btn btn-sm btn-outline-primary text-start"
                                            data-q="{{ prompt }}"
                                            onclick="const f = this.closest('form'); f.querySelector('#folio-chat-q').value = this.dataset.q; f.requestSubmit();"
                                        >
                                            {{ ux_icon('tabler:bolt', { class: 'icon me-1' }) }}
                                            {{ prompt }}
                                        </button>
                                    {% endfor %}
                                </div>
                            </details>

                            <textarea
                                id="folio-chat-q"
                                name="q"
                                class="form-control"
                                rows="3"
                                autofocus
                                aria-label="Ask a question"
                                placeholder="e.g. What schools are documented here? · Tell me about the oldest items · Are there any maps?"
                            >{{ question }}</textarea>
                        </div>

                        <div class="row g-2">
                            <div class="d-flex justify-content-between align-items-center gap-2">
                                {% set activeFilterCount =
                                    (selectedCore ? 1 : 0)
                                    + (selectedDtoType ? 1 : 0)
                                %}

                                <button
                                    type="button"
                                    class="btn"
                                    data-bs-toggle="modal"
                                    data-bs-target="#folio-advanced-search-modal"
                                >
                                    {{ ux_icon('tabler:adjustments-horizontal', { class: 'icon me-1' }) }}
                                    Advanced search

                                    {% if activeFilterCount %}
                                        <span class="badge bg-primary-lt ms-1">
                                            {{ activeFilterCount }}
                                        </span>
                                    {% endif %}
                                </button>

                                <button
                                    class="btn btn-primary"
                                    type="submit"
                                    id="folio-chat-submit"
                                    style="min-width: 128px;"
                                >
                                    {{ ux_icon('tabler:send', { class: 'icon me-1' }) }}
                                    <span class="folio-submit-text">Ask</span>
                                </button>
                            </div>
                        </div>
                    </form>
                </div>
            </div>

            <div class="card mb-3 d-none" id="folio-chat-processing">
                <div class="card-body">
                    <div class="d-flex align-items-start gap-3">
                        <span class="avatar avatar-sm avatar-rounded bg-primary-lt text-primary flex-shrink-0">
                            {{ ux_icon('tabler:building-bank', { class: 'icon' }) }}
                        </span>

                        <div class="flex-fill">
                            <div class="fw-semibold mb-1">
                                Finding the best answer for you
                            </div>

                            <div class="text-muted small mb-3">
                                <span id="folio-processing-text">
                                    Thinking...
                                </span>
                            </div>

                            <div class="folio-thinking-lines">
                                <span></span>
                                <span></span>
                                <span></span>
                            </div>
                        </div>
                    </div>
                </div>
            </div>

            {% if error %}
                <div class="alert alert-warning d-flex align-items-center gap-2">
                    {{ ux_icon('tabler:alert-triangle', { class: 'icon' }) }}
                    <div>{{ error }}</div>
                </div>
            {% endif %}

            {% if result %}
                <div class="card mb-3" data-controller="{{ chatController }}">
                    <div class="card-header">
                        <div>
                            <h2 class="card-title mb-0">
                                {{ ux_icon('tabler:sparkles', { class: 'icon me-1 text-primary' }) }}
                                Answer
                            </h2>
                        </div>
                    </div>

                    <div class="card-body">
                        <div data-folio-chat-copy-root>
                            <template data-folio-chat-copy-source data-{{ chatController }}-target="source">{{ result.answer }}</template>
                            <div class="markdown folio-answer fs-5" data-folio-chat-copy-content data-{{ chatController }}-target="content">
                                {{ result.answer|markdown_to_html }}
                            </div>
                            <div class="mt-2">
                                <button
                                    data-bs-toggle="tooltip" data-bs-placement="bottom" data-bs-title="Copy Response"
                                    class="btn btn-action p-1 lh-1"
                                    type="button"
                                    aria-label="Copy Response"
                                    data-folio-chat-copy-button
                                    data-copied-content="{{ ux_icon('tabler:check', { class: 'icon' })|e('html_attr') }}"
                                    data-{{ chatController }}-target="button"
                                >
                                    {{ ux_icon('tabler:copy', { class: 'icon' }) }}
                                </button>
                            </div>
                        </div>

                        <div class="d-flex flex-wrap gap-2 mt-4 pt-3 border-top">
                            <button class="btn btn-outline-success btn-sm" type="button">
                                {{ ux_icon('tabler:thumb-up', { class: 'icon me-1' }) }}
                                Helpful
                            </button>

                            <button class="btn btn-outline-secondary btn-sm" type="button">
                                {{ ux_icon('tabler:thumb-down', { class: 'icon me-1' }) }}
                                Not helpful
                            </button>

                            <button class="btn btn-outline-secondary btn-sm" type="button">
                                {{ ux_icon('tabler:bookmark', { class: 'icon me-1' }) }}
                                Save question
                            </button>

                            <button class="btn btn-outline-secondary btn-sm" type="button">
                                {{ ux_icon('tabler:folder-plus', { class: 'icon me-1' }) }}
                                Add to collection
                            </button>

                            <button class="btn btn-outline-secondary btn-sm" type="button">
                                {{ ux_icon('tabler:share-3', { class: 'icon me-1' }) }}
                                Share
                            </button>
                        </div>

                        <div class="small text-muted mt-2">Not yet implemented</div>
                    </div>
                </div>

                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title mb-0">
                            {{ ux_icon('tabler:list-details', { class: 'icon me-1 text-primary' }) }}
                            Sources
                        </h2>

                        <div class="card-actions">
                            <span class="badge bg-primary-lt">{{ result.cards|length }}</span>
                        </div>
                    </div>

                    <div class="list-group list-group-flush">
                        {% for card in result.cards %}
                            {% set hit = card.hit %}
                            {% set th = hit.thumbnailSource %}
                            {% set detailPath = path('survos_folio_row_show', hit.routeParams) %}
                            {% set offcanvasId = 'folio-source-offcanvas-' ~ loop.index %}

                            {% set imageUrl = hit.thumbnailUrl %}
                            {% if th %}
                                {% guard filter imgproxy %}
                                    {% set imageUrl = th|imgproxy('thumb') %}
                                {% endguard %}
                            {% endif %}

                            {% set detailBody %}
                                {% if th %}
                                    <div class="ratio ratio-4x3 bg-light rounded mb-3 overflow-hidden">
                                        <img src="{{ imageUrl }}" alt="{{ hit.label }}" loading="lazy" class="w-100 h-100 object-fit-cover">
                                    </div>
                                {% endif %}

                                <div class="mb-3">
                                    <div class="text-muted small text-uppercase fw-semibold mb-1">Summary</div>
                                    <div>{{ card.caption ?? hit.denseSummary ?? hit.description }}</div>
                                </div>

                                <div class="list-group list-group-flush mb-3">
                                    <div class="list-group-item px-0 d-flex justify-content-between gap-3">
                                        <span class="text-muted">Source</span>
                                        <span class="text-end">#{{ loop.index }}</span>
                                    </div>
                                    <div class="list-group-item px-0 d-flex justify-content-between gap-3">
                                        <span class="text-muted">Local ID</span>
                                        <span class="font-monospace text-end">{{ hit.localId }}</span>
                                    </div>
                                    {% if hit.label %}
                                        <div class="list-group-item px-0 d-flex justify-content-between gap-3">
                                            <span class="text-muted">Title</span>
                                            <span class="text-end">{{ hit.label }}</span>
                                        </div>
                                    {% endif %}
                                </div>

                                <div class="d-grid gap-2">
                                    <a href="{{ detailPath }}" class="btn btn-primary" onclick="const oc = this.closest('.offcanvas'); if (oc) { const i = bootstrap.Offcanvas.getInstance(oc); if (i) { i.hide(); } }">
                                        {{ ux_icon('tabler:file-text', { class: 'icon me-1' }) }}
                                        Open full doc
                                    </a>
                                    {% if hit.citationUrl %}
                                        <a href="{{ hit.citationUrl }}" target="_blank" rel="noopener" class="btn btn-outline-secondary">
                                            {{ ux_icon('tabler:external-link', { class: 'icon me-1' }) }}
                                            Original source
                                        </a>
                                    {% endif %}
                                </div>
                            {% endset %}

                            <div
                                class="list-group-item folio-source-row"
                                role="button"
                                tabindex="0"
                                data-folio-detail-idx="{{ loop.index }}"
                                data-folio-offcanvas-target="#{{ offcanvasId }}"
                            >
                                <span class="folio-source-index">{{ loop.index }}</span>

                                {% if th %}
                                    <img src="{{ imageUrl }}" alt="{{ hit.label }}" loading="lazy" class="folio-source-thumb">
                                {% else %}
                                    <span class="folio-source-thumb folio-source-thumb-empty">
                                        {{ ux_icon('tabler:file-text', { class: 'icon' }) }}
                                    </span>
                                {% endif %}

                                <span class="min-w-0">
                                    <span class="badge badge-pill fs-6 mb-1 text-uppercase bg-primary-lt">
                                        {{ hit.coreCode }} / {{ hit.dtoType }}
                                    </span>
                                    <span class="fw-semibold text-truncate d-block">{{ hit.label ?: hit.localId }}</span>
                                    <span class="text-muted small font-monospace">{{ hit.localId }}{% if hit.dtoData.itemCount is defined and hit.dtoData.itemCount %} · {{ hit.dtoData.itemCount|number_format }} items{% endif %}</span>
                                </span>

                                <span class="folio-source-actions">
                                    <span class="folio-source-chevron">
                                        {{ ux_icon('tabler:chevron-right', { class: 'icon text-secondary' }) }}
                                    </span>
                                </span>
                            </div>

                            <template class="folio-detail-tpl" data-idx="{{ loop.index }}">{{ detailBody }}</template>

                            <div class="offcanvas offcanvas-end folio-source-offcanvas" tabindex="-1" id="{{ offcanvasId }}" aria-labelledby="{{ offcanvasId }}-label">
                                <div class="offcanvas-header">
                                    <div class="min-w-0">
                                        <h2 class="offcanvas-title h3 mb-1 text-truncate" id="{{ offcanvasId }}-label">{{ hit.label ?: hit.localId }}</h2>
                                        <div class="text-muted small font-monospace">{{ hit.localId }}</div>
                                    </div>
                                    <button type="button" class="btn-close" data-bs-dismiss="offcanvas" aria-label="Close"></button>
                                </div>
                                <div class="offcanvas-body">{{ detailBody }}</div>
                            </div>
                        {% else %}
                            <div class="list-group-item text-muted">
                                No closely matching items — see the answer above.
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% else %}
                <div class="card">
                    <div class="card-body text-center py-5">
                        <div class="mb-3 text-primary">
                            {{ ux_icon('tabler:message-circle-question', { class: 'icon icon-lg' }) }}
                        </div>

                        <h2 class="h3">Ask a question to begin</h2>

                        <p class="text-muted mb-0">
                            The answer, matching collection items, and source details will appear here.
                        </p>
                    </div>
                </div>
            {% endif %}
        </div>

        <div class="col-lg-4">
            <div class="card folio-detail-sidebar-card">
                <div class="card-header">
                    <h2 class="card-title mb-0">
                        {{ ux_icon('tabler:layout-sidebar-right', { class: 'icon me-1 text-primary' }) }}
                        Details
                    </h2>
                </div>

                <div class="card-body" id="folio-detail-sidebar">
                    <div class="text-muted">
                        Source details will appear here when you select an item from the answer.
                    </div>
                </div>
            </div>
        </div>
    </div>

    <div class="row row-cards mt-3">
        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title mb-0">
                        {{ ux_icon('tabler:tag', { class: 'icon me-1 text-primary' }) }}
                        Word Cloud
                        <span class="badge bg-secondary-lt ms-2">debug</span>
                    </h2>
                </div>

                <div class="card-body">
                    {% if wordCloud %}
                        <div class="d-flex flex-wrap gap-2">
                            {% for term in wordCloud|slice(0, 24) %}
                                <form method="post" data-turbo="false">
                                    <input type="hidden" name="q" value="Tell me about {{ term.text }} in this collection.">

                                    <button class="btn btn-sm rounded-pill shadow-none" type="submit">
                                        {{ term.text }}
                                    </button>
                                </form>
                            {% endfor %}
                        </div>
                    {% else %}
                        <div class="text-muted">
                            Word-cloud terms will appear after the folio FTS vocabulary is rebuilt.
                        </div>
                    {% endif %}
                </div>
            </div>

        </div>

        <div class="col-lg-6">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title mb-0">
                        {{ ux_icon('tabler:bug', { class: 'icon me-1 text-primary' }) }}
                        Debug Context
                    </h2>
                </div>

                <div class="card-body">
                    {% if result and result.contextPrompt %}
                        <details>
                            <summary class="text-muted small">
                                Show generated context prompt
                            </summary>

                            <pre class="small mt-3 mb-0 p-3 rounded bg-dark text-white" style="white-space: pre-wrap">{{ result.contextPrompt }}</pre>
                        </details>
                    {% else %}
                        <div class="text-muted">
                            Sources and the generated context prompt will appear after a question.
                        </div>
                    {% endif %}
                </div>
            </div>
        </div>

        <div class="modal modal-blur fade" id="folio-advanced-search-modal" tabindex="-1" aria-hidden="true">
            <div class="modal-dialog modal-dialog-centered">
                <form method="post" class="modal-content" data-turbo="false">
                    <input type="hidden" name="q" value="{{ question }}">

                    <div class="modal-header">
                        <h2 class="modal-title">
                            {{ ux_icon('tabler:adjustments-horizontal', { class: 'icon me-1 text-primary' }) }}
                            Advanced search
                        </h2>

                        <button type="button" class="btn-close" data-bs-dismiss="modal" aria-label="Close"></button>
                    </div>

                    <div class="modal-body">
                        <p class="text-muted small">
                            Refine the answer by limiting the search to a specific core or DTO type.
                        </p>

                        <div class="mb-3">
                            <label class="form-label" for="folio-chat-core">Core</label>
                            <select id="folio-chat-core" name="core" class="form-select">
                                <option value="">All cores</option>
                                {% for core in cores %}
                                    <option value="{{ core.code }}" {{ selectedCore == core.code ? 'selected' }}>
                                        {{ core.code }} · {{ core.rowCount|number_format }}
                                    </option>
                                {% endfor %}
                            </select>
                        </div>

                        <div>
                            <label class="form-label" for="folio-chat-dto">DTO Type</label>
                            <select id="folio-chat-dto" name="dtoType" class="form-select">
                                <option value="">All DTO types</option>
                                {% for coreCode, choices in dtoChoices %}
                                    {% for dto in choices %}
                                        <option value="{{ dto.type }}" {{ selectedDtoType == dto.type ? 'selected' }}>
                                            {{ coreCode }} / {{ dto.label }} · {{ dto.count|number_format }}
                                        </option>
                                    {% endfor %}
                                {% endfor %}
                            </select>
                        </div>
                    </div>

                    <div class="modal-footer">
                        <a
                            href="{{ app.request.pathinfo }}"
                            class="btn btn-outline-secondary"
                        >
                            Reset
                        </a>

                        <button type="button" class="btn btn-link" data-bs-dismiss="modal">
                            Cancel
                        </button>

                        <button class="btn btn-primary" type="submit">
                            Apply filters
                        </button>
                    </div>
                </form>
            </div>
        </div>
    </div>

    <style>
        .page-header {
            display: none !important;
        }

        .folio-chat-page {
            background: var(--tblr-bg-surface-secondary);
        }

        .folio-sample-summary {
            cursor: pointer;
            list-style: none;
        }

        .folio-sample-summary::-webkit-details-marker {
            display: none;
        }

        .folio-sample-chevron {
            transition: transform .15s ease;
        }

        .folio-sample-questions[open] .folio-sample-chevron {
            transform: rotate(180deg);
        }

        .folio-answer {
            font-size: 1rem;
            line-height: 1.7;
        }

        .folio-thinking-lines {
            display: grid;
            gap: .5rem;
            max-width: 520px;
        }

        .folio-thinking-lines span {
            display: block;
            height: .65rem;
            border-radius: 999px;
            background: linear-gradient(
                90deg,
                var(--tblr-bg-surface-secondary) 0%,
                var(--tblr-border-color) 50%,
                var(--tblr-bg-surface-secondary) 100%
            );
            background-size: 200% 100%;
            animation: folioThinking 1.2s ease-in-out infinite;
        }

        .folio-thinking-lines span:nth-child(1) {
            width: 90%;
        }

        .folio-thinking-lines span:nth-child(2) {
            width: 72%;
            animation-delay: .12s;
        }

        .folio-thinking-lines span:nth-child(3) {
            width: 48%;
            animation-delay: .24s;
        }

        @keyframes folioThinking {
            0% {
                background-position: 200% 0;
                opacity: .55;
            }

            50% {
                opacity: 1;
            }

            100% {
                background-position: -200% 0;
                opacity: .55;
            }
        }

        .folio-source-row {
            display: grid;
            grid-template-columns: 2rem 56px minmax(0, 1fr) auto;
            gap: .75rem;
            align-items: center;
            text-align: left;
            padding: .75rem 1rem;
            border-left: 0;
            border-right: 0;
            background: transparent;
            cursor: pointer;
        }

        .folio-source-row:hover {
            background: var(--tblr-bg-surface-secondary);
        }

        .folio-source-actions {
            display: flex;
            gap: .375rem;
            white-space: nowrap;
        }

        .folio-source-chevron {
            transition: transform .15s ease;
        }

        .folio-source-row:hover .folio-source-chevron {
            transform: translateX(2px);
        }

        .folio-detail-sidebar-card {
            position: sticky;
            top: 1rem;
        }

        .folio-source-index {
            width: 1.75rem;
            height: 1.75rem;
            display: inline-flex;
            align-items: center;
            justify-content: center;
            border-radius: 999px;
            background: var(--tblr-primary-lt);
            color: var(--tblr-primary);
            font-size: .75rem;
            font-weight: 600;
        }

        .folio-source-thumb,
        .folio-source-thumb-empty {
            width: 56px;
            height: 44px;
            border-radius: .5rem;
            object-fit: cover;
            background: var(--tblr-bg-surface-secondary);
        }

        .folio-source-thumb-empty {
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--tblr-muted);
        }

        .folio-side-source {
            display: grid;
            grid-template-columns: 56px minmax(0, 1fr) auto;
            gap: .75rem;
            align-items: center;
            padding: .625rem;
            border: 1px solid var(--tblr-border-color);
            border-radius: .75rem;
            text-decoration: none;
            color: inherit;
            background: transparent;
        }

        .folio-side-source:hover {
            background: var(--tblr-bg-surface-secondary);
            text-decoration: none;
        }

        .folio-side-source img,
        .folio-side-source-icon {
            width: 56px;
            height: 44px;
            border-radius: .5rem;
            object-fit: cover;
            background: var(--tblr-bg-surface-secondary);
        }

        .folio-side-source-icon {
            display: flex;
            align-items: center;
            justify-content: center;
            color: var(--tblr-muted);
        }

        .folio-source-offcanvas {
            --tblr-offcanvas-width: 420px;
        }

        .icon-lg {
            width: 3rem;
            height: 3rem;
        }

        @media (max-width: 575.98px) {
            .folio-source-row {
                grid-template-columns: 1.75rem 48px minmax(0, 1fr) auto;
                padding: .625rem .75rem;
            }

            .folio-source-thumb,
            .folio-source-thumb-empty {
                width: 48px;
                height: 40px;
            }
        }
    </style>

    <script>
        function folioChatCopySourceText(source) {
            if (!source) {
                return '';
            }

            if (source instanceof HTMLTemplateElement) {
                return source.content.textContent || '';
            }

            return source.textContent || '';
        }

        function folioChatCopyRenderedText(content) {
            return (content?.innerText || content?.textContent || '')
                .replace(/[ \t]+\n/g, '\n')
                .replace(/\n{3,}/g, '\n\n')
                .trim();
        }

        async function folioChatWriteCopyText(text) {
            if (navigator.clipboard?.writeText) {
                try {
                    await navigator.clipboard.writeText(text);
                    return;
                } catch {
                    // Fall back when clipboard permissions are denied.
                }
            }

            const textarea = document.createElement('textarea');
            textarea.value = text;
            textarea.setAttribute('readonly', '');
            textarea.style.position = 'fixed';
            textarea.style.opacity = '0';
            document.body.appendChild(textarea);
            textarea.select();
            document.execCommand('copy');
            textarea.remove();
        }

        function folioChatShowCopyFeedback(button) {
            const original = button.dataset.originalContent || button.innerHTML;

            button.dataset.originalContent = original;
            button.innerHTML = button.dataset.copiedContent || 'Copied';
            button.disabled = true;

            window.setTimeout(function () {
                button.innerHTML = original;
                button.disabled = false;
            }, 1200);
        }

        async function folioChatCopyAnswer(button) {
            const root = button.closest('[data-folio-chat-copy-root]');
            const source = root?.querySelector('[data-folio-chat-copy-source]');
            const content = root?.querySelector('[data-folio-chat-copy-content]');
            const text = (folioChatCopySourceText(source).trim() || folioChatCopyRenderedText(content)).trim();

            if (!text) {
                return;
            }

            await folioChatWriteCopyText(text);
            folioChatShowCopyFeedback(button);
        }

        document.addEventListener('click', function (e) {
            const button = e.target.closest('[data-folio-chat-copy-button]');

            if (!button) {
                return;
            }

            e.preventDefault();
            folioChatCopyAnswer(button);
        });

        function openFolioSourceDetail(row) {
            const idx = row.dataset.folioDetailIdx;
            const offcanvasTarget = row.dataset.folioOffcanvasTarget;

            if (!idx) {
                return;
            }

            const isDesktop = window.matchMedia('(min-width: 992px)').matches;

            if (isDesktop) {
                const tpl = document.querySelector('.folio-detail-tpl[data-idx="' + idx + '"]');
                const target = document.getElementById('folio-detail-sidebar');

                if (!tpl || !target) {
                    return;
                }

                document
                    .querySelectorAll('.folio-source-row.active')
                    .forEach(el => el.classList.remove('active'));

                row.classList.add('active');

                target.replaceChildren(tpl.content.cloneNode(true));
                return;
            }

            if (offcanvasTarget && window.bootstrap) {
                const offcanvasEl = document.querySelector(offcanvasTarget);

                if (!offcanvasEl) {
                    return;
                }

                const offcanvas = bootstrap.Offcanvas.getOrCreateInstance(offcanvasEl);
                offcanvas.show();
            }
        }

        document.addEventListener('click', function (e) {
            const row = e.target.closest('.folio-source-row[data-folio-detail-idx]');

            if (!row) {
                return;
            }

            openFolioSourceDetail(row);
        });

        document.addEventListener('keydown', function (e) {
            const row = e.target.closest('.folio-source-row[data-folio-detail-idx]');

            if (!row) {
                return;
            }

            if (e.key === 'Enter' || e.key === ' ') {
                e.preventDefault();
                openFolioSourceDetail(row);
            }
        });

        document.addEventListener('submit', function (e) {
            const form = e.target.closest('#folio-chat-form');

            if (!form) {
                return;
            }

            const textarea = form.querySelector('#folio-chat-q');
            const submitBtn = form.querySelector('#folio-chat-submit');
            const processing = document.getElementById('folio-chat-processing');

            if (textarea && !textarea.value.trim()) {
                e.preventDefault();
                textarea.focus();
                return;
            }

            if (submitBtn) {
                submitBtn.disabled = true;
                submitBtn.classList.add('btn-loading');

                const label = submitBtn.querySelector('.folio-submit-text');

                if (label) {
                    label.textContent = 'Thinking...';
                }
            }

            if (processing) {
                processing.classList.remove('d-none');
                processing.scrollIntoView({ behavior: 'smooth', block: 'center' });
            }
        });

        const folioProcessingMessages = [
            'Thinking...',
            'Searching...',
            'Reading sources...',
            'Preparing results...'
        ];

        let folioProcessingIndex = 0;

        setInterval(() => {
            const processingCard = document.getElementById('folio-chat-processing');
            const text = document.getElementById('folio-processing-text');

            if (!processingCard || !text || processingCard.classList.contains('d-none')) {
                return;
            }

            folioProcessingIndex = (folioProcessingIndex + 1) % folioProcessingMessages.length;
            text.textContent = folioProcessingMessages[folioProcessingIndex];
        }, 1000);
    </script>
{% endblock %}
