{% extends app.request.attributes.get('_layout')|default(folio_base_template()) %}

{% set controllerName = 'survos--folio-bundle--map' %}

{# Same reasoning as the Overview button this page used to have: the page-header banner
   (pretitle/title/subtitle) predates the navbar and just repeats what it already shows,
   while pushing the map itself further down the page. #}
{% set _ = page({ showPageHeader: false }) %}

{% block body_class %}folio-layout{% endblock %}

{% block title %}Map · {{ provider }}/{{ dataset }}{% endblock %}

{% block body %}
    {% if not hasUxMap %}
        <div class="alert alert-warning">
            The Map view needs <code>symfony/ux-map</code> (with a renderer, e.g.
            <code>symfony/ux-leaflet-map</code>) installed in this application.
            Run <code>composer require symfony/ux-map symfony/ux-leaflet-map</code> to enable it.
        </div>
    {% else %}
        {# The custom controller must be attached to the SAME element ux_map() renders, not a wrapper
           around it -- ux_map()'s `attributes['data-controller']` is exactly the hook for that (see
           Symfony\UX\Map\Renderer\AbstractRenderer::renderMap(), which merges it alongside the
           renderer's own controller onto one <div>). StimulusAttributes|toArray() gives back exactly
           the {'data-controller': ..., 'data-...-value': ...} shape that `attributes` expects, so
           stimulus_controller()|merge(...) composes cleanly instead of hand-building attribute names.

           zoom is a required, always-LAST route segment (see mapGeoJson()), so the base URL below is
           generated with a dummy zoom=0 and then has that trailing "/0" sliced off -- the JS
           controller just appends "/{zoom}" itself on every fetch, whatever the current zoom is. #}
        {% set geojsonUrlBase = (filter
            ? path('survos_folio_map_geojson_filtered', {provider: provider, dataset: dataset, filter: filter, zoom: 0})
            : path('survos_folio_map_geojson', {provider: provider, dataset: dataset, zoom: 0})
        )|slice(0, -2) %}
        {{ ux_map(center: [20, 0], zoom: 2, attributes: stimulus_controller(controllerName, {geojsonUrl: geojsonUrlBase, rowUrlTemplate: rowUrlTemplate, slideshowBaseUrl: slideshowBaseUrl|default('')})|merge({
            style: 'height: 70vh; width: 100%; border-radius: 0.5rem;',
        })) }}

        <style>
            .folio-map-marker-cluster {
                display: flex;
                align-items: center;
                justify-content: center;
                width: 2.5rem;
                height: 2.5rem;
                border-radius: 50%;
                background: #066fd1;
                color: #fff;
                font-weight: 600;
                box-shadow: 0 0 0 3px rgba(6, 111, 209, 0.3);
            }

            .folio-map-popup img {
                display: block;
                width: 100%;
                max-width: 200px;
                border-radius: 0.35rem;
                margin-bottom: 0.35rem;
            }

            .folio-map-popup a {
                color: inherit;
                text-decoration: none;
            }

            .folio-map-popup a:hover strong {
                text-decoration: underline;
            }

            .folio-map-popup-place,
            .folio-map-cluster-slideshow .folio-map-popup-place {
                margin-top: 0.15rem;
                font-size: 0.8rem;
                color: #777;
            }

            .folio-map-cluster-slideshow {
                width: 180px;
                text-align: center;
            }

            .folio-map-cluster-nav {
                display: flex;
                align-items: center;
                gap: 0.35rem;
            }

            .folio-map-cluster-nav img {
                flex: 1 1 auto;
                width: 100%;
                max-width: 140px;
                border-radius: 0.35rem;
            }

            .folio-map-cluster-prev,
            .folio-map-cluster-next {
                flex: 0 0 auto;
                border: none;
                background: none;
                font-size: 1.5rem;
                line-height: 1;
                cursor: pointer;
                color: #066fd1;
            }

            .folio-map-cluster-prev:disabled,
            .folio-map-cluster-next:disabled {
                opacity: 0.3;
                cursor: default;
            }

            .folio-map-cluster-caption {
                margin-top: 0.35rem;
                font-size: 0.8rem;
                color: #555;
            }

            .folio-map-cluster-caption a {
                color: inherit;
                text-decoration: none;
            }

            .folio-map-cluster-caption a:hover {
                text-decoration: underline;
            }

            .folio-map-cluster-view-all {
                display: block;
                margin-top: 0.5rem;
                padding-top: 0.4rem;
                border-top: 1px solid rgba(0, 0, 0, 0.1);
                font-size: 0.8rem;
                font-weight: 600;
                color: #066fd1;
                text-decoration: none;
            }

            .folio-map-cluster-view-all:hover {
                text-decoration: underline;
            }
        </style>
    {% endif %}
{% endblock %}
