{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set controllerName = 'survos--folio-bundle--slideshow' %}

{% block body_class %}folio-layout{% endblock %}

{% block page_pretitle %}Folio Slideshow{% endblock %}

{% block page_title %}
    {{ core.label ?: core.code }}{% if dtoType %} / {{ dtoType }}{% endif %}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    {{ slides|length|number_format }} slide{{ slides|length == 1 ? '' : 's' }}
{% endblock %}

{% block title %}Slideshow · {{ ctx.folioCode }} · {{ core.code }}{% endblock %}

{% block body %}
    <div class="d-flex flex-wrap gap-2 mb-3">
        <a class="btn btn-outline-secondary" href="{{ path('survos_folio_show', {provider: provider, dataset: dataset}) }}">
            {% guard function ux_icon %}{{ ux_icon('tabler:layout-dashboard', {class: 'icon me-1'}) }}{% endguard %}
            Overview
        </a>
        <a class="btn btn-outline-secondary" href="{{ path('survos_folio_core', {provider: provider, dataset: dataset, coreCode: core.code}) }}">
            {% guard function ux_icon %}{{ ux_icon('tabler:list', {class: 'icon me-1'}) }}{% endguard %}
            Core list
        </a>
    </div>

    {% if slides is empty %}
        <div class="alert alert-info">No slideshow images found for this filter.</div>
    {% else %}
        <div class="folio-slideshow" {{ stimulus_controller(controllerName, {slides: slides}) }}>
            <div class="row g-3 align-items-stretch">
                <div class="col-lg-8">
                    <div class="card h-100 text-white overflow-hidden" style="background: #111;">
                        <div class="ratio ratio-4x3">
                            <img
                                class="w-100 h-100 folio-slideshow-image"
                                style="object-fit: contain; background: #111;"
                                alt=""
                                {{ stimulus_target(controllerName, 'image') }}
                            >
                        </div>
                        <div class="card-footer bg-dark border-secondary d-flex justify-content-between align-items-center gap-2">
                            <button type="button" class="btn btn-outline-light" {{ stimulus_action(controllerName, 'previous') }}>
                                {% guard function ux_icon %}{{ ux_icon('tabler:chevron-left', {class: 'icon me-1'}) }}{% endguard %}
                                Previous
                            </button>
                            <span class="badge text-bg-light" {{ stimulus_target(controllerName, 'index') }}></span>
                            <button type="button" class="btn btn-outline-light" {{ stimulus_action(controllerName, 'next') }}>
                                Next
                                {% guard function ux_icon %}{{ ux_icon('tabler:chevron-right', {class: 'icon ms-1'}) }}{% endguard %}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            {# Detail is deferred — the viewer just notes which row is selected. #}
                            <div class="text-muted" {{ stimulus_target(controllerName, 'detail') }}></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="folio-thumbnail-strip mt-3">
                {% for slide in slides|slice(0, 120) %}
                    <button
                        type="button"
                        class="folio-thumbnail"
                        title="#{{ slide.id }}"
                        data-slide-index="{{ loop.index0 }}"
                        {{ stimulus_target(controllerName, 'thumbnail') }}
                        {{ stimulus_action(controllerName, 'jump') }}
                    >
                        {% if slide.thumb %}
                            <img
                                src="{{ slide.thumb|imgproxy('thumb') }}"
                                alt=""
                                loading="lazy"
                                decoding="async"
                            >
                        {% else %}
                            <span class="small text-muted">{{ loop.index }}</span>
                        {% endif %}
                    </button>
                {% endfor %}

                {% if slides|length > 120 %}
                    <span class="text-muted small align-self-center px-2">
                        Showing first 120 of {{ slides|length|number_format }}.
                    </span>
                {% endif %}
            </div>

            <collection-slider
                min="1"
                max="{{ slides|length }}"
                value="1"
                step="1"
                tick-count="10"
                {{ stimulus_target(controllerName, 'slider') }}
            ></collection-slider>
        </div>
    {% endif %}

    <style>
        .folio-thumbnail-strip {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
            padding: 0.5rem 0;
            scrollbar-width: thin;
        }

        .folio-thumbnail {
            flex: 0 0 auto;
            width: 72px;
            height: 56px;
            padding: 2px;
            border: 2px solid transparent;
            border-radius: 0.5rem;
            background: #fff;
            cursor: pointer;
        }

        .folio-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 0.35rem;
            display: block;
        }

        .folio-thumbnail.is-active {
            border-color: #066fd1;
        }

        .folio-slideshow-image {
            opacity: 1;
            transition: opacity 140ms ease;
        }

        .folio-slideshow-image.is-changing {
            opacity: 0;
        }
    </style>
{% endblock %}