{% extends app.request.attributes.get('_layout')|default(folio_base_template()) %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set controllerName = 'survos--folio-bundle--slideshow' %}

{% block body_class %}folio-layout{% endblock %}

{% block page_pretitle %}Folio Slideshow{% endblock %}

{% block page_title %}
    {{ core.label ?: core.code }}{% if dtoType %} / {{ dtoType }}{% endif %}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    {{ slides|length|number_format }} slide{{ slides|length == 1 ? '' : 's' }}
{% endblock %}

{% block title %}Slideshow · {{ ctx.folioCode }} · {{ core.code }}{% endblock %}

{% block body %}
    {# Overview/Core-list buttons removed here too (see map.html.twig's own history) -- dead
       navigation from before openfoto had a real navbar; it now covers getting back to the
       folio's main view, so this stuck-out-of-place row of buttons could just go. #}

    {% if slides is empty %}
        <div class="alert alert-info">No slideshow images found for this filter.</div>
    {% else %}
        <div class="folio-slideshow" {{ stimulus_controller(controllerName, {slides: slides}) }}>
            <div class="row g-3 align-items-stretch">
                <div class="col-lg-8">
                    <div class="card h-100 text-white overflow-hidden" style="background: #111;">
                        <div class="ratio ratio-4x3">
                            <img
                                class="w-100 h-100 folio-slideshow-image"
                                style="object-fit: contain; background: #111;"
                                alt=""
                                {{ stimulus_target(controllerName, 'image') }}
                            >
                        </div>
                        <div class="card-footer bg-dark border-secondary d-flex justify-content-between align-items-center gap-2">
                            <button type="button" class="btn btn-outline-light" {{ stimulus_action(controllerName, 'previous') }}>
                                {% guard function ux_icon %}{{ ux_icon('tabler:chevron-left', {class: 'icon me-1'}) }}{% endguard %}
                                Previous
                            </button>
                            <span class="badge text-bg-light" {{ stimulus_target(controllerName, 'index') }}></span>
                            <button type="button" class="btn btn-outline-light" {{ stimulus_action(controllerName, 'next') }}>
                                Next
                                {% guard function ux_icon %}{{ ux_icon('tabler:chevron-right', {class: 'icon ms-1'}) }}{% endguard %}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-body">
                            {# Detail is deferred — the viewer just notes which row is selected. #}
                            <div class="text-muted" {{ stimulus_target(controllerName, 'detail') }}></div>
                        </div>
                    </div>
                </div>
            </div>

            <div class="folio-thumbnail-strip mt-3">
                {% for slide in slides|slice(0, 120) %}
                    <button
                        type="button"
                        class="folio-thumbnail"
                        title="#{{ slide.id }}"
                        data-slide-index="{{ loop.index0 }}"
                        {{ stimulus_target(controllerName, 'thumbnail') }}
                        {{ stimulus_action(controllerName, 'jump') }}
                    >
                        {% if slide.thumb %}
                            <img
                                src="{{ slide.thumb|imgproxy('thumb') }}"
                                alt=""
                                loading="lazy"
                                decoding="async"
                            >
                        {% else %}
                            <span class="small text-muted">{{ loop.index }}</span>
                        {% endif %}
                    </button>
                {% endfor %}

                {% if slides|length > 120 %}
                    <span class="text-muted small align-self-center px-2">
                        Showing first 120 of {{ slides|length|number_format }}.
                    </span>
                {% endif %}
            </div>

            {# Index mode: slider runs 1…N. Value mode (numeric sort, e.g. Year): slider runs over the
               field's real min..max so its handle IS the year. slideshow_controller maps between the
               slider value and the slide. #}
            <collection-slider
                min="{{ slider.min }}"
                max="{{ slider.max }}"
                value="{{ slider.value }}"
                step="1"
                tick-count="10"
                counts="{{ counts|default({})|json_encode }}"
                data-slideshow-numeric="{{ slider.numeric ? '1' : '0' }}"
                {{ stimulus_target(controllerName, 'slider') }}
            ></collection-slider>
        </div>
    {% endif %}

    <style>
        .folio-thumbnail-strip {
            display: flex;
            gap: 0.5rem;
            overflow-x: auto;
            padding: 0.5rem 0;
            scrollbar-width: thin;
        }

        .folio-thumbnail {
            flex: 0 0 auto;
            width: 72px;
            height: 56px;
            padding: 2px;
            border: 2px solid transparent;
            border-radius: 0.5rem;
            background: #fff;
            cursor: pointer;
        }

        .folio-thumbnail img {
            width: 100%;
            height: 100%;
            object-fit: cover;
            border-radius: 0.35rem;
            display: block;
        }

        .folio-thumbnail.is-active {
            border-color: #066fd1;
        }

        .folio-slideshow-image {
            opacity: 1;
            transition: opacity 140ms ease;
        }

        .folio-slideshow-image.is-changing {
            opacity: 0;
        }

        /* <collection-slider> -- Fortepan.hu-style year ruler: red draggable knob, a black
           count badge pinned above it, decade tick marks. See assets/elements/collection-slider.js. */
        .cslider {
            display: flex;
            align-items: center;
            gap: 0.75rem;
            margin-top: 1.5rem;
            padding-top: 1.75rem; /* room for the badge above the knob */
            user-select: none;
            touch-action: none;
        }

        .cslider__label {
            font-size: 0.8rem;
            color: var(--tblr-secondary, #6c757d);
            flex: 0 0 auto;
        }

        .cslider__track {
            position: relative;
            flex: 1 1 auto;
            height: 6px;
            border-radius: 3px;
            background: var(--tblr-border-color, #dfe3e8);
            cursor: pointer;
        }

        .cslider__fill {
            position: absolute;
            top: 0;
            left: 0;
            height: 100%;
            border-radius: 3px;
            background: #c0392b;
            pointer-events: none;
        }

        .cslider__ticks {
            position: absolute;
            inset: 0;
            pointer-events: none;
        }

        .cslider__tick {
            position: absolute;
            top: 100%;
            width: 1px;
            height: 5px;
            margin-top: 2px;
            background: var(--tblr-border-color, #dfe3e8);
            transform: translateX(-0.5px);
        }

        .cslider__knob {
            position: absolute;
            top: 50%;
            width: 16px;
            height: 16px;
            margin-left: -8px;
            border-radius: 50%;
            background: #c0392b;
            border: 2px solid #fff;
            box-shadow: 0 0 0 1px rgba(0, 0, 0, 0.15);
            transform: translateY(-50%);
            cursor: grab;
        }

        .cslider__knob.is-active {
            cursor: grabbing;
            transform: translateY(-50%) scale(1.15);
        }

        .cslider__knob.is-empty {
            background: #adb5bd;
        }

        .cslider__badge {
            position: absolute;
            bottom: 100%;
            left: 50%;
            margin-bottom: 8px;
            transform: translateX(-50%);
            background: #111;
            color: #fff;
            font-size: 0.72rem;
            font-weight: 600;
            line-height: 1;
            white-space: nowrap;
            padding: 0.3rem 0.5rem;
            border-radius: 0.35rem;
        }

        .cslider__hover {
            position: absolute;
            top: -1.6rem;
            transform: translateX(-50%);
            font-size: 0.7rem;
            color: var(--tblr-secondary, #6c757d);
            opacity: 0;
            transition: opacity 120ms ease;
            pointer-events: none;
            white-space: nowrap;
        }

        .cslider__hover.is-visible {
            opacity: 1;
        }
    </style>
{% endblock %}