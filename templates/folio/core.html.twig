{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}
{% block body %}
{% set parts = ctx.folioCode|split('/') %}
{% set apiUrl = path('folio_rows', {provider: parts[0], dataset: parts[1], coreCode: core.code}) %}

{# Build api-grid column list: use dtoData.* dot-notation when a DTO is selected #}
{% set apiColumns = [{name: 'localId', title: 'ID', sortable: true}] %}
{% if selectedDto and columns %}
    {% for col in columns %}
        {% if col != 'id' %}
            {% set apiColumns = apiColumns|merge([{name: 'dtoData.' ~ col, title: col}]) %}
        {% endif %}
    {% endfor %}
{% else %}
    {% set apiColumns = apiColumns|merge([
        {name: 'label',    title: 'Label',   searchable: true},
        {name: 'dtoType',  title: 'Type',    searchable: false},
    ]) %}
{% endif %}

<div class="container-xl py-4">

    {# ── breadcrumb ── #}
    <div class="page-header mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h2 class="page-title">
                    <a href="{{ path('survos_folio_show', {provider: parts[0], dataset: parts[1]}) }}" class="text-muted">{{ ctx.folioCode }}</a>
                    <span class="text-muted mx-1">/</span>{{ core.code }}
                </h2>
                <div class="text-muted">{{ core.rowCount }} rows</div>
            </div>
        </div>
    </div>

    {# ── DTO type tabs ── #}
    {% if dtoStats %}
    <div class="card mb-4">
        <div class="card-header">
            <ul class="nav nav-tabs card-header-tabs">
                <li class="nav-item">
                    <a class="nav-link {{ not selectedDto ? 'active' }}"
                       href="{{ path('survos_folio_core', {provider: parts[0], dataset: parts[1], coreCode: core.code}) }}">
                        All <span class="badge bg-secondary ms-1">{{ core.rowCount }}</span>
                    </a>
                </li>
                {% for dto in dtoChoices %}
                    <li class="nav-item">
                        <a class="nav-link {{ selectedDto == dto.type ? 'active' }}"
                           href="{{ path('survos_folio_core', {provider: parts[0], dataset: parts[1], coreCode: core.code, dto: dto.type}) }}">
                            {{ dto.label }}
                            <span class="badge bg-secondary ms-1">{{ dto.count }}</span>
                        </a>
                    </li>
                {% endfor %}
            </ul>
        </div>
    </div>
    {% endif %}

    {# ── api-grid browse ── #}
    {% if selectedDto %}
        <div class="text-muted small mb-2 font-monospace">{{ selectedDto }}</div>
    {% endif %}

    <twig:api_grid
        :class="rowClass"
        :apiGetCollectionUrl="apiUrl"
        :columns="apiColumns"
        :filter="selectedDto ? {dto: selectedDto} : {}"
        :pageLength="50"
        :search="true"
    />

</div>
{% endblock %}
