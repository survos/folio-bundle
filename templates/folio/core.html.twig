{% extends '@SurvosFolioBundle/folio/base.html.twig' %}

{# folio_rows (Row::API_ROWS) is still {provider}/{dataset}/{coreCode} — its own separate,
   not-yet-done migration (see PhotoGrid's docblock) — so this is the one place in this
   template that still needs the split, purely to feed that API endpoint. #}
{% set parts = folio.code|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set apiUrl = path('folio_rows', {
    folioCode: folio.code,
    coreCode: core.code
}) %}

{% block body_class %}folio-layout{% endblock %}

{% block page_pretitle %}Folio Core{% endblock %}

{% block page_title %}
    {{ core.label ?: core.code }}
    {% if selectedDto %}
        / {{ selectedDto }}
    {% endif %}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    {{ core.rowCount|number_format }} rows in {{ core.code }}
{% endblock %}

{% block title %}
    {{ core.code }}{% if selectedDto %} / {{ selectedDto }}{% endif %} · {{ ctx.folioCode }}
{% endblock %}

{% block body %}
    {# Build api-grid column list: use dtoData.* dot-notation when a DTO is selected #}
    {% set apiColumns = [
        {
            name: 'thumbnailUrl',
            title: '',
            width: '88px',
            twigTemplate: '{% if data %}<img src="{{ data }}" alt="" loading="lazy" style="width:72px;height:72px;object-fit:contain">{% endif %}'
        },
        {
            name: 'localId',
            title: 'Row',
            route: 'survos_folio_row_show',
            sortable: true,
            width: '16rem'
        },
        {
            name: 'dtoData.imageCount',
            title: 'Images',
            sortable: true,
            width: '7rem'
        }
    ] %}

    {% if selectedDto and columns %}
        {% for col in columns %}
            {% if col != 'id' %}
                {% set apiColumns = apiColumns|merge([
                    {
                        name: 'dtoData.' ~ col,
                        title: col
                    }
                ]) %}
            {% endif %}
        {% endfor %}
    {% else %}
        {% set apiColumns = apiColumns|merge([
            {
                name: 'label',
                title: 'Label',
                searchable: true
            },
            {
                name: 'dtoType',
                title: 'Type',
                searchable: false
            }
        ]) %}
    {% endif %}

    <div id="api-grid-top" style="scroll-margin-top: 1rem;"></div>

    {% if dtoStats %}
        {% set selectedDtoChoice = dtoChoices|filter(dto => dto.type == selectedDto)|first %}
        {% set selectedDtoLabel = selectedDtoChoice ? selectedDtoChoice.label : 'All' %}
        {% set selectedDtoCount = selectedDtoChoice ? selectedDtoChoice.count : core.rowCount %}

        <div class="card mb-3">
            <div class="card-body p-2">

                {# Mobile dropdown #}
                <div class="dropdown d-md-none">
                    <button
                        class="btn dropdown-toggle w-100 d-flex justify-content-between align-items-center"
                        type="button"
                        data-bs-toggle="dropdown"
                        aria-expanded="false"
                    >
                        <span>{{ selectedDtoLabel }}</span>
                        <span class="badge text-bg-secondary ms-auto me-3">
                            {{ selectedDtoCount|number_format }}
                        </span>
                    </button>

                    <div class="dropdown-menu w-100" style="max-height: 240px; overflow-y: scroll;">
                        <a
                            class="dropdown-item d-flex justify-content-between align-items-center {{ not selectedDto ? 'active' }}"
                            href="{{ path('survos_folio_core', {
                                folioCode: folio.code,
                                coreCode: core.code
                            }) }}"
                        >
                            <span>All</span>
                            <span class="badge text-bg-secondary">
                                {{ core.rowCount|number_format }}
                            </span>
                        </a>

                        {% for dto in dtoChoices %}
                            <a
                                class="dropdown-item d-flex justify-content-between align-items-center {{ selectedDto == dto.type ? 'active' }}"
                                href="{{ path('survos_folio_core_dto', {
                                    folioCode: folio.code,
                                    coreCode: core.code,
                                    dtoType: dto.type
                                }) }}"
                            >
                                <span>{{ dto.label }}</span>
                                <span class="badge text-bg-secondary">
                                    {{ dto.count|number_format }}
                                </span>
                            </a>
                        {% endfor %}
                    </div>
                </div>

                {# Desktop pills #}
                <ul class="nav nav-pills flex-wrap gap-2 mb-0 d-none d-md-flex">
                    <li class="nav-item">
                        <a
                            class="nav-link d-inline-flex align-items-center gap-2 {{ not selectedDto ? 'active' }}"
                            href="{{ path('survos_folio_core', {
                                folioCode: folio.code,
                                coreCode: core.code
                            }) }}"
                        >
                            <span>All</span>
                            <span class="badge {{ not selectedDto ? 'text-bg-primary' : 'text-bg-secondary' }}">
                                {{ core.rowCount|number_format }}
                            </span>
                        </a>
                    </li>

                    {% for dto in dtoChoices %}
                        <li class="nav-item">
                            <a
                                class="nav-link d-inline-flex align-items-center gap-2 {{ selectedDto == dto.type ? 'active' }}"
                                href="{{ path('survos_folio_core_dto', {
                                    folioCode: folio.code,
                                    coreCode: core.code,
                                    dtoType: dto.type
                                }) }}"
                            >
                                <span>{{ dto.label }}</span>
                                <span class="badge {{ selectedDto == dto.type ? 'text-bg-primary' : 'text-bg-secondary' }}">
                                    {{ dto.count|number_format }}
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>

            </div>
        </div>
    {% endif %}

    <div id="api-grid-wrapper">
        <twig:api_grid
            :class="rowClass"
            :apiGetCollectionUrl="apiUrl"
            :columns="apiColumns"
            :filter="selectedDto ? {dtoType: selectedDto} : {}"
            :pageLength="50"
            :search="true"
        />
    </div>

    <script>
        (() => {
            const initApiGridScroll = () => {
                const top = document.getElementById('api-grid-top');
                const wrapper = document.getElementById('api-grid-wrapper');

                if (!top || !wrapper || wrapper.dataset.scrollHandlerAttached) {
                    return;
                }

                wrapper.dataset.scrollHandlerAttached = '1';

                let shouldScroll = false;

                wrapper.addEventListener('click', (event) => {
                    if (event.target.closest('a, button')) {
                        shouldScroll = true;
                    }
                });

                wrapper.addEventListener('change', () => {
                    shouldScroll = true;
                });

                wrapper.addEventListener('input', () => {
                    shouldScroll = true;
                });

                const observer = new MutationObserver(() => {
                    if (!shouldScroll) {
                        return;
                    }

                    shouldScroll = false;

                    setTimeout(() => {
                        top.scrollIntoView({
                            behavior: 'instant',
                            block: 'start'
                        });
                    }, 100);
                });

                observer.observe(wrapper, {
                    childList: true,
                    subtree: true
                });
            };

            document.addEventListener('DOMContentLoaded', initApiGridScroll);
            document.addEventListener('turbo:load', initApiGridScroll);
            initApiGridScroll();
        })();
    </script>
{% endblock %}
