{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set apiUrl = path('folio_rows', {
    provider: provider,
    dataset: dataset,
    coreCode: core.code
}) %}

{% block body_class %}folio-layout{% endblock %}

{% block page_pretitle %}Folio Core{% endblock %}

{% block page_title %}
    {{ core.label ?: core.code }}
    {% if selectedDto %}
        / {{ selectedDto }}
    {% endif %}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    {{ core.rowCount|number_format }} rows in {{ core.code }}
{% endblock %}

{% block title %}
    {{ core.code }}{% if selectedDto %} / {{ selectedDto }}{% endif %} · {{ ctx.folioCode }}
{% endblock %}

{% block body %}
    {# Build api-grid column list: use dtoData.* dot-notation when a DTO is selected #}
    {% set apiColumns = [
        {
            name: 'thumbnailUrl',
            title: '',
            width: '88px',
            twigTemplate: '{% if data %}<img src="{{ data }}" alt="" loading="lazy" style="width:72px;height:72px;object-fit:contain">{% endif %}'
        },
        {
            name: 'localId',
            title: 'Row',
            route: 'survos_folio_row_show',
            sortable: true,
            width: '16rem'
        },
        {
            name: 'dtoData.imageCount',
            title: 'Images',
            sortable: true,
            width: '7rem'
        }
    ] %}

    {% if selectedDto and columns %}
        {% for col in columns %}
            {% if col != 'id' %}
                {% set apiColumns = apiColumns|merge([
                    {
                        name: 'dtoData.' ~ col,
                        title: col
                    }
                ]) %}
            {% endif %}
        {% endfor %}
    {% else %}
        {% set apiColumns = apiColumns|merge([
            {
                name: 'label',
                title: 'Label',
                searchable: true
            },
            {
                name: 'dtoType',
                title: 'Type',
                searchable: false
            }
        ]) %}
    {% endif %}

    {% if dtoStats %}
        <div class="card mb-3">
            <div class="card-body py-2">
                <ul class="nav nav-pills flex-wrap gap-2 mb-0">
                    <li class="nav-item">
                        <a
                            class="nav-link d-flex align-items-center gap-2 {{ not selectedDto ? 'active' }}"
                            href="{{ path('survos_folio_core', {
                                provider: provider,
                                dataset: dataset,
                                coreCode: core.code
                            }) }}"
                        >
                            <span>All</span>
                            <span class="badge {{ not selectedDto ? 'bg-white text-primary' : 'bg-secondary text-white' }}">
                                {{ core.rowCount|number_format }}
                            </span>
                        </a>
                    </li>

                    {% for dto in dtoChoices %}
                        <li class="nav-item">
                            <a
                                class="nav-link d-flex align-items-center gap-2 {{ selectedDto == dto.type ? 'active' }}"
                                href="{{ path('survos_folio_core_dto', {
                                    provider: provider,
                                    dataset: dataset,
                                    coreCode: core.code,
                                    dtoType: dto.type
                                }) }}"
                            >
                                <span>{{ dto.label }}</span>
                                <span class="badge {{ selectedDto == dto.type ? 'bg-white text-primary' : 'bg-secondary text-white' }}">
                                    {{ dto.count|number_format }}
                                </span>
                            </a>
                        </li>
                    {% endfor %}
                </ul>
            </div>
        </div>
    {% endif %}

    <twig:api_grid
        :class="rowClass"
        :apiGetCollectionUrl="apiUrl"
        :columns="apiColumns"
        :filter="selectedDto ? {dtoType: selectedDto} : {}"
        :pageLength="50"
        :search="true"
    />
{% endblock %}
