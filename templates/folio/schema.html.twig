{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set folioLabel = 'Folio ' ~ ctx.folioCode %}

{% block stylesheets %}
    {{ parent() }}
    <link rel="stylesheet" href="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/styles/github-dark.min.css">
{% endblock %}

{% block body_class %}folio-layout{% endblock %}

{% block page_pretitle %}Folio Schema{% endblock %}

{% block page_title %}
    {{ folioLabel }}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    {{ tables|length }} tables
    <span class="mx-1 text-muted">&middot;</span>
    {{ views|length }} views
{% endblock %}

{% block title %}Schema: {{ ctx.folioCode }}{% endblock %}

{% block body %}
    <div class="row">
        <div class="col-3">
            <div class="card">
                <div class="card-body px-2 py-2">
                    <div class="nav flex-column nav-pills" role="tablist" aria-orientation="vertical">
                        <a class="nav-link active" data-bs-toggle="pill" href="#tab-diagram" role="tab">
                            Diagram
                        </a>

                        <hr class="my-2">

                        {% for table in tables %}
                            <a class="nav-link font-monospace" data-bs-toggle="pill" href="#table-{{ table.name }}" role="tab">
                                {{ table.name }}
                            </a>
                        {% endfor %}

                        {% if views %}
                            <hr class="my-2">

                            {% for view in views %}
                                <a class="nav-link font-monospace text-muted" data-bs-toggle="pill" href="#view-{{ view.name }}" role="tab">
                                    {{ view.name }}
                                </a>
                            {% endfor %}
                        {% endif %}
                    </div>
                </div>
            </div>
        </div>

        <div class="col-9">
            <div class="tab-content">
                <div class="tab-pane fade show active" id="tab-diagram" role="tabpanel">
                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title mb-0">Entity-Linkship Diagram</h2>
                        </div>

                        <div class="card-body text-center">
                            {{
                                source('@SurvosFolioBundle/folio/_er-diagram.svg')
                                    |replace({
                                        '<svg ': '<svg style="width:100%; height:auto;" '
                                    })
                                    |raw
                            }}
                        </div>
                    </div>
                </div>

                {% for table in tables %}
                    <div class="tab-pane fade" id="table-{{ table.name }}" role="tabpanel">
                        <div class="card">
                            <div class="card-header">
                                <h2 class="card-title mb-0 font-monospace">
                                    {{ table.name }}
                                </h2>
                            </div>

                            <div class="card-body">
                                {% if ddl[table.name] is defined %}
                                    <pre class="rounded"><code class="language-sql">{{ ddl[table.name] }};</code></pre>
                                {% endif %}

                                {% if table.indexes %}
                                    <h3 class="h4 mt-3">Indexes</h3>

                                    <table class="table table-vcenter border">
                                        <thead>
                                            <tr>
                                                <th>Name</th>
                                                <th>Columns</th>
                                                <th>Unique</th>
                                            </tr>
                                        </thead>
                                        <tbody>
                                            {% for idx in table.indexes %}
                                                <tr>
                                                    <td class="fs-5 font-monospace">{{ idx.name }}</td>
                                                    <td class="fs-5 font-monospace">{{ idx.columns }}</td>
                                                    <td class="fs-5">{{ idx.unique }}</td>
                                                </tr>
                                            {% endfor %}
                                        </tbody>
                                    </table>
                                {% endif %}
                            </div>
                        </div>
                    </div>
                {% endfor %}

                {% for view in views %}
                    <div class="tab-pane fade" id="view-{{ view.name }}" role="tabpanel">
                        <div class="card">
                            <div class="card-header">
                                <h2 class="card-title mb-0 font-monospace">
                                    {{ view.name }}
                                </h2>
                            </div>

                            <div class="card-body">
                                <pre class="rounded"><code class="language-sql">{{ view.sql }};</code></pre>
                            </div>
                        </div>
                    </div>
                {% endfor %}
            </div>
        </div>
    </div>

    <script src="https://cdnjs.cloudflare.com/ajax/libs/highlight.js/11.9.0/highlight.min.js"></script>
    <script>hljs.highlightAll();</script>
{% endblock %}
