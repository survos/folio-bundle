{% extends app.request.attributes.get('_layout')|default(folio_base_template()) %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}

{% block body_class %}folio-layout{% endblock %}

{% block page_pretitle %}Folio Term{% endblock %}

{% block page_title %}
    {{ term.label ?: term.code }}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    <span class="font-monospace">{{ termSet.code }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    <span class="font-monospace">{{ term.code }}</span>
{% endblock %}

{% block title %}
    {{ term.label ?: term.code }} · {{ ctx.folioCode }}
{% endblock %}

{% block body %}
    <div class="card">
        <div class="card-header">
            <h2 class="card-title mb-0">Term</h2>
        </div>

        <div class="card-body">
            <dl class="row mb-0">
                <dt class="col-sm-2">Set</dt>
                <dd class="col-sm-10 font-monospace">
                    {{ termSet.code }}
                </dd>

                <dt class="col-sm-2">Code</dt>
                <dd class="col-sm-10 font-monospace">
                    {{ term.code }}
                </dd>

                <dt class="col-sm-2">Label</dt>
                <dd class="col-sm-10">
                    {{ term.label ?: term.code }}
                </dd>

                {% if term.description %}
                    <dt class="col-sm-2">Description</dt>
                    <dd class="col-sm-10">
                        {{ term.description }}
                    </dd>
                {% endif %}
            </dl>
        </div>
    </div>
{% endblock %}
