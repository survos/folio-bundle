{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set folioLabel = folio and folio.label ? folio.label : ctx.folioCode %}
{% set hitOptions = { folioCode: ctx.folioCode, hitTemplate: 'search/hits/folio_row.html.twig' } %}

{% block page_pretitle %}Folio Search{% endblock %}
{% block page_title %}{{ folioLabel }}{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    {% if folio and folio.rowCount %}
        <span class="mx-1 text-muted">&middot;</span>{{ folio.rowCount|number_format }} records
    {% endif %}
{% endblock %}

{% block title %}{{ folioLabel }} Search{% endblock %}

{% block page_content_before %}
    {{ parent() }}

    {% if cores|length > 0 %}
        <div class="container-xl mt-3">
            <div class="card">
                <div class="card-body py-2">
                    <div class="d-flex flex-wrap align-items-center gap-2">
                        <span class="text-secondary small">Cores</span>

                        {% for core in cores %}
                            <a class="btn btn-sm btn-outline-secondary"
                            href="{{ path('survos_folio_core', {
                                provider: provider,
                                dataset: dataset,
                                coreCode: core.code
                            }) }}">
                                {{ core.label ?: core.code }}
                                {% if core.rowCount %}
                                    &middot; {{ core.rowCount|number_format }}
                                {% endif %}
                            </a>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}
{% endblock %}

{% block body_class %}folio-layout{% endblock %}
{% block body %}
    <twig:Mezcalito:UxSearch:Layout
        name="folio_row"
        :options="hitOptions"
    />
{% endblock %}
