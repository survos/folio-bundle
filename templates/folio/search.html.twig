{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set folioLabel = folio and folio.label ? folio.label : ctx.folioCode %}
{% set hitOptions = { folioCode: ctx.folioCode, hitTemplate: 'search/hits/folio_row.html.twig' } %}
{% if selectedCore|default(null) %}
    {% set hitOptions = hitOptions|merge({coreCode: selectedCore}) %}
{% endif %}
{% if selectedDtoType|default(null) %}
    {% set hitOptions = hitOptions|merge({dtoType: selectedDtoType}) %}
{% endif %}
{% set fixedFilters = {} %}
{% if selectedCore|default(null) %}
    {% set fixedFilters = fixedFilters|merge({core: selectedCore}) %}
{% endif %}
{% if selectedDtoType|default(null) %}
    {% set fixedFilters = fixedFilters|merge({dtoType: selectedDtoType}) %}
{% endif %}

{#
   ── Re-skinning this page (header / branding / theme) ───────────────────────────────
   An app overrides ONLY the chrome — never the search — by creating:

       templates/bundles/SurvosFolioBundle/folio/search.html.twig

   with just:

       {% extends '@!SurvosFolioBundle/folio/search.html.twig' %}
       {% block folio_search_header %} …your header / hero… {% endblock %}
       {% block folio_search_styles %} <style>…your theme…</style> {% endblock %}

   The `@!` keeps inheriting THIS template, so `folio_search_core` (the actual ux-search
   call) stays shared and can never drift between apps. Available in the header block:
   provider, dataset (slug), folio (entity), folioLabel, cores, selectedCore,
   selectedDtoType, ctx — plus {{ block('folio_search_slideshow_button') }}, a ready-wired
   button you can drop into your own layout.
   ──────────────────────────────────────────────────────────────────────────────────── #}

{% block title %}{{ folioLabel }} Search{% endblock %}

{% block body_class %}folio-layout{% endblock %}

{% block body %}
    {% block folio_search_header %}
        {% if cores|length > 0 %}
            <div class="container-xl mt-3">
                <div class="card">
                    <div class="card-body py-2">
                        <div class="d-flex flex-wrap align-items-center gap-2">
                            <span class="text-secondary small">Cores</span>

                            {% for core in cores %}
                                {# Always translate (system domain, built by `trans:system`); fall back to the
                                   bare code, never core.label — it's populated with the code and shadows the translation. #}
                                {% set coreKey = 'core.' ~ core.code %}
                                {% set coreLabel = coreKey|trans({}, 'system') %}
                                <a class="btn btn-sm {{ selectedCore|default(null) == core.code ? 'btn-primary' : 'btn-outline-secondary' }}"
                                href="{{ path('survos_folio_core_search', {
                                    provider: provider,
                                    dataset: dataset,
                                    coreCode: core.code
                                }) }}">
                                    {{ coreLabel == coreKey ? core.code : coreLabel }}
                                    {% if core.rowCount %}
                                        &middot; {{ core.rowCount|number_format }}
                                    {% endif %}
                                </a>
                            {% endfor %}

                            {{ block('folio_search_slideshow_button') }}
                            {{ block('folio_search_map_button') }}
                        </div>
                    </div>
                </div>
            </div>
        {% endif %}
    {% endblock %}

    {% block folio_search_core %}
        {# The shared search — do NOT override this in an app skin, keep it identical everywhere. #}
        <div id="ux-search-results-top" style="scroll-margin-top: 1rem;"></div>

        <div id="ux-search-wrapper" class="container-xl">
            {% do app.request.attributes.set('ux_search_placeholder', 'Search ID, title, description, summary, OCR text') %}
            <twig:Mezcalito:UxSearch:Layout
                name="folio_row"
                :options="hitOptions"
                :fixedFilters="fixedFilters"
            />
        </div>

        <script>
            (() => {
                const initUxSearchScroll = () => {
                    const top = document.getElementById('ux-search-results-top');
                    const wrapper = document.getElementById('ux-search-wrapper');

                    if (!top || !wrapper || wrapper.dataset.scrollHandlerAttached) {
                        return;
                    }

                    wrapper.dataset.scrollHandlerAttached = '1';

                    let shouldScroll = false;

                    wrapper.addEventListener('click', (event) => {
                        const trigger = event.target.closest(
                            'a, button, [data-action*="live#action"]'
                        );

                        if (trigger) {
                            shouldScroll = true;
                        }
                    });

                    wrapper.addEventListener('change', (event) => {
                        if (event.target.matches('input, select, textarea')) {
                            shouldScroll = true;
                        }
                    });

                    wrapper.addEventListener('input', (event) => {
                        if (event.target.matches('input[type="search"], input[type="text"]')) {
                            shouldScroll = true;
                        }
                    });

                    const observer = new MutationObserver(() => {
                        if (!shouldScroll) {
                            return;
                        }

                        shouldScroll = false;

                        setTimeout(() => {
                            top.scrollIntoView({
                                behavior: 'instant',
                                block: 'start'
                            });
                        }, 100);
                    });

                    observer.observe(wrapper, {
                        childList: true,
                        subtree: true
                    });
                };

                document.addEventListener('DOMContentLoaded', initUxSearchScroll);
                document.addEventListener('turbo:load', initUxSearchScroll);
                initUxSearchScroll();
            })();
        </script>
    {% endblock %}

    {% block folio_search_styles %}
        <style>
            .page-header {
                display: none !important;
            }
        </style>
    {% endblock %}
{% endblock %}

{#
   A ready-wired "Slideshow" button: links to the current core's slideshow and, via the
   slideshow-link controller, keeps its target in sync with the grid's sort + facet state.
   Reusable from any header override with {{ block('folio_search_slideshow_button') }}.
#}
{% block folio_search_slideshow_button %}
    {% if selectedCore|default(null) %}
        {# base = the unfiltered slideshow for this core; the controller appends a /{token} path segment.
           A pinned dtoType isn't a grid query param, so seed the initial href with it and hand it to the
           controller as a fixed filter to fold into every token it builds. #}
        {% set slideshowBase = path('survos_folio_slideshow', {provider: provider, dataset: dataset, coreCode: selectedCore}) %}
        {% set initialUrl = selectedDtoType|default(null)
            ? path('survos_folio_slideshow_filtered', {provider: provider, dataset: dataset, coreCode: selectedCore, filter: slideshow_filter({dtoType: selectedDtoType})})
            : slideshowBase %}
        <a class="btn btn-sm btn-outline-primary ms-auto"
           href="{{ initialUrl }}"
           data-controller="slideshow-link"
           data-slideshow-link-base-value="{{ slideshowBase }}"
           data-slideshow-link-fixed-value="{{ selectedDtoType|default(null) ? 'dtoType=' ~ selectedDtoType : '' }}">
            {{ ux_icon('tabler:slideshow', { class: 'icon me-1' }) }}
            Slideshow
        </a>
    {% endif %}
{% endblock %}

{#
   A ready-wired "Map" button: reuses the exact same slideshow-link controller (it's generic --
   base + a /{token} path segment from the grid's current filter state), just pointed at the map
   route instead of slideshow. Unlike Slideshow, Map isn't core-scoped (it plots the whole dataset),
   so no selectedCore guard and no fixed/dtoType handling needed.
   Reusable from any header override with {{ block('folio_search_map_button') }}.
#}
{% block folio_search_map_button %}
    {% set mapBase = path('survos_folio_map', {provider: provider, dataset: dataset}) %}
    <a class="btn btn-sm btn-outline-primary"
       href="{{ mapBase }}"
       data-controller="slideshow-link"
       data-slideshow-link-base-value="{{ mapBase }}">
        {{ ux_icon('tabler:map-2', { class: 'icon me-1' }) }}
        Map
    </a>
{% endblock %}
