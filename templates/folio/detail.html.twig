{% extends '@SurvosFolioBundle/folio/row/base.html.twig' %}

{% trans_default_domain 'system' %}

{% import _self as folio_row %}

{% macro render_value(value) %}
    {% if value is iterable %}
        <pre class="mb-0">{{ value|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
    {% elseif value is url %}
        {{ value|urlize }}
    {% else %}
        {{ value }}
    {% endif %}
{% endmacro %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set th = row.thumbnailSource %}
{% set termFields = termFields|default([]) %}
{% set pageAiUrls = [] %}

{% set tombstoneTitle = attribute(row.dtoData, 'title')|default(attribute(row.extras, 'dcterms:title')|default(row.label ?: row.localId)) %}
{# Strip a wrapping-quote data artifact (e.g. SMK titles arrive fully quoted); only when the WHOLE
   value is quoted, so legitimate internal quotes are preserved. Deeper cleanup belongs at normalize. #}
{% if tombstoneTitle starts with '"' and tombstoneTitle ends with '"' %}
    {% set tombstoneTitle = tombstoneTitle|trim('"') %}
{% endif %}
{% set tombstoneDescription = attribute(row.dtoData, 'description')|default(attribute(row.extras, 'dcterms:description')|default(null)) %}
{% set tombstoneDate = attribute(row.dtoData, 'date')|default(attribute(row.extras, 'dcterms:date')|default(null)) %}
{% set tombstoneDimensions = attribute(row.dtoData, 'dimensions')|default(null) %}
{% set tombstoneDimensionsRaw = attribute(row.dtoData, 'dimensionsRaw')|default(null) %}
{% set citationUrl = row.citationUrl ?: attribute(row.dtoData, 'citationUrl')|default(null) %}
{% set sourceUrl = attribute(row.dtoData, 'url')|default(null) %}
{% set tombstoneUrl = citationUrl ?: sourceUrl %}
{% set tombstoneCredit = attribute(row.dtoData, 'citation')|default(null) %}
{% set tombstoneSourceImage = attribute(row.dtoData, 'largeImageUrl')|default(attribute(row.dtoData, 'iiifBase')|default(null)) %}
{% set promotedFields = ['title', 'description', 'date', 'dimensions', 'dimensionsRaw', 'weight', 'citationUrl', 'ocrText'] %}

{% if sourceUrl and (sourceUrl == citationUrl or citationUrl is empty) %}
    {% set promotedFields = promotedFields|merge(['url']) %}
{% endif %}

{% set ocrText = attribute(row.dtoData, 'ocrText')|default(null) %}
{% set pageCount = attribute(row.dtoData, 'pageCount')|default(null) %}
{% set tombstoneYear = attribute(row.dtoData, 'year')|default(tombstoneDate) %}
{% set tombstoneDenseSummary = attribute(row.dtoData, 'denseSummary')|default(attribute(row.extras, 'ai:denseSummary')|default(null)) %}
{% set observationProse = attribute(row.dtoData, 'observationProse')|default(attribute(row.dtoData, 'ai:observationProse')|default(attribute(row.extras, 'ai:observationProse')|default(null))) %}
{# The source's own caption ONLY — never the AI-filled description/denseSummary, which is shown as the summary above. #}
{% set sourceCaption = attribute(row.dtoData, 'sourceCaption')|default(attribute(row.extras, 'sourceCaption')|default(null)) %}

{# geoPrecision is only set when GeocodeRowListener filled the coordinate in FROM a city/country match
   (see md's GeocodeRowListener) — its mere presence means "this is a place centroid, not a point", so
   the mini-map below only renders for rows WITHOUT it (native per-photo GPS). #}
{% set tombstoneLatitude = attribute(row.dtoData, 'latitude')|default(null) %}
{% set tombstoneLongitude = attribute(row.dtoData, 'longitude')|default(null) %}
{% set tombstoneIsPreciseLocation = tombstoneLatitude is not null and tombstoneLongitude is not null and attribute(row.extras, 'geoPrecision')|default(null) is null %}

{% block body_class %}folio-layout folio-object-page{% endblock %}

{% block page_pretitle %}{% endblock %}
{% block page_title %}{% endblock %}
{% block page_subtitle %}{% endblock %}

{% block title %}
    {{ tombstoneTitle }} · {{ ctx.folioCode }}
{% endblock %}

{% block body %}
    {% set pages = pageTableExists ? row.pages : [] %}
    {# Plain-text digital objects (e.g. NARA "ASCII Text" manifests) aren't an image/IIIF canvas —
       piping them through imgproxy/OpenSeadragon just breaks the viewer. Pull them out of the
       image page-set and render their content directly below instead. #}
    {% set textFilePages = pages|filter(p => p.url matches '/\\.txt($|\\?)/i') %}
    {% set pages = pages|filter(p => not (p.url matches '/\\.txt($|\\?)/i')) %}
    {% set pageAiUrls = pages|map(p => p.url) %}
    {% set pageTexts = pages|map(p => p.text|default('')) %}
    {# Mistral structured layout per page (typed blocks + bboxes). When present the viewer renders the
       pretty, layout-aware version; otherwise it falls back to the flat OCR text (pageTexts). #}
    {% set pageLayouts = pages|map(p => p.layout|default(null)) %}
    {% set hasLayout = pages|filter(p => p.layout is not empty)|length > 0 %}
    {# Handwriting-annotated transcription (htr_annotate): <hw> wraps handwritten entries on a printed
       form. Preferred over layout/text when present — the viewer renders handwriting in italics. #}
    {% set pageHtr = pages|map(p => p.htr|default(null)) %}
    {% set hasHtr = pages|filter(p => p.htr is not empty)|length > 0 %}
    {% set pageAskUrls = [] %}
    {% for page in pages %}
        {% set pageAskUrls = pageAskUrls|merge([path('survos_folio_page_chat', {provider: provider, dataset: dataset, coreCode: core.code, dtoType: row.dtoType ?: 'row', localId: row.localId, seq: page.seq})]) %}
    {% endfor %}
    {% set hasOcr = pageTexts|filter(t => t|trim is not empty)|length > 0 %}
    {% set isSingleImage = pages|length == 1 and not attribute(row.dtoData, 'pdfUrl')|default(null) %}
    {% set pdfUrl = attribute(row.dtoData, 'pdfUrl')|default(null) %}
    {% set docPageCount = attribute(row.dtoData, 'pageCount')|default(0) %}
    {% set videoPages = pages|filter(p => p.url matches '/\\.(mp4|mpe?g|mov|avi|wmv|m4v|webm)($|\\?)/i') %}
    {% set hasFolioDetailActions = block('folio_detail_actions')|trim is not empty %}

    <div class="container-xl py-4 py-lg-5">
        <div class="folio-detail-shell">

            <div class="folio-detail-hero">
                <div class="row g-4 align-items-end">
                    <div class="col-lg-8">
                        <nav class="d-flex flex-wrap align-items-center gap-2 small text-muted mb-3">
                            {{ ux_icon('tabler:home', { class: 'icon icon-sm' }) }}

                            {% set providerUrl = folio_provider_url(provider) %}
                            {% if providerUrl %}
                                <a href="{{ providerUrl }}" class="text-reset text-decoration-none">{{ provider }}</a>
                            {% else %}
                                <span>{{ provider }}</span>
                            {% endif %}

                            <span>/</span>
                            <a href="{{ path('survos_folio_show', { provider: provider, dataset: dataset }) }}"
                               class="text-reset text-decoration-none">{{ dataset }}</a>

                            <span>/</span>
                            <a href="{{ path('survos_folio_core_search', { provider: provider, dataset: dataset, coreCode: core.code }) }}"
                               class="text-reset text-decoration-none">{{ ('core.' ~ core.code)|trans }}</a>

                            {% if row.dtoType %}
                                <span>/</span>
                                <a href="{{ path('survos_folio_core_type_search', { provider: provider, dataset: dataset, coreCode: core.code, dtoType: row.dtoType }) }}"
                                   class="text-reset text-decoration-none">{{ row.dtoType }}</a>
                            {% endif %}
                        </nav>

                        {# Prev/next document within this core (build order) — keyset nav (LAG/LEAD). #}
                        {% set adjacent = adjacent|default(null) %}
                        {% if adjacent and (adjacent.prev or adjacent.next) %}
                            <div class="btn-group btn-group-sm mb-2" role="group" aria-label="Document navigation">
                                <a class="btn btn-outline-secondary {{ adjacent.prev ? '' : 'disabled' }}" rel="prev"
                                   {% if adjacent.prev %}href="{{ path('survos_folio_row_show', {provider: provider, dataset: dataset, coreCode: core.code, dtoType: adjacent.prev.dtoType, localId: adjacent.prev.localId}) }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}>
                                    {{ ux_icon('tabler:chevron-left', { class: 'icon' }) }} {{ 'prev'|trans({}, 'folio') }}
                                </a>
                                <a class="btn btn-outline-secondary {{ adjacent.next ? '' : 'disabled' }}" rel="next"
                                   {% if adjacent.next %}href="{{ path('survos_folio_row_show', {provider: provider, dataset: dataset, coreCode: core.code, dtoType: adjacent.next.dtoType, localId: adjacent.next.localId}) }}"{% else %}aria-disabled="true" tabindex="-1"{% endif %}>
                                    {{ 'next'|trans({}, 'folio') }} {{ ux_icon('tabler:chevron-right', { class: 'icon' }) }}
                                </a>
                            </div>
                        {% endif %}

                        <h1 class="folio-detail-title mb-3">{{ tombstoneTitle }}</h1>

                        <div class="d-flex flex-wrap align-items-center gap-2 mb-3">
                            {% if tombstoneYear %}
                                <span class="badge rounded-pill bg-warning-lt px-3">
                                    {{ ux_icon('tabler:calendar', { class: 'icon me-1' }) }}
                                    {{ tombstoneYear }}
                                </span>
                            {% endif %}

                            {% if tombstoneDimensions is iterable and tombstoneDimensions is not empty %}
                                {# Structured dimensions → dimensions-bundle renderer (icons + units, raw fallback) #}
                                {{ dim_render(tombstoneDimensions, attribute(row.dtoData, 'weight')|default([]), tombstoneDimensionsRaw) }}
                            {% elseif tombstoneDimensions or tombstoneDimensionsRaw %}
                                <span class="badge rounded-pill bg-white text-muted border px-3">
                                    {{ ux_icon('tabler:ruler-measure', { class: 'icon me-1' }) }}
                                    {{ tombstoneDimensions ?: tombstoneDimensionsRaw }}
                                </span>
                            {% endif %}

                            {% if tombstoneUrl %}
                                <a href="{{ tombstoneUrl }}" target="_blank" rel="noopener" class="text-decoration-none">
                                    Citation {{ ux_icon('tabler:external-link', { class: 'icon ms-1' }) }}
                                </a>
                            {% endif %}

                            {% if tombstoneSourceImage %}
                                <a href="{{ tombstoneSourceImage }}" target="_blank" rel="noopener" class="text-decoration-none">
                                    Source image {{ ux_icon('tabler:photo', { class: 'icon ms-1' }) }}
                                </a>
                            {% endif %}
                        </div>

                        {% if tombstoneCredit %}
                            <div class="small text-muted mb-3">{{ tombstoneCredit }}</div>
                        {% endif %}

                        {% if tombstoneDenseSummary %}
                            <p class="text-muted mb-0" style="max-width: 58rem;">{{ tombstoneDenseSummary }}</p>
                        {% elseif tombstoneDescription %}
                            <p class="text-muted mb-0" style="max-width: 58rem;">
                                {{ tombstoneDescription|striptags|u.truncate(280, '...') }}
                            </p>
                        {% endif %}
                    </div>

                    {% if pageAiUrls|length > 0 or th or hasFolioDetailActions %}
                        <div class="col-lg-4">
                            <div class="d-flex flex-wrap justify-content-lg-end gap-2">
                                {{ block('folio_detail_actions') }}
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% if pages|length > 0 and (hasOcr or hasLayout or hasHtr) and not isSingleImage and videoPages|length == 0 %}
                <div class="folio-viewer-toolbar-card">
                    <div class="card-header d-flex flex-column flex-md-row align-items-md-center justify-content-end gap-3">
                        <div class="btn-group folio-view-mode-control" role="group" aria-label="Document viewer mode">
                            <input type="radio"
                                   class="btn-check js-folio-view-mode"
                                   name="folio-view-mode"
                                   id="folio-view-mode-osd"
                                   value="osd"
                                   autocomplete="off">
                            <label class="btn btn-outline-secondary" for="folio-view-mode-osd">
                                {{ ux_icon('tabler:photo', { class: 'icon me-1' }) }}
                                OSD Viewer
                            </label>

                            <input type="radio"
                                   class="btn-check js-folio-view-mode"
                                   name="folio-view-mode"
                                   id="folio-view-mode-text"
                                   value="text"
                                   autocomplete="off">
                            <label class="btn btn-outline-secondary" for="folio-view-mode-text">
                                {{ ux_icon('tabler:file-text', { class: 'icon me-1' }) }}
                                OCR Text
                            </label>

                            <input type="radio"
                                   class="btn-check js-folio-view-mode"
                                   name="folio-view-mode"
                                   id="folio-view-mode-side-by-side"
                                   value="side-by-side"
                                   autocomplete="off"
                                   checked>
                            <label class="btn btn-outline-secondary" for="folio-view-mode-side-by-side">
                                {{ ux_icon('tabler:layout-columns', { class: 'icon me-1' }) }}
                                Split View
                            </label>
                        </div>
                    </div>
                </div>
            {% endif %}

            <div class="row row-cards folio-viewer-grid" id="folio-viewer-grid" data-viewer-mode="side-by-side">
                <div class="col-lg-8" id="doc-main-col">
                    {% if videoPages|length > 0 %}
                        <div id="doc-viewer" class="card mb-3">
                            <div class="card-body">
                                {% for page in videoPages %}
                                    <video controls preload="metadata" class="w-100 mb-2 bg-dark rounded" style="max-height: 70vh;">
                                        <source src="{{ page.url }}">
                                        Your browser can't play this video — <a href="{{ page.url }}">download it</a>.
                                    </video>
                                {% endfor %}
                            </div>
                            <div class="card-footer py-2 small text-muted">
                                {{ videoPages|length }} video file{{ videoPages|length > 1 ? 's' : '' }}
                            </div>
                        </div>

                    {% elseif pdfUrl %}
                        <div id="doc-viewer" class="card mb-3">
                            <div class="card-body p-0">
                                <twig:iiif:pdf
                                    :url="pdfUrl"
                                    :pageCount="docPageCount"
                                    :height="600"
                                    :showLinks="true"
                                />
                            </div>

                            <div id="doc-page-status" class="card-footer py-2 small text-muted">
                                {{ docPageCount ? 'PDF · ' ~ docPageCount ~ ' pages' : 'PDF' }}{{ hasOcr ? '' : ' — no extracted text' }}
                            </div>
                        </div>

                    {% elseif pages|length > 0 %}
                        {% set rowManifestUrl = url('survos_folio_iiif_manifest', {provider: provider, dataset: dataset, coreCode: core.code, localId: row.localId}) %}
                        {% set viewerImages = [] %}
                        {% set viewerHires = [] %}
                        {% set viewerInfoUrls = [] %}

                        {% for page in pages %}
                            {% set pageImg = page.url %}
                            {% set pageHires = page.url %}
                            {% set pageInfoUrl = null %}
                            {% guard filter imgproxy %}
                                {% set pageImg = page.url|imgproxy('thumb') %}
                                {% set pageHires = page.url|imgproxy('archive') %}
                                {% set pageInfoUrl = path('survos_imgproxy_info', {url: page.url}) %}
                            {% endguard %}
                            {% set viewerImages = viewerImages|merge([pageImg]) %}
                            {% set viewerHires = viewerHires|merge([pageHires]) %}
                            {% set viewerInfoUrls = viewerInfoUrls|merge([pageInfoUrl]) %}
                        {% endfor %}

                        <div id="doc-viewer" class="card mb-3">
                            <div class="card-body p-0">
                                <twig:iiif:viewer
                                    :images="viewerImages"
                                    :hiresImages="viewerHires"
                                    :infoUrls="viewerInfoUrls"
                                    :manifestUrl="rowManifestUrl"
                                    :height="600"
                                    :showLinks="false"
                                />
                            </div>

                            {# Multi-image only: the page counter + OCR-status footer is meaningful when
                               there's more than one page. For a single image (e.g. a photograph) it was
                               just "Page 1 of 1 — no extracted text" noise; the OCR panel below already
                               reports text presence. JS updates this element only on page-change events. #}
                            {% if viewerImages|length > 1 %}
                                <div id="doc-page-status" class="card-footer py-2 small text-muted d-flex justify-content-center align-items-center gap-2">
                                    <button type="button"
                                            class="btn btn-action rounded-pill border-0 js-folio-page-prev"
                                            style="min-width: 1.25rem; min-height: 1rem;"
                                            data-page-count="{{ viewerImages|length }}"
                                            aria-label="Previous page"
                                            title="Previous page"
                                            disabled>
                                        {{ ux_icon('tabler:chevron-left', { class: 'icon' }) }}
                                    </button>
                                    <span id="doc-page-status-text">
                                        Page 1 of {{ viewerImages|length }}{{ pageTexts|first|trim ? '' : ' — no extracted text' }}
                                    </span>
                                    <button type="button"
                                            class="btn btn-action rounded-pill border-0 js-folio-page-next"
                                            style="min-width: 1.25rem; min-height: 1rem;"
                                            data-page-count="{{ viewerImages|length }}"
                                            aria-label="Next page"
                                            title="Next page">
                                        {{ ux_icon('tabler:chevron-right', { class: 'icon' }) }}
                                    </button>
                                </div>
                            {% endif %}
                        </div>
                    {% endif %}

                    {% for textPage in textFilePages %}
                        {# survos_folio_page_raw fetches the source file server-side and strips origin
                           headers (NARA serves these with Content-Disposition: attachment, which would
                           force a download). Loaded into a <pre> via same-origin fetch rather than an
                           <iframe>, so it inherits page styling/theme instead of its own blank frame. #}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <span>{{ ux_icon('tabler:file-text', { class: 'icon me-1' }) }}Text file</span>
                                <a href="{{ textPage.url }}" target="_blank" rel="noopener" class="small">Open raw</a>
                            </div>
                            <pre class="card-body mb-0 folio-text-page" style="max-height: 50vh; overflow: auto; white-space: pre-wrap;"
                                 data-url="{{ path('survos_folio_page_raw', {provider: provider, dataset: dataset, coreCode: core.code, dtoType: row.dtoType ?: 'row', localId: row.localId, seq: textPage.seq}) }}">Loading…</pre>
                        </div>
                    {% endfor %}
                    {% if textFilePages|length > 0 %}
                        <script>
                            document.querySelectorAll('.folio-text-page').forEach(function (el) {
                                fetch(el.dataset.url)
                                    .then(function (r) { return r.text(); })
                                    .then(function (t) { el.textContent = t; })
                                    .catch(function () { el.textContent = 'Unable to load text file.'; });
                            });
                        </script>
                    {% endif %}

                    {% if pdfUrl or pages|length > 0 %}
                        <script>
                            (function () {
                                var texts = null, layouts = null, htrs = null;
                                function dataArr(attr) {
                                    var el = document.getElementById('doc-ocr-text');
                                    try { return el ? JSON.parse(el.dataset[attr] || '[]') : []; } catch (err) { return []; }
                                }
                                function pageTexts() { if (texts === null) texts = dataArr('pageTexts'); return texts; }
                                function pageLayouts() { if (layouts === null) layouts = dataArr('pageLayouts'); return layouts; }
                                function pageHtr() { if (htrs === null) htrs = dataArr('pageHtr'); return htrs; }
                                function esc(s) { return String(s).replace(/[&<>]/g, function (c) { return { '&': '&amp;', '<': '&lt;', '>': '&gt;' }[c]; }); }
                                // Mistral block type → bootstrap styling, so the layout reads like a document, not a dump.
                                var BLOCK_CLASS = { headline: 'fw-bold fs-5 mb-2', subheadline: 'fw-semibold mb-2', caption: 'fst-italic text-muted small mb-2', byline: 'fst-italic small text-muted mb-2', column: 'mb-2', paragraph: 'mb-2', other: 'mb-2' };
                                // Minimal inline markdown: **bold** / *italic* over already-escaped text.
                                function inlineMd(s) {
                                    return esc(s)
                                        .replace(/\*\*([^*]+)\*\*/g, '<strong>$1</strong>')
                                        .replace(/(^|[^*])\*([^*]+)\*(?!\*)/g, '$1<em>$2</em>');
                                }
                                function isTableRow(t) { return /^\s*\|.*\|\s*$/.test(t) && (t.match(/\|/g) || []).length >= 2; }
                                function isSepRow(t) { return isTableRow(t) && /^[\s|:-]+$/.test(t) && t.indexOf('-') !== -1; }
                                function rowCells(t) { return t.trim().replace(/^\|/, '').replace(/\|$/, '').split('|').map(function (c) { return c.trim(); }); }
                                // "markdown+": render block types as a document, and fold runs of markdown
                                // table rows (Mistral emits register/grid data as one |a|b| row per block) into
                                // a real HTML table instead of pipe-soup.
                                function renderLayout(blocks) {
                                    var out = [], tbl = null;
                                    function flush() {
                                        if (tbl && tbl.length) {
                                            out.push('<table class="table table-sm table-bordered align-middle mb-3" style="width:auto; font-size:0.8rem;"><tbody>'
                                                + tbl.map(function (r) { return '<tr>' + r.map(function (c) { return '<td class="px-2 py-1 text-nowrap">' + inlineMd(c) + '</td>'; }).join('') + '</tr>'; }).join('')
                                                + '</tbody></table>');
                                        }
                                        tbl = null;
                                    }
                                    blocks.forEach(function (b) {
                                        var t = (b && b.text || '').trim();
                                        if (!t || b.type === 'image' || b.type === 'advertisement') return;
                                        if (isTableRow(t)) { if (!isSepRow(t)) { (tbl || (tbl = [])).push(rowCells(t)); } return; }
                                        flush();
                                        var hm = t.match(/^(#{1,6})\s+([\s\S]*)$/);
                                        if (hm) { out.push('<div class="fw-bold fs-5 mb-2">' + inlineMd(hm[2].trim()) + '</div>'); return; }
                                        out.push('<div class="ocr-block ' + (BLOCK_CLASS[b.type] || 'mb-2') + '" data-block-type="' + esc(b.type || '') + '" style="white-space: pre-wrap;">' + inlineMd(t) + '</div>');
                                    });
                                    flush();
                                    return out.join('');
                                }
                                // htr_annotate: <hw>handwritten</hw> on a printed form. Render handwriting in
                                // italics, flag uncertain reads (<?>), preserve line structure.
                                function renderHtr(s) {
                                    // Some htr claims arrive JSON-encoded (a quoted string with \n, \/, \uXXXX);
                                    // decode so <hw> tags and line breaks are real before we mark up.
                                    if (s && s.charAt(0) === '"') { try { s = JSON.parse(s); } catch (e) {} }
                                    return esc(s)
                                        .replace(/&lt;hw&gt;([\s\S]*?)&lt;\/hw&gt;/g, '<em class="hw-fill" style="color:#1d4ed8;">$1</em>')
                                        .replace(/&lt;\?&gt;/g, '<sup class="text-danger" title="uncertain reading">?</sup>')
                                        .replace(/\n/g, '<br>');
                                }
                                function renderPage(i, total) {
                                    var ocrEl = document.getElementById('doc-ocr-text');
                                    if (!ocrEl) return;
                                    var htr = pageHtr()[i], layout = pageLayouts()[i], badge = document.getElementById('doc-ocr-badge');
                                    if (htr && htr.trim()) {
                                        ocrEl.innerHTML = '<div style="line-height:1.7;">' + renderHtr(htr) + '</div>';
                                        if (badge) { badge.textContent = 'Handwriting'; badge.className = 'badge bg-green-lt'; }
                                    } else if (layout && layout.length) {
                                        ocrEl.innerHTML = renderLayout(layout) || '<span class="text-muted">(no text on this page)</span>';
                                        if (badge) { badge.textContent = 'Layout'; badge.className = 'badge bg-purple-lt'; }
                                    } else {
                                        ocrEl.textContent = (pageTexts()[i] || '').trim() || '(no extracted text for this page)';
                                        if (badge) { badge.textContent = 'OCR'; badge.className = 'badge bg-blue-lt'; }
                                    }
                                    var ocrPage = document.getElementById('doc-ocr-page');
                                    if (ocrPage && total) ocrPage.textContent = 'page ' + (i + 1) + ' of ' + total;
                                }
                                // Render page 1 once the panel exists (this script runs before it in the DOM).
                                document.addEventListener('DOMContentLoaded', function () {
                                    renderPage(0, Math.max(pageTexts().length, pageLayouts().length, pageHtr().length));
                                });
                                document.addEventListener('iiif-viewer:page', function (e) {
                                    var i = e.detail.index, total = e.detail.total;
                                    renderPage(i, total);
                                    var hasText = ((pageTexts()[i] || '').trim()) || ((pageLayouts()[i] || []).length);
                                    var status = document.getElementById('doc-page-status');
                                    var statusText = document.getElementById('doc-page-status-text');
                                    if (statusText) {
                                        statusText.textContent = 'Page ' + (i + 1) + ' of ' + total + (hasText ? '' : ' — no extracted text');
                                    } else if (status) {
                                        status.textContent = 'Page ' + (i + 1) + ' of ' + total + (hasText ? '' : ' — no extracted text');
                                    }
                                    // Point the OCR/Handwriting buttons and page Scholar link at the page currently shown.
                                    document.querySelectorAll('.js-folio-ai-btn').forEach(function (b) {
                                        b.href = b.dataset.aiBase + '?task=' + encodeURIComponent(b.dataset.aiTask) + '&run=1&page=' + i;
                                    });
                                    var pageScholar = document.getElementById('doc-page-scholar-link');
                                    if (pageScholar) {
                                        try {
                                            var urls = JSON.parse(pageScholar.dataset.pageChatUrls || '[]');
                                            if (urls[i]) {
                                                pageScholar.href = urls[i];
                                            }
                                        } catch (err) {}
                                    }
                                });
                            })();
                        </script>
                    {% endif %}

                    {% if pages|length > 1 and videoPages|length == 0 %}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h2 class="card-title mb-0">Images <span class="text-muted">({{ pages|length }})</span></h2>
                            </div>

                            <div class="card-body">
                                <div class="row g-2">
                                    {% for page in pages|slice(0, 60) %}
                                        {% set src = page.url %}
                                        {% set thumb = src %}
                                        {% guard filter imgproxy %}
                                            {% set thumb = src|imgproxy('thumb') %}
                                        {% endguard %}

                                        <div class="col-4 col-md-3 col-lg-2">
                                            <a href="#" class="js-osd-page" data-page-index="{{ loop.index0 }}" title="p. {{ page.seq }}">
                                                <img
                                                    src="{{ thumb }}"
                                                    alt="p. {{ page.seq }}"
                                                    class="img-fluid rounded border"
                                                    style="aspect-ratio: 1; object-fit: cover"
                                                    loading="lazy"
                                                >
                                            </a>
                                        </div>
                                    {% endfor %}
                                </div>

                                {% if pages|length > 60 %}
                                    <div class="text-muted small mt-2">
                                        Showing first 60 of {{ pages|length }} pages.
                                    </div>
                                {% endif %}
                            </div>
                        </div>
                    {% endif %}

                    {# Title the data card with the (translatable) DTO class name, e.g. "Artifact",
                       not the developer phrase "DTO Data". dto.<Name> lives in the 'system' domain
                       (built by trans:system); fall back to the bare short name. #}
                    {% set dtoLabel = dtoClass ? dtoClass|split('\\')|last|replace({'Dto': ''}) : (row.dtoType ?: 'Record') %}
                    {% set dtoKey = 'dto.' ~ dtoLabel %}
                    {% set dtoTrans = dtoKey|trans({}, 'system') %}
                    <div class="card">
                        <div class="card-header">
                            <h2 class="card-title mb-0">{{ dtoTrans == dtoKey ? dtoLabel : dtoTrans }}</h2>
                        </div>

                        {% set imageFields = ['thumbnailUrl', 'largeImageUrl', 'iiifBase', 'iiifManifest', 'iiifInfo', 'imageCount', 'hasImages', 'sourceUrl'] %}
                        <div class="table-responsive">
                            <table class="table table-vcenter card-table">
                                <tbody>
                                    {% for field in columns %}
                                        {% set value = attribute(row.dtoData, field)|default(null) %}
                                        {% if value is not empty and field not in termFields and field not in imageFields and field not in promotedFields %}
                                            <tr>
                                                <th class="w-25 font-monospace text-muted d-none d-md-table-cell">
                                                    {{ field }}
                                                </th>
                                                <td>
                                                    <div class="d-md-none mb-1">
                                                        <span class="font-monospace text-muted small">{{ field }}</span>
                                                    </div>
                                                    {% if field == 'aiTasks' and value is iterable %}
                                                        <div class="d-flex flex-wrap gap-1">
                                                            {% for task in value %}
                                                                {% set runId = aiTaskRuns[task] ?? null %}
                                                                {% if runId %}
                                                                    <a class="badge text-bg-primary text-decoration-none" href="{{ path('survos_folio_run', {provider: provider, dataset: dataset, runId: runId}) }}" title="Open AI task run details">{{ task }}</a>
                                                                {% else %}
                                                                    <span class="badge text-bg-light border">{{ task }}</span>
                                                                {% endif %}
                                                            {% endfor %}
                                                        </div>
                                                    {% else %}
                                                        <div class="text-break">
                                                            {{ folio_row.render_value(value) }}
                                                        </div>
                                                    {% endif %}
                                                </td>
                                            </tr>
                                        {% endif %}
                                    {% else %}
                                        {% for field, value in row.dtoData %}
                                            {% if field not in termFields and field not in imageFields and field not in promotedFields %}
                                                <tr>
                                                    <th class="w-25 font-monospace text-muted">{{ field }}</th>
                                                    <td>
                                                        {% if field == 'aiTasks' and value is iterable %}
                                                            <div class="d-flex flex-wrap gap-1">
                                                                {% for task in value %}
                                                                    {% set runId = aiTaskRuns[task] ?? null %}
                                                                    {% if runId %}
                                                                        <a class="badge text-bg-primary text-decoration-none" href="{{ path('survos_folio_run', {provider: provider, dataset: dataset, runId: runId}) }}" title="Open AI task run details">{{ task }}</a>
                                                                    {% else %}
                                                                        <span class="badge text-bg-light border">{{ task }}</span>
                                                                    {% endif %}
                                                                {% endfor %}
                                                            </div>
                                                        {% else %}
                                                            {{ folio_row.render_value(value) }}
                                                        {% endif %}
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% else %}
                                            <tr>
                                                <td class="text-muted">No DTO data captured.</td>
                                            </tr>
                                        {% endfor %}
                                    {% endfor %}
                                </tbody>
                            </table>
                        </div>

                        {% set imageMetaFields = imageFields|filter(field => attribute(row.dtoData, field)|default(null) is not empty) %}

                        {% if imageMetaFields is not empty %}
                            <details class="px-3 pb-3">
                                <summary class="text-muted small" style="cursor: pointer">
                                    Source image fields ({{ imageMetaFields|length }})
                                </summary>

                                <table class="table table-sm card-table mt-2 mb-0">
                                    <tbody>
                                        {% for field in imageMetaFields %}
                                            <tr>
                                                <th class="w-25 font-monospace text-muted small">{{ field }}</th>
                                                <td class="small text-break">
                                                    {{ folio_row.render_value(attribute(row.dtoData, field)) }}
                                                </td>
                                            </tr>
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </details>
                        {% endif %}
                    </div>

                    {% if claims|default([]) is not empty %}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h2 class="card-title mb-0">Claims <span class="text-muted">({{ claims|length }})</span></h2>
                            </div>

                            <div class="table-responsive">
                                <table class="table table-vcenter card-table">
                                    <tbody>
                                        {# Multi-valued predicates (dcterms:subject above all -- a photo can assert a
                                           dozen of these) would otherwise repeat their own name once per value. Claims
                                           are ordered by (source, predicate) -- not predicate alone -- so the same
                                           predicate can appear in more than one place if multiple sources assert it;
                                           a real group-by (not just a consecutive/adjacent check) handles that
                                           correctly. Twig has no built-in group-by filter yet, hence the manual
                                           seen-predicates check -- revisit if a future Twig version adds one. #}
                                        {% set seenPredicates = [] %}
                                        {% for claim in claims %}
                                            {% if claim.predicate not in seenPredicates %}
                                                {% set seenPredicates = seenPredicates|merge([claim.predicate]) %}
                                                <tr>
                                                    <th class="w-25 align-top font-monospace text-muted">
                                                        {{ claim.predicate }}
                                                    </th>
                                                    <td>
                                                        {% for c in claims|filter(c => c.predicate == claim.predicate) %}
                                                            <div style="white-space: pre-wrap; word-break: break-word;">{{ c.value }}</div>
                                                            <div class="text-muted small {{ loop.last ? 'mt-1' : 'mb-2 pb-2 border-bottom' }}">
                                                                <span class="badge text-bg-light border">{{ c.source }}</span>
                                                                {% if c.confidence is not null %}
                                                                    <span title="confidence">{{ (c.confidence * 100)|round }}%</span>
                                                                {% endif %}
                                                                {% if c.agent %}
                                                                    <span class="mx-1">&middot;</span><span class="font-monospace">{{ c.agent }}</span>
                                                                {% endif %}
                                                            </div>
                                                        {% endfor %}
                                                    </td>
                                                </tr>
                                            {% endif %}
                                        {% endfor %}
                                    </tbody>
                                </table>
                            </div>
                        </div>
                    {% endif %}
                </div>

                <div class="col-lg-4" id="doc-side-col">
                    {% if (hasOcr or hasLayout or hasHtr) and not isSingleImage %}
                        <div class="card mb-3" id="doc-ocr-card">
                            <div class="card-header d-flex align-items-center gap-2">
                                <h2 class="card-title mb-0">Extracted text</h2>
                                {# Badge: Handwriting (htr_annotate) > Layout (Mistral blocks) > OCR (flat). JS keeps it per-page. #}
                                <span id="doc-ocr-badge" class="badge {{ hasHtr ? 'bg-green-lt' : (hasLayout ? 'bg-purple-lt' : 'bg-blue-lt') }}">{{ hasHtr ? 'Handwriting' : (hasLayout ? 'Layout' : 'OCR') }}</span>
                                <span class="ms-auto d-inline-flex align-items-center gap-1">
                                    {% if pages|length > 1 %}
                                        <button type="button"
                                                class="btn btn-action rounded-pill border-0 js-folio-page-prev js-ocr-page-prev"
                                                style="min-width: 1.25rem; min-height: 1rem;"
                                                data-page-count="{{ pages|length }}"
                                                aria-label="Previous page"
                                                title="Previous page"
                                                disabled>
                                            {{ ux_icon('tabler:chevron-left', { class: 'icon' }) }}
                                        </button>
                                    {% endif %}
                                    <span id="doc-ocr-page" class="text-muted small">Page 1 of {{ pages|length }}</span>
                                    {% if pages|length > 1 %}
                                        <button type="button"
                                                class="btn btn-action rounded-pill border-0 js-folio-page-next js-ocr-page-next"
                                                style="min-width: 1.25rem; min-height: 1rem;"
                                                data-page-count="{{ pages|length }}"
                                                aria-label="Next page"
                                                title="Next page">
                                            {{ ux_icon('tabler:chevron-right', { class: 'icon' }) }}
                                        </button>
                                    {% endif %}
                                </span>
                            </div>
                            <div class="card-body">
                                <div id="doc-ocr-text"
                                     data-page-texts="{{ pageTexts|json_encode|e('html_attr') }}"
                                     data-page-layouts="{{ pageLayouts|json_encode|e('html_attr') }}"
                                     data-page-htr="{{ pageHtr|json_encode|e('html_attr') }}"
                                     style="white-space: pre-wrap; word-break: break-word; max-height: 600px; overflow-y: auto; font-size: 0.875rem; line-height: 1.45;">{{ pageTexts|first|trim ?: '(no extracted text for this page)' }}</div>
                            </div>
                        </div>
                    {% endif %}

                    {% if observationProse %}
                        <div class="card mb-3">
                            <div class="card-header d-flex align-items-center gap-2">
                                <h2 class="card-title mb-0">What's in the picture</h2>
                                <span class="badge bg-purple-lt">AI observation</span>
                            </div>
                            <div class="card-body"
                                 data-controller="read-more"
                                 data-read-more-more-text-value="Read more"
                                 data-read-more-less-text-value="Read less">
                                {# Long visual observation — clamp to a few lines and let read-more expand it. #}
                                <div class="folio-ai-prose folio-readmore" style="word-break: break-word;" data-read-more-target="content">{{ observationProse|markdown }}</div>
                                <button type="button" class="btn btn-link btn-sm p-0 mt-1" data-action="read-more#toggle">Read more</button>
                            </div>
                        </div>
                    {% endif %}

                    {% if sourceCaption %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">Source caption</h2>
                            </div>

                            <div class="card-body">
                                {# Verbatim source caption only. flush + trim: with pre-wrap, template indentation
                                   would otherwise render as literal whitespace. #}
                                <div style="max-height: 240px; overflow-y: auto; white-space: pre-wrap; word-break: break-word;">{{ sourceCaption|trim }}</div>
                            </div>
                        </div>
                    {% endif %}

                    {% if hasUxMap and tombstoneIsPreciseLocation %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">Location</h2>
                            </div>

                            <div class="card-body p-0">
                                {# City/country-level fallbacks (geoPrecision set) are deliberately excluded here --
                                   a centroid pin reads as "the photo was taken exactly here", which is misleading
                                   at that resolution. Only rows with real per-photo GPS get a mini-map. #}
                                {{ ux_map(
                                    center: [tombstoneLatitude, tombstoneLongitude],
                                    zoom: 15,
                                    markers: [{ position: [tombstoneLatitude, tombstoneLongitude] }],
                                    attributes: { style: 'height: 220px; width: 100%;' }
                                ) }}
                            </div>
                        </div>
                    {% endif %}

                    {% if ocrText %}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h2 class="card-title mb-0">Transcription</h2>

                                {% if pageCount %}
                                    <span class="text-muted small">{{ pageCount }} pages</span>
                                {% endif %}
                            </div>

                            <div class="card-body">
                                <div style="max-height: 480px; overflow-y: auto; white-space: pre-wrap; word-break: break-word;">{{ ocrText|trim }}</div>
                            </div>
                        </div>
                    {% endif %}

                    {% if terms %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">Terms</h2>
                            </div>

                            <div class="list-group list-group-flush">
                                {% for set, values in terms %}
                                    <div class="list-group-item bg-transparent">
                                        <div class="text-muted small text-uppercase">{{ ux_icon(set, {class: 'icon me-1'}) }}{{ ('term.' ~ set)|trans }}</div>

                                        {% for value in values %}
                                            {% if value.term %}
                                                <a
                                                    class="badge text-bg-light border me-1 text-decoration-none"
                                                    href="{{ path('survos_folio_term_show', {
                                                        provider: provider,
                                                        dataset: dataset,
                                                        setCode: set,
                                                        termCode: value.code
                                                    }) }}"
                                                >
                                                    {{ value.label }}
                                                </a>
                                            {% else %}
                                                <span class="badge text-bg-light border me-1">
                                                    {{ value.label }}
                                                </span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% set otherLinks = links|default([])|filter(l => l.core != 'image') %}

                    {% if otherLinks %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">Relations</h2>
                            </div>

                            <div class="list-group list-group-flush">
                                {% for link in otherLinks %}
                                    {% set target = link.row %}

                                    <div class="list-group-item bg-transparent">
                                        <div class="text-muted small font-monospace">{{ link.code }}</div>

                                        <div>
                                            {{ ux_icon(link.core, {class: 'icon me-1'}) }}{# predicate shown once above; here show the linked record #}
                                            {% if target %}
                                                <a href="{{ path('survos_folio_row_show', {
                                                    provider: provider,
                                                    dataset: dataset,
                                                    coreCode: link.core,
                                                    dtoType: target.dtoType ?: 'row',
                                                    localId: target.localId
                                                }) }}">
                                                    {{ target.label ?: target.localId }}
                                                </a>
                                            {% else %}
                                                <span class="font-monospace">
                                                    {{ link.core }}/{{ link.localId }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# Extras is the raw unmapped blob — developer noise. Show only in debug; hidden in production. #}
                    {% if extras and app.debug %}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h2 class="card-title mb-0">Extras <span class="badge bg-secondary-lt ms-1">dev</span></h2>

                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    onclick="navigator.clipboard.writeText(this.closest('.card').querySelector('pre').innerText).then(() => { const t = this.innerText; this.innerText = 'Copied!'; setTimeout(() => this.innerText = t, 1200); })"
                                >
                                    Copy
                                </button>
                            </div>

                            <div class="card-body">
                                <pre class="mb-0" style="white-space: pre-wrap; word-break: break-word; user-select: all;">{{ extras|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                            </div>
                        </div>
                    {% endif %}
                </div>
            </div>

            {% set firstPage = pages|first %}
            {% if firstPage and firstPage.url %}
                {% set aspectProbe = firstPage.url %}
                {% guard filter imgproxy %}{% set aspectProbe = aspectProbe|imgproxy('thumb') %}{% endguard %}
                <script>
                    (function () {
                        var probe = {{ aspectProbe|json_encode|raw }};
                        var img = new Image();
                        img.onload = function () {
                            if (img.naturalWidth && img.naturalHeight > img.naturalWidth * 1.15) {
                                var main = document.getElementById('doc-main-col');
                                var side = document.getElementById('doc-side-col');
                                if (main) {
                                    main.dataset.folioSplitClass = 'col-lg-6';
                                    main.classList.replace('col-lg-8', 'col-lg-6');
                                }
                                if (side) {
                                    side.dataset.folioSplitClass = 'col-lg-6';
                                    side.classList.replace('col-lg-4', 'col-lg-6');
                                }
                            }
                        };
                        img.src = probe;
                    })();
                </script>
            {% endif %}

            <script>
                function updateFolioAiLink(pageIndex) {
                    const link = document.getElementById('folio-ai-page-link');

                    if (!link) {
                        return;
                    }

                    let images = [];

                    try {
                        images = JSON.parse(link.dataset.aiImages || '[]');
                    } catch (e) {
                        images = [];
                    }

                    const index = Number(pageIndex);
                    const imageUrl = Number.isInteger(index) ? images[index] : null;
                    const template = link.dataset.aiUrlTemplate || '';

                    if (!imageUrl || !template) {
                        return;
                    }

                    link.href = template.replace('__URL__', encodeURIComponent(imageUrl));
                }

                function getPageFromUrl() {
                    const params = new URLSearchParams(window.location.search);
                    const page = Number(params.get('page'));

                    // URL is human-friendly: ?page=1 means first page
                    if (!Number.isInteger(page) || page < 1) {
                        return 0;
                    }

                    return page - 1;
                }

                function setPageInUrl(pageIndex) {
                    const url = new URL(window.location.href);
                    url.searchParams.set('page', pageIndex + 1);
                    window.history.replaceState({}, '', url);
                }

                function setActiveThumb(pageIndex) {
                    document.querySelectorAll('.js-osd-page img').forEach((img) => {
                        img.classList.remove('border-primary');
                    });

                    const activeThumb = document.querySelector(`.js-osd-page[data-page-index="${pageIndex}"] img`);

                    if (activeThumb) {
                        activeThumb.classList.add('border-primary');
                    }
                }

                function updateFolioPageNavButtons(pageIndex, total = 0) {
                    const previousButtons = document.querySelectorAll('.js-folio-page-prev');
                    const nextButtons = document.querySelectorAll('.js-folio-page-next');
                    const pageCount = Number(previousButtons[0]?.dataset.pageCount || nextButtons[0]?.dataset.pageCount || total || 0);

                    previousButtons.forEach((previousButton) => {
                        previousButton.disabled = pageIndex <= 0;
                    });

                    nextButtons.forEach((nextButton) => {
                        nextButton.disabled = !pageCount || pageIndex >= pageCount - 1;
                    });
                }

                function setColumnClass(element, columnClass) {
                    if (!element || !columnClass) {
                        return;
                    }

                    ['col-lg-4', 'col-lg-6', 'col-lg-8', 'col-lg-12'].forEach((className) => {
                        element.classList.remove(className);
                    });

                    element.classList.add(columnClass);
                }

                function resizeFolioViewer() {
                    const viewerEl = document.querySelector(
                        '[data-controller="survos--iiif-bundle--iiif-viewer"]'
                    );

                    if (viewerEl && viewerEl.viewer && typeof viewerEl.viewer.forceRedraw === 'function') {
                        viewerEl.viewer.forceRedraw();
                    }

                    window.dispatchEvent(new Event('resize'));
                }

                function applyFolioViewerMode(mode) {
                    const grid = document.getElementById('folio-viewer-grid');
                    const main = document.getElementById('doc-main-col');
                    const side = document.getElementById('doc-side-col');
                    const textCard = document.getElementById('doc-ocr-card');

                    if (!grid || !main || !side || !textCard) {
                        return;
                    }

                    const normalizedMode = ['osd', 'side-by-side', 'text'].includes(mode) ? mode : 'side-by-side';
                    const splitMainClass = main.dataset.folioSplitClass || 'col-lg-8';
                    const splitSideClass = side.dataset.folioSplitClass || 'col-lg-4';

                    grid.dataset.viewerMode = normalizedMode;

                    main.classList.remove('d-none');
                    side.classList.remove('d-none');

                    if (normalizedMode === 'osd') {
                        setColumnClass(main, 'col-lg-12');
                        side.classList.add('d-none');
                    } else if (normalizedMode === 'text') {
                        main.classList.add('d-none');
                        setColumnClass(side, 'col-lg-12');
                    } else {
                        setColumnClass(main, splitMainClass);
                        setColumnClass(side, splitSideClass);
                    }

                    document.querySelectorAll('.js-folio-view-mode').forEach((input) => {
                        input.checked = input.value === normalizedMode;
                    });

                    setTimeout(resizeFolioViewer, 80);
                }

                function initFolioViewerModeControl() {
                    const controls = document.querySelectorAll('.js-folio-view-mode');

                    if (!controls.length) {
                        return;
                    }

                    controls.forEach((control) => {
                        control.onchange = () => applyFolioViewerMode(control.value);
                    });

                    applyFolioViewerMode('side-by-side');
                }

                function initFolioDetailViewerControls() {
                    const viewerEl = document.querySelector(
                        '[data-controller="survos--iiif-bundle--iiif-viewer"]'
                    );

                    if (!viewerEl) {
                        return;
                    }

                    const initialPageIndex = getPageFromUrl();
                    const previousButtons = document.querySelectorAll('.js-folio-page-prev');
                    const nextButtons = document.querySelectorAll('.js-folio-page-next');
                    const pageCount = Number(previousButtons[0]?.dataset.pageCount || nextButtons[0]?.dataset.pageCount || 0);

                    const goToPage = (pageIndex, updateUrl = true) => {
                        if (!viewerEl.viewer || !Number.isInteger(pageIndex)) {
                            return;
                        }

                        if (pageCount && (pageIndex < 0 || pageIndex >= pageCount)) {
                            return;
                        }

                        viewerEl.viewer.goToPage(pageIndex);
                        updateFolioAiLink(pageIndex);
                        setActiveThumb(pageIndex);
                        updateFolioPageNavButtons(pageIndex, pageCount);

                        if (updateUrl) {
                            setPageInUrl(pageIndex);
                        }
                    };

                    document.querySelectorAll('.js-osd-page').forEach((thumb) => {
                        thumb.onclick = (event) => {
                            event.preventDefault();

                            const pageIndex = Number(thumb.dataset.pageIndex);
                            goToPage(pageIndex);
                        };
                    });

                    previousButtons.forEach((previousButton) => {
                        previousButton.onclick = () => {
                            goToPage(getPageFromUrl() - 1);
                        };
                    });

                    nextButtons.forEach((nextButton) => {
                        nextButton.onclick = () => {
                            goToPage(getPageFromUrl() + 1);
                        };
                    });

                    // Wait a tick so the IIIF viewer has time to initialize.
                    setTimeout(() => {
                        goToPage(initialPageIndex, false);
                    }, 100);
                }

                document.addEventListener('iiif-viewer:page', (e) => {
                    updateFolioAiLink(e.detail.index);
                    setActiveThumb(e.detail.index);
                    setPageInUrl(e.detail.index);
                    updateFolioPageNavButtons(e.detail.index, e.detail.total);
                });

                document.addEventListener('turbo:load', initFolioViewerModeControl);
                document.addEventListener('DOMContentLoaded', initFolioViewerModeControl);
                document.addEventListener('turbo:load', initFolioDetailViewerControls);
                document.addEventListener('DOMContentLoaded', initFolioDetailViewerControls);
            </script>

            <style>
                /* read-more (@stimulus-components/read-more): clamp to a few lines until expanded. The
                   controller flips --read-more-line-clamp to remove the clamp on toggle. */
                .folio-readmore {
                    display: -webkit-box;
                    -webkit-box-orient: vertical;
                    -webkit-line-clamp: var(--read-more-line-clamp, 6);
                    overflow: hidden;
                }

                .page {
                    background:
                        radial-gradient(circle at top left, rgba(255, 238, 198, .9), transparent 34%),
                        radial-gradient(circle at top right, rgba(232, 218, 255, .9), transparent 32%),
                        linear-gradient(135deg, #fff8e8 0%, #fff 46%, #f5f0e8 100%);
                }

                /* Do NOT hide the host app's navbar here. The detail page inherits the
                   calling application's chrome (folio_base_template()) by contract; the
                   designer's immersive mockup hid it (.navbar{display:none}, 9c52db36) and
                   every host app silently lost its header until zm noticed (2026-07-17). */

                .folio-detail-shell {
                    max-width: 1320px;
                    margin: 0 auto;
                    padding: 1.5rem;
                    border-radius: 1.5rem;
                    background: rgba(255, 255, 255, .62);
                    border: 1px solid rgba(120, 100, 70, .14);
                    box-shadow: 0 24px 70px rgba(33, 37, 41, .08);
                    backdrop-filter: blur(18px);
                }

                .folio-detail-hero {
                    padding: 1.75rem;
                    margin-bottom: 1.5rem;
                    border-radius: 1.25rem;
                    background:
                        radial-gradient(circle at top left, rgba(255,244,220,.85), transparent 34%),
                        radial-gradient(circle at top right, rgba(235,222,255,.75), transparent 32%),
                        rgba(255,255,255,.72);
                    border: 1px solid rgba(120,100,70,.12);
                }

                .folio-detail-title,
                .folio-detail-section-title,
                .folio-detail-shell .card-title {
                    font-family: Georgia, serif;
                    letter-spacing: -.025em;
                    color: #283142;
                }

                .folio-detail-title {
                    font-size: clamp(2rem, 4vw, 3.35rem);
                    line-height: 1.05;
                    letter-spacing: -.04em;
                }

                .folio-detail-shell .card {
                    background: rgba(255,255,255,.72);
                    border: 1px solid rgba(120,100,70,.12);
                    border-radius: 1.25rem;
                    box-shadow: 0 12px 34px rgba(33,37,41,.055);
                    backdrop-filter: blur(14px);
                    overflow: hidden;
                }

                .folio-detail-shell .card-header {
                    background: transparent;
                    border-bottom-color: rgba(120,100,70,.10);
                }

                #doc-viewer {

                }

                .folio-detail-shell pre {
                    background: #111827;
                    color: #fff;
                    border-radius: 1rem;
                    padding: 1rem;
                }

                .folio-section-icon {
                    width: 2.75rem;
                    height: 2.75rem;
                    display: flex;
                    align-items: center;
                    justify-content: center;
                    flex-shrink: 0;
                    border-radius: 999px;
                    background: radial-gradient(circle at top left, rgba(255,244,220,.9), rgba(255,255,255,.95));
                    border: 1px solid rgba(120,100,70,.12);
                    color: #6b4f1d;
                }

                .folio-section-icon svg {
                    width: 1.25rem;
                    height: 1.25rem;
                }

                .folio-detail-shell {
                    max-width: none;
                    padding: 0;
                    border-radius: 0;
                    background: none;
                    border: none;
                    box-shadow: none;
                    backdrop-filter: none;
                }

                .folio-viewer-toolbar-card .card-header {
                    min-height: 4rem;
                }

                .folio-view-mode-control {
                    display: flex;
                    gap: 0.25rem;
                    padding: .25rem;
                    border: 1px solid rgba(120, 100, 70, .14);
                    border-radius: .75rem;
                    background: rgba(255, 255, 255, .78);
                    box-shadow: 0 .5rem 1.5rem rgba(33, 37, 41, .045);
                }

                .folio-view-mode-control .btn {
                    border: 0;
                    border-radius: .55rem !important;
                    color: #4b5563;
                    font-weight: 600;
                    box-shadow: none !important;
                }

                .folio-view-mode-control .btn-check:checked + .btn {
                    color: #5b21b6;
                    background: rgba(124, 58, 237, .10);
                    box-shadow: inset 0 0 0 1px rgba(124, 58, 237, .24) !important;
                }

                .folio-viewer-grid[data-viewer-mode="osd"] #doc-viewer,
                .folio-viewer-grid[data-viewer-mode="text"] #doc-ocr-card {
                    min-height: 680px;
                }

                .folio-viewer-grid[data-viewer-mode="text"] #doc-ocr-text {
                    max-height: 70vh !important;
                }

                @media (max-width: 767.98px) {
                    .folio-view-mode-control {
                        width: 100%;
                        overflow-x: auto;
                    }

                    .folio-view-mode-control .btn {
                        flex: 1 0 auto;
                        white-space: nowrap;
                    }
                }

                .page-header {
                    display: none;
                }
            </style>
        </div>
    </div>
{% endblock %}

{% block folio_detail_actions %}
    {% if folio_bookmarks_enabled() %}
        {{ include('@SurvosFolioBundle/bookmark/_widget.html.twig', {
            provider: provider,
            dataset: dataset,
            coreCode: core.code,
            localId: row.localId,
            dtoType: row.dtoType ?: 'row',
            label: tombstoneTitle,
        }) }}
    {% endif %}

    {% if pageAiUrls|length > 0 or th %}
        <a href="{{ path('survos_folio_item_chat', {provider: provider, dataset: dataset, coreCode: core.code, dtoType: row.dtoType ?: 'row', localId: row.localId}) }}"
           data-turbo="false"
           class="btn text-white border-0 shadow-sm rounded-pill px-4"
           style="background: linear-gradient(135deg, #2b0b4f, #5b2aa0);">
            {{ ux_icon('tabler:sparkles', { class: 'icon me-1' }) }}
            Ask document
        </a>

        {% if pages|length > 1 and pageAskUrls is not empty %}
            <a href="{{ pageAskUrls|first }}"
               id="doc-page-scholar-link"
               data-turbo="false"
               data-page-chat-urls="{{ pageAskUrls|json_encode|e('html_attr') }}"
               class="btn bg-white bg-opacity-75 border shadow-sm rounded-pill">
                {{ ux_icon('tabler:message-chatbot', { class: 'icon me-1' }) }}
                Ask page
            </a>
        {% endif %}

        {# OCR / Handwriting run a mediary AI task against THIS row's current
           page (folio identifiers, not a bare url) via survos_folio_ai, which
           persists the result onto the right Page. hrefs follow the viewer's
           page (see the iiif-viewer:page listener below). #}
        {% if pages|length > 0 %}
            {% set aiBase = path('survos_folio_ai', {provider: provider, dataset: dataset, coreCode: core.code, localId: row.localId}) %}
            <a class="btn bg-white bg-opacity-75 border shadow-sm rounded-pill js-folio-ai-btn"
               data-ai-base="{{ aiBase }}" data-ai-task="ocr_mistral"
               href="{{ path('survos_folio_ai', {provider: provider, dataset: dataset, coreCode: core.code, localId: row.localId, task: 'ocr_mistral', run: 1, page: 0}) }}">
                {{ ux_icon('tabler:file-text', { class: 'icon me-1' }) }}
                OCR
            </a>
            <a class="btn bg-white bg-opacity-75 border shadow-sm rounded-pill js-folio-ai-btn"
               data-ai-base="{{ aiBase }}" data-ai-task="handwriting"
               href="{{ path('survos_folio_ai', {provider: provider, dataset: dataset, coreCode: core.code, localId: row.localId, task: 'handwriting', run: 1, page: 0}) }}">
                {{ ux_icon('tabler:writing', { class: 'icon me-1' }) }}
                Handwriting
            </a>
        {% endif %}
    {% endif %}
{% endblock %}
