{% extends app.request.attributes.get('_layout')|default(folio_base_template()) %}

{# Same reasoning as map.html.twig: the page-header banner predates the navbar and just
   repeats what it already shows, while pushing the grid itself further down the page. #}
{% set _ = page({ showPageHeader: false }) %}

{% block body_class %}folio-layout{% endblock %}

{% block title %}Gallery · {{ provider }}/{{ dataset }}{% endblock %}

{% block body %}
    <div class="container-xl py-4">
        <twig:folio:photo-grid
            provider="{{ provider }}"
            dataset="{{ dataset }}"
            coreCode="{{ coreCode }}"
        />
    </div>
{% endblock %}
