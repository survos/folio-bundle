{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}
{% import _self as folio_row %}

{% macro render_value(value) %}
    {% if value is iterable %}
        <pre class="mb-0">{{ value|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
    {% elseif value is url %}
        {{ value|urlize }}
    {% else %}
        {{ value }}
    {% endif %}
{% endmacro %}

{% block body %}
{% set parts = ctx.folioCode|split('/') %}
{% set th = row.thumbnailSource %}
{% set termFields = terms ? ['genreSpecific', 'tec', 'mat', 'coll'] : [] %}

<div class="container-xl py-3">
    <div class="page-header mb-3">
        <div class="row align-items-center">
            <div class="col">
                <h1 class="page-title">
                    <a href="{{ path('survos_folio_show', {provider: parts[0], dataset: parts[1]}) }}" class="text-muted">{{ ctx.folioCode }}</a>
                    <span class="text-muted mx-1">/</span>
                    <a href="{{ path('survos_folio_core', {provider: parts[0], dataset: parts[1], coreCode: core.code}) }}" class="text-muted">{{ core.code }}</a>
                    {% if row.dtoType %}
                        <span class="text-muted mx-1">/</span>
                        <a href="{{ path('survos_folio_core_dto', {provider: parts[0], dataset: parts[1], coreCode: core.code, dtoType: row.dtoType}) }}" class="text-muted">{{ row.dtoType }}</a>
                    {% endif %}
                    <span class="text-muted mx-1">/</span>{{ row.localId }}
                </h1>
                <div class="text-muted">{{ row.label ?: row.localId }}</div>
            </div>
        </div>
    </div>

    <div class="row row-cards">
        <div class="col-lg-8">
            <div class="card">
                <div class="card-header">
                    <h2 class="card-title mb-0">DTO Data</h2>
                </div>
                {# Source image URLs are noise once the folio serves its own imgproxy/IIIF renditions. #}
                {% set imageFields = ['thumbnailUrl', 'largeImageUrl', 'iiifBase', 'iiifManifest', 'iiifInfo', 'imageCount', 'hasImages', 'sourceUrl'] %}
                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <tbody>
                        {% for field in columns %}
                            {% set value = attribute(row.dtoData, field)|default(null) %}
                            {% if value is not empty and field not in termFields and field not in imageFields %}
                                <tr>
                                    <th class="w-25 font-monospace text-muted">{{ field }}</th>
                                    <td>
                                        {{ folio_row.render_value(value) }}
                                    </td>
                                </tr>
                            {% endif %}
                        {% else %}
                            {% for field, value in row.dtoData %}
                                {% if field not in termFields and field not in imageFields %}
                                <tr>
                                    <th class="w-25 font-monospace text-muted">{{ field }}</th>
                                    <td>
                                        {{ folio_row.render_value(value) }}
                                    </td>
                                </tr>
                                {% endif %}
                            {% else %}
                                <tr>
                                    <td class="text-muted">No DTO data captured.</td>
                                </tr>
                            {% endfor %}
                        {% endfor %}
                        </tbody>
                    </table>
                </div>
                {% set imageMetaFields = imageFields|filter(field => attribute(row.dtoData, field)|default(null) is not empty) %}
                {% if imageMetaFields is not empty %}
                    <details class="px-3 pb-3">
                        <summary class="text-muted small" style="cursor: pointer">Source image fields ({{ imageMetaFields|length }})</summary>
                        <table class="table table-sm card-table mt-2 mb-0">
                            <tbody>
                            {% for field in imageMetaFields %}
                                <tr>
                                    <th class="w-25 font-monospace text-muted small">{{ field }}</th>
                                    <td class="small text-break">{{ folio_row.render_value(attribute(row.dtoData, field)) }}</td>
                                </tr>
                            {% endfor %}
                            </tbody>
                        </table>
                    </details>
                {% endif %}
            </div>
        </div>
        <div class="col-lg-4">
            {% if th %}
                <div class="card mb-3">
                    <div class="card-body text-center">
                        {% set imageUrl = th %}
                        {% guard filter imgproxy %}
                            {% set imageUrl = th|imgproxy('display') %}
                        {% endguard %}
                        <a href="{{ th }}" target="_blank">
                            <img src="{{ imageUrl }}" alt="{{ row.label ?: row.localId }}" class="img-fluid rounded" style="max-height: 360px; object-fit: contain" loading="lazy">
                        </a>
                    </div>
                </div>
            {% endif %}

            {% guard function dim_render %}
                {% set dimsArr   = attribute(row.dtoData, 'dimensions') %}
                {% set weightArr = attribute(row.dtoData, 'weight') %}
                {% set dimsRaw   = attribute(row.dtoData, 'dimensionsRaw') %}
                {% if dimsArr or weightArr or dimsRaw %}
                    <div class="card mb-3">
                        <div class="card-header">
                            <h2 class="card-title mb-0">Dimensions</h2>
                        </div>
                        <div class="card-body">
                            {{ dim_render(dimsArr, weightArr, dimsRaw) }}
                        </div>
                    </div>
                {% endif %}
            {% endguard %}

            <div class="card mb-3">
                <div class="card-header">
                    <h2 class="card-title mb-0">Row</h2>
                </div>
                <div class="card-body">
                    <dl class="mb-0">
                        <dt>ID</dt>
                        <dd class="font-monospace">{{ row.localId }}</dd>
                        <dt>Type</dt>
                        <dd>{{ row.dtoType ?: '(none)' }}</dd>
                        <dt>DTO Class</dt>
                        <dd class="font-monospace small">{{ dtoClass ?: '(generic)' }}</dd>
                        {% if row.citationUrl %}
                            <dt>Original</dt>
                            <dd><a href="{{ row.citationUrl }}" target="_blank" rel="noopener">Citation record</a></dd>
                        {% endif %}
                    </dl>
                </div>
            </div>

            {% if terms %}
                <div class="card mb-3">
                    <div class="card-header">
                        <h2 class="card-title mb-0">Terms</h2>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for set, values in terms %}
                            <div class="list-group-item">
                                <div class="text-muted small text-uppercase">{{ set }}</div>
                                {% for value in values %}
                                    {% if value.term %}
                                        <a class="badge text-bg-light border me-1 text-decoration-none" href="{{ path('survos_folio_term_show', {provider: parts[0], dataset: parts[1], setCode: set, termCode: value.code}) }}">{{ value.label }}</a>
                                    {% else %}
                                        <span class="badge text-bg-light border me-1">{{ value.label }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if links %}
                <div class="card mb-3">
                    <div class="card-header">
                        <h2 class="card-title mb-0">Relations</h2>
                    </div>
                    <div class="list-group list-group-flush">
                        {% for link in links %}
                            {% set target = link.row %}
                            <div class="list-group-item">
                                <div class="text-muted small font-monospace">{{ link.code }}</div>
                                <div>
                                    <span>{{ link.label ?: link.code }}</span>
                                    {% if target %}
                                        <a href="{{ path('survos_folio_row_show', {provider: parts[0], dataset: parts[1], coreCode: link.core, dtoType: target.dtoType ?: 'row', localId: target.localId}) }}">
                                            {{ target.label ?: target.localId }}
                                        </a>
                                    {% else %}
                                        <span class="font-monospace">{{ link.core }}/{{ link.localId }}</span>
                                    {% endif %}
                                </div>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            {% endif %}

            {% if extras %}
                <div class="card mb-3">
                    <div class="card-header d-flex justify-content-between align-items-center">
                        <h2 class="card-title mb-0">Extras</h2>
                        <button type="button" class="btn btn-sm btn-outline-secondary"
                                onclick="navigator.clipboard.writeText(this.closest('.card').querySelector('pre').innerText).then(() => { const t = this.innerText; this.innerText = 'Copied!'; setTimeout(() => this.innerText = t, 1200); })">
                            Copy
                        </button>
                    </div>
                    <div class="card-body">
                        <pre class="mb-0" style="white-space: pre-wrap; word-break: break-word; user-select: all;">{{ extras|json_encode(constant('JSON_PRETTY_PRINT')) }}</pre>
                    </div>
                </div>
            {% endif %}
        </div>
    </div>
</div>
{% endblock %}
