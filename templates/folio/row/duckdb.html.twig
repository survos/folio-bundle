{# Shared folio title, attribution, dates, dimensions and source links; read-only DuckDB body. #}
{% extends '@SurvosFolioBundle/folio/row/show.html.twig' %}
{% block page_subtitle %}{% if tombstoneYear %}<span class="text-secondary small">{{ tombstoneYear }}</span>{% endif %}{% endblock %}
{% block body %}
{% if row.pages|filter(p => p.text or p.layout or p.htr)|length %}
    {{ parent() }}
{% else %}
<div class="container-xl pt-1 pb-4" {{ stimulus_controller(survos_stimulus('folio-bundle', 'json-viewer')) }}>
    <div id="duck-item-json" popover class="folio-raw-json">
        <andypf-json-viewer expanded="2" show-toolbar="true" show-copy="true" theme="monokai" data="{{ dtoJson|e('html_attr') }}"></andypf-json-viewer>
    </div>
    {% set viewerImages = [] %}
    {% set viewerHires = [] %}
    {% for page in pages %}
        {% set image = page.url ?: page.sourceUrl %}
        {% if image %}
            {% set viewerImages = viewerImages|merge([image|folio_image('thumb')]) %}
            {% set viewerHires = viewerHires|merge([image|folio_image('archive')]) %}
        {% endif %}
    {% endfor %}
    {% if viewerImages is empty and dto.thumbnailUrl %}
        {% set viewerImages = [dto.thumbnailUrl|folio_image('thumb')] %}
        {% set viewerHires = [dto.thumbnailUrl|folio_image('archive')] %}
    {% endif %}
    <div class="row g-4 mb-4">
        <div class="col-lg-8">
            {% if viewerImages is not empty %}
                <div class="card"><div class="card-body p-0">
                    <twig:iiif:viewer :images="viewerImages" :hiresImages="viewerHires" :options="{showReferenceStrip: viewerImages|length > 1, referenceStripScroll: 'vertical', referenceStripWidth: 90, referenceStripPosition: 'BOTTOM_LEFT', showNavigator: false}" :height="600" :showLinks="false" />
                </div><div class="card-footer text-secondary">{{ viewerImages|length }} {{ viewerImages|length == 1 ? 'image' : 'images' }}</div></div>
            {% endif %}
        </div>
        <aside class="col-lg-4">
    <div class="d-flex align-items-center flex-wrap gap-3 mb-2 small">
        <a href="{{ path('survos_folio_duckdb_search', folio.rp|merge({language: app.request.query.get('language') ?: (app.request.hasSession ? app.request.session.get('dfolio_language.' ~ folio.code) : null)})) }}">← Search {{ folio.label ?: folio.code }}</a>
        {% set itemSource = dto.sourceUrl ?: dto.url %}
        {% if itemSource and (itemSource starts with 'https://' or itemSource starts with 'http://') %}<a href="{{ itemSource }}" target="_blank" rel="noopener noreferrer">Source ↗</a>{% endif %}
        <button type="button" class="btn btn-sm btn-outline-secondary" popovertarget="duck-item-json" title="Show the stored document">{}</button>
    </div>

            {{ block('folio_authorities') }}
            {% if dto.description %}<p>{{ dto.description|striptags }}</p>{% endif %}
        </aside>
    </div>
    <h2>Catalog details</h2>
    {% if facets is not empty %}
        <dl class="row my-3">
            {% for facet in facets %}
                <dt class="col-sm-3">{{ facet.label }}</dt>
                <dd class="col-sm-9 d-flex flex-wrap gap-2">
                    {% for value in facet.values %}
                        {% set filter = facet.numeric ? {(facet.name ~ 'Min'): value, (facet.name ~ 'Max'): value} : {(facet.name): value} %}
                        <a class="badge bg-blue-lt" href="{{ path('survos_folio_duckdb_search', {folioCode: folio.code, language: app.request.query.get('language')}|merge(filter)) }}">{{ value }}</a>
                    {% endfor %}
                </dd>
            {% endfor %}
        </dl>
    {% endif %}
    {% if dto.provenance|default(null) %}<p><strong>Provenance:</strong> {{ dto.provenance }}</p>{% endif %}
    {% if dto.citation|default(null) %}<p><strong>Citation:</strong> {{ dto.citation }}</p>{% endif %}
</div>
{% endif %}
{% endblock %}
