                        </div>
                    {% endif %}

                    {{ include('@SurvosFolioBundle/folio/_claims_table.html.twig', {claims: claims}) }}
                    {% endblock %}
                </div>

                <div class="col-lg-4" id="doc-side-col">
                    {% block folio_side_column %}
                    {# The narrative: flowing prose built from the typed DTO (title/date/credit
                       already shown in the hero, so the component starts with the descriptive
                       paragraph) — see Survos\FolioBundle\Twig\Components\FolioNarrative. Lives
                       beside the viewer, not stacked full-width above it — the image is the main
                       event on a row page, not something a reader scrolls past to find. Override
                       this block (e.g. folio/row/postcard.html.twig) to add content-type-specific
                       facts alongside <twig:folio:narrative>. #}
                    {% block folio_narrative %}
                    <div class="card mb-3 folio-detail-narrative">
                        <div class="card-body">
                            <twig:folio:narrative :dto="dto" />
                        </div>
                    </div>
                    {% endblock %}

                    {% if (hasOcr or hasLayout or hasHtr) and not isSingleImage %}
                        <div class="card mb-3" id="doc-ocr-card">
                            <div class="card-header d-flex align-items-center gap-2">
                                <h2 class="card-title mb-0">Extracted text</h2>
                                {# Badge: Handwriting (htr_annotate) > Layout (Mistral blocks) > OCR (flat). JS keeps it per-page. #}
                                <span id="doc-ocr-badge" class="badge {{ hasHtr ? 'bg-green-lt' : (hasLayout ? 'bg-purple-lt' : 'bg-blue-lt') }}">{{ hasHtr ? 'Handwriting' : (hasLayout ? 'Layout' : 'OCR') }}</span>
                                <span class="ms-auto d-inline-flex align-items-center gap-1">
                                    {% if pages|length > 1 %}
                                        <button type="button"
                                                class="btn btn-action rounded-pill border-0 js-folio-page-prev js-ocr-page-prev"
                                                style="min-width: 1.25rem; min-height: 1rem;"
                                                data-page-count="{{ pages|length }}"
                                                aria-label="Previous page"
                                                title="Previous page"
                                                disabled>
                                            {{ ux_icon('tabler:chevron-left', { class: 'icon' }) }}
                                        </button>
                                    {% endif %}
                                    <span id="doc-ocr-page" class="text-muted small">Page 1 of {{ pages|length }}</span>
                                    {% if pages|length > 1 %}
                                        <button type="button"
                                                class="btn btn-action rounded-pill border-0 js-folio-page-next js-ocr-page-next"
                                                style="min-width: 1.25rem; min-height: 1rem;"
                                                data-page-count="{{ pages|length }}"
                                                aria-label="Next page"
                                                title="Next page">
                                            {{ ux_icon('tabler:chevron-right', { class: 'icon' }) }}
                                        </button>
                                    {% endif %}
                                </span>
                            </div>
                            <div class="card-body">
                                <div id="doc-ocr-text"
                                     data-page-texts="{{ pageTexts|json_encode|e('html_attr') }}"
                                     data-page-layouts="{{ pageLayouts|json_encode|e('html_attr') }}"
                                     data-page-htr="{{ pageHtr|json_encode|e('html_attr') }}"
                                     style="white-space: pre-wrap; word-break: break-word; max-height: 600px; overflow-y: auto; font-size: 0.875rem; line-height: 1.45;">{{ pageTexts|first|trim ?: '(no extracted text for this page)' }}</div>
                            </div>
                        </div>
                    {% endif %}

                    {% if hasUxMap and tombstoneIsPreciseLocation %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">{{ 'location'|trans({}, 'folio')|default('Location') }}</h2>
                            </div>

                            <div class="card-body p-0">
                                {# City/country-level fallbacks (geoPrecision set) are deliberately excluded here --
                                   a centroid pin reads as "the photo was taken exactly here", which is misleading
                                   at that resolution. Only rows with real per-photo GPS get a mini-map. #}
                                {{ ux_map(
                                    center: [tombstoneLatitude, tombstoneLongitude],
                                    zoom: 15,
                                    markers: [{ position: [tombstoneLatitude, tombstoneLongitude] }],
                                    attributes: { style: 'height: 220px; width: 100%;' }
                                ) }}
                            </div>
                        </div>
                    {% endif %}

                    {% if ocrText %}
                        <div class="card mb-3" id="doc-transcription-card">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h2 class="card-title mb-0">Transcription</h2>

                                {% if ocrPageCount %}
                                    <span class="text-muted small">{{ ocrPageCount }} pages</span>
                                {% endif %}
                            </div>

                            <div class="card-body">
                                <div style="max-height: 480px; overflow-y: auto; white-space: pre-wrap; word-break: break-word;">{{ ocrText|trim }}</div>
                            </div>
                        </div>
                    {% endif %}

                    {% if terms %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">{{ 'terms'|trans({}, 'folio')|default('Terms') }}</h2>
                            </div>

                            <div class="list-group list-group-flush">
                                {% for set, values in terms %}
                                    <div class="list-group-item bg-transparent">
                                        <div class="text-muted small text-uppercase">{{ ux_icon(set, {class: 'icon me-1'}) }}{{ term_set_label(set) }}</div>

                                        {% for value in values %}
                                            {% if value.term %}
                                                <a
                                                    class="badge text-bg-light border me-1 text-decoration-none"
                                                    href="{{ path('survos_folio_term_show', {
                                                        folioCode: row.folioCode,
                                                        setCode: set,
                                                        termCode: value.code
                                                    }) }}"
                                                >
                                                    {{ value.label }}
                                                </a>
                                            {% else %}
                                                <span class="badge text-bg-light border me-1">
                                                    {{ value.label }}
                                                </span>
                                            {% endif %}
                                        {% endfor %}
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% set otherLinks = links|default([])|filter(l => l.core != 'image') %}

                    {% if otherLinks %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">Relations</h2>
                            </div>

                            <div class="list-group list-group-flush">
                                {% for link in otherLinks %}
                                    {% set target = link.row %}

                                    <div class="list-group-item bg-transparent">
                                        <div class="text-muted small font-monospace">{{ link.code }}</div>

                                        <div>
                                            {{ ux_icon(link.core, {class: 'icon me-1'}) }}{# predicate shown once above; here show the linked record #}
                                            {% if target %}
                                                <a href="{{ path('survos_folio_row_show', {
                                                    folioCode: row.folioCode,
                                                    coreCode: link.core,
                                                    dtoType: target.dtoType ?: 'row',
                                                    localId: target.localId
                                                }) }}">
                                                    {{ target.label ?: target.localId }}
                                                </a>
                                            {% else %}
                                                <span class="font-monospace">
                                                    {{ link.core }}/{{ link.localId }}
                                                </span>
                                            {% endif %}
                                        </div>
                                    </div>
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {% if aiTasks %}
                        <div class="card mb-3">
                            <div class="card-header">
                                <h2 class="card-title mb-0">AI processing</h2>
                            </div>

                            <div class="card-body d-flex flex-wrap gap-1">
                                {% for task in aiTasks %}
                                    {% set runId = aiTaskRuns[task] ?? null %}
                                    {% if runId %}
                                        <a class="badge text-bg-primary text-decoration-none" href="{{ path('survos_folio_run', {folioCode: row.folioCode, runId: runId}) }}" title="Open AI task run details">{{ task }}</a>
                                    {% else %}
                                        <span class="badge text-bg-light border">{{ task }}</span>
                                    {% endif %}
                                {% endfor %}
                            </div>
                        </div>
                    {% endif %}

                    {# Extras is the raw unmapped blob — developer noise. Show only in debug; hidden in production. #}
                    {% if extras and app.debug %}
                        <div class="card mb-3">
                            <div class="card-header d-flex justify-content-between align-items-center">
                                <h2 class="card-title mb-0">Extras <span class="badge bg-secondary-lt ms-1">dev</span></h2>

                                <button
                                    type="button"
                                    class="btn btn-sm btn-outline-secondary"
                                    onclick="navigator.clipboard.writeText(this.closest('.card').querySelector('pre').innerText).then(() => { const t = this.innerText; this.innerText = 'Copied!'; setTimeout(() => this.innerText = t, 1200); })"
                                >
                                    Copy
                                </button>
                            </div>

                            <div class="card-body">
                                <pre class="mb-0" style="white-space: pre-wrap; word-break: break-word; user-select: all;">{{ extras|json_encode(constant('JSON_PRETTY_PRINT') b-or constant('JSON_UNESCAPED_SLASHES') b-or constant('JSON_UNESCAPED_UNICODE')) }}</pre>
                            </div>
                        </div>
                    {% endif %}
                    {% endblock %}
                </div>
            </div>

            {% set firstPage = pages|first %}
            {% if firstPage and firstPage.url %}
                {% set aspectProbe = firstPage.url %}
                {% guard filter imgproxy %}{% set aspectProbe = aspectProbe|imgproxy('thumb') %}{% endguard %}
                <script>
                    (function () {
                        var probe = {{ aspectProbe|json_encode|raw }};
                        var img = new Image();
                        img.onload = function () {
                            if (img.naturalWidth && img.naturalHeight > img.naturalWidth * 1.15) {
                                var main = document.getElementById('doc-main-col');
                                var side = document.getElementById('doc-side-col');
                                if (main) {
                                    main.dataset.folioSplitClass = 'col-lg-6';
                                    main.classList.replace('col-lg-8', 'col-lg-6');
                                }
                                if (side) {
                                    side.dataset.folioSplitClass = 'col-lg-6';
                                    side.classList.replace('col-lg-4', 'col-lg-6');
                                }
                            }
                        };
                        img.src = probe;
                    })();
                </script>
            {% endif %}

            <script>
                function updateFolioAiLink(pageIndex) {
                    const link = document.getElementById('folio-ai-page-link');

                    if (!link) {
                        return;
                    }

                    let images = [];

                    try {
                        images = JSON.parse(link.dataset.aiImages || '[]');
                    } catch (e) {
                        images = [];
                    }

                    const index = Number(pageIndex);
                    const imageUrl = Number.isInteger(index) ? images[index] : null;
                    const template = link.dataset.aiUrlTemplate || '';

                    if (!imageUrl || !template) {
                        return;
                    }

                    link.href = template.replace('__URL__', encodeURIComponent(imageUrl));
                }

                function getPageFromUrl() {
                    const params = new URLSearchParams(window.location.search);
                    const page = Number(params.get('page'));

                    // URL is human-friendly: ?page=1 means first page
                    if (!Number.isInteger(page) || page < 1) {
                        return 0;
                    }

                    return page - 1;
                }

                function setPageInUrl(pageIndex) {
                    const url = new URL(window.location.href);
                    url.searchParams.set('page', pageIndex + 1);
                    window.history.replaceState({}, '', url);
                }

                function setActiveThumb(pageIndex) {
                    document.querySelectorAll('.js-osd-page img').forEach((img) => {
                        img.classList.remove('border-primary');
                    });

                    const activeThumb = document.querySelector(`.js-osd-page[data-page-index="${pageIndex}"] img`);

                    if (activeThumb) {
                        activeThumb.classList.add('border-primary');
                    }
                }

                function updateFolioPageNavButtons(pageIndex, total = 0) {
                    const previousButtons = document.querySelectorAll('.js-folio-page-prev');
                    const nextButtons = document.querySelectorAll('.js-folio-page-next');
                    const pageCount = Number(previousButtons[0]?.dataset.pageCount || nextButtons[0]?.dataset.pageCount || total || 0);

                    previousButtons.forEach((previousButton) => {
                        previousButton.disabled = pageIndex <= 0;
                    });

                    nextButtons.forEach((nextButton) => {
                        nextButton.disabled = !pageCount || pageIndex >= pageCount - 1;
                    });
                }

                function setColumnClass(element, columnClass) {
                    if (!element || !columnClass) {
                        return;
                    }

                    ['col-lg-4', 'col-lg-6', 'col-lg-8', 'col-lg-12'].forEach((className) => {
                        element.classList.remove(className);
                    });

                    element.classList.add(columnClass);
                }

                function resizeFolioViewer() {
                    const viewerEl = document.querySelector(
                        '[data-controller="survos--iiif-bundle--iiif-viewer"]'
                    );

                    if (viewerEl && viewerEl.viewer && typeof viewerEl.viewer.forceRedraw === 'function') {
                        viewerEl.viewer.forceRedraw();
                    }

                    window.dispatchEvent(new Event('resize'));
                }

                function applyFolioViewerMode(mode) {
                    const grid = document.getElementById('folio-viewer-grid');
                    const main = document.getElementById('doc-main-col');
                    const side = document.getElementById('doc-side-col');
                    const textCard = document.getElementById('doc-ocr-card');

                    if (!grid || !main || !side || !textCard) {
                        return;
                    }

                    const normalizedMode = ['osd', 'side-by-side', 'text'].includes(mode) ? mode : 'side-by-side';
                    const splitMainClass = main.dataset.folioSplitClass || 'col-lg-8';
                    const splitSideClass = side.dataset.folioSplitClass || 'col-lg-4';

                    grid.dataset.viewerMode = normalizedMode;

                    main.classList.remove('d-none');
                    side.classList.remove('d-none');

                    if (normalizedMode === 'osd') {
                        setColumnClass(main, 'col-lg-12');
                        side.classList.add('d-none');
                    } else if (normalizedMode === 'text') {
                        main.classList.add('d-none');
                        setColumnClass(side, 'col-lg-12');
                    } else {
                        setColumnClass(main, splitMainClass);
                        setColumnClass(side, splitSideClass);
                    }

                    document.querySelectorAll('.js-folio-view-mode').forEach((input) => {
                        input.checked = input.value === normalizedMode;
                    });

                    setTimeout(resizeFolioViewer, 80);
                }

                function initFolioViewerModeControl() {
                    const controls = document.querySelectorAll('.js-folio-view-mode');

                    if (!controls.length) {
                        return;
                    }

                    controls.forEach((control) => {
                        control.onchange = () => applyFolioViewerMode(control.value);
                    });

                    applyFolioViewerMode('side-by-side');
                }

                function initFolioDetailViewerControls() {
                    const viewerEl = document.querySelector(
                        '[data-controller="survos--iiif-bundle--iiif-viewer"]'
                    );

                    if (!viewerEl) {
                        return;
                    }

                    const initialPageIndex = getPageFromUrl();
                    const previousButtons = document.querySelectorAll('.js-folio-page-prev');
                    const nextButtons = document.querySelectorAll('.js-folio-page-next');
                    const pageCount = Number(previousButtons[0]?.dataset.pageCount || nextButtons[0]?.dataset.pageCount || 0);

                    const goToPage = (pageIndex, updateUrl = true) => {
                        if (!viewerEl.viewer || !Number.isInteger(pageIndex)) {
                            return;
                        }

                        if (pageCount && (pageIndex < 0 || pageIndex >= pageCount)) {
                            return;
                        }

                        viewerEl.viewer.goToPage(pageIndex);
                        updateFolioAiLink(pageIndex);
                        setActiveThumb(pageIndex);
                        updateFolioPageNavButtons(pageIndex, pageCount);

                        if (updateUrl) {
                            setPageInUrl(pageIndex);
                        }
                    };

                    document.querySelectorAll('.js-osd-page').forEach((thumb) => {
                        thumb.onclick = (event) => {
                            event.preventDefault();

                            const pageIndex = Number(thumb.dataset.pageIndex);
                            goToPage(pageIndex);
                        };
                    });

                    previousButtons.forEach((previousButton) => {
                        previousButton.onclick = () => {
                            goToPage(getPageFromUrl() - 1);
                        };
                    });

                    nextButtons.forEach((nextButton) => {
                        nextButton.onclick = () => {
                            goToPage(getPageFromUrl() + 1);
                        };
                    });

                    // Wait a tick so the IIIF viewer has time to initialize.
                    setTimeout(() => {
                        goToPage(initialPageIndex, false);
                    }, 100);
                }

                document.addEventListener('iiif-viewer:page', (e) => {
                    updateFolioAiLink(e.detail.index);
                    setActiveThumb(e.detail.index);
                    setPageInUrl(e.detail.index);
                    updateFolioPageNavButtons(e.detail.index, e.detail.total);
                });

                document.addEventListener('turbo:load', initFolioViewerModeControl);
                document.addEventListener('DOMContentLoaded', initFolioViewerModeControl);
                document.addEventListener('turbo:load', initFolioDetailViewerControls);
                document.addEventListener('DOMContentLoaded', initFolioDetailViewerControls);
            </script>

            <style>
                .page {
                    background:
                        radial-gradient(circle at top left, rgba(255, 238, 198, .9), transparent 34%),
                        radial-gradient(circle at top right, rgba(232, 218, 255, .9), transparent 32%),
                        linear-gradient(135deg, #fff8e8 0%, #fff 46%, #f5f0e8 100%);
                }

                /* Do NOT hide the host app's navbar here. The detail page inherits the
                   calling application's chrome (folio_base_template()) by contract; the
                   designer's immersive mockup hid it (.navbar{display:none}, 9c52db36) and
                   every host app silently lost its header until zm noticed (2026-07-17). */

                .folio-detail-shell {
                    max-width: none;
                    padding: 0;
                    border-radius: 0;
                    background: none;
                    border: none;
                    box-shadow: none;
                    backdrop-filter: none;
                }

                {# Kept intentionally compact — this is a working viewer page, not a landing/article
                   page. The photo/document is the main event; the hero should identify the item
                   in one glance and get out of the way, not push the viewer below the fold. #}
                .folio-detail-hero {
                    padding: 1rem 1.25rem;
                    margin-bottom: 1rem;
                    border-radius: 1rem;
                    background:
                        radial-gradient(circle at top left, rgba(255,244,220,.85), transparent 34%),
                        radial-gradient(circle at top right, rgba(235,222,255,.75), transparent 32%),
                        rgba(255,255,255,.72);
                    border: 1px solid rgba(120,100,70,.12);
                }

                .folio-detail-title,
                .folio-detail-section-title,
                .folio-detail-shell .card-title {
                    font-family: Georgia, serif;
                    letter-spacing: -.025em;
                    color: #283142;
                }

                .folio-detail-title {
                    font-size: clamp(1.5rem, 2.75vw, 2.25rem);
                    line-height: 1.1;
                    letter-spacing: -.03em;
                }

                .folio-detail-shell .card {
                    background: rgba(255,255,255,.72);
                    border: 1px solid rgba(120,100,70,.12);
                    border-radius: 1.25rem;
                    box-shadow: 0 12px 34px rgba(33,37,41,.055);
                    backdrop-filter: blur(14px);
                    overflow: hidden;
                }

                .folio-detail-shell .card-header {
                    background: transparent;
                    border-bottom-color: rgba(120,100,70,.10);
                }

                .folio-detail-shell pre {
                    background: #111827;
                    color: #fff;
                    border-radius: 1rem;
                    padding: 1rem;
                }

                .folio-detail-narrative {
                    font-size: 0.95rem;
                    line-height: 1.55;
                }

                .folio-detail-narrative .folio-narrative__facts {
                    color: #283142;
                }

                .folio-viewer-toolbar-card .card-header {
                    min-height: 4rem;
                }

                .folio-view-mode-control {
                    display: flex;
                    gap: 0.25rem;
                    padding: .25rem;
                    border: 1px solid rgba(120, 100, 70, .14);
                    border-radius: .75rem;
                    background: rgba(255, 255, 255, .78);
                    box-shadow: 0 .5rem 1.5rem rgba(33, 37, 41, .045);
                }

                .folio-view-mode-control .btn {
                    border: 0;
                    border-radius: .55rem !important;
                    color: #4b5563;
                    font-weight: 600;
                    box-shadow: none !important;
                }

                .folio-view-mode-control .btn-check:checked + .btn {
                    color: #5b21b6;
                    background: rgba(124, 58, 237, .10);
                    box-shadow: inset 0 0 0 1px rgba(124, 58, 237, .24) !important;
                }

                .folio-viewer-grid[data-viewer-mode="osd"] #doc-viewer,
                .folio-viewer-grid[data-viewer-mode="text"] #doc-ocr-card {
                    min-height: 680px;
                }

                .folio-viewer-grid[data-viewer-mode="text"] #doc-ocr-text {
                    max-height: 70vh !important;
                }

                @media (max-width: 767.98px) {
                    .folio-view-mode-control {
                        width: 100%;
                        overflow-x: auto;
                    }

                    .folio-view-mode-control .btn {
                        flex: 1 0 auto;
                        white-space: nowrap;
                    }
                }

                /* .page-header is intentionally left visible (not hidden) — that's where
                   base.html.twig's own PAGE_ACTIONS rendering shows RowMenu's Show/Edit/Bookmark/
                   Ask document/OCR/Handwriting/Share, the SAME standard mechanism every other
                   row-scoped page uses (Edit, item_chat, ...). This hero only supplies its own
                   title/breadcrumb/badges below it — no bespoke action bar here or in a host-app
                   override; see git history (9c52db36, and the churn since) for what happens when
                   a page tries to duplicate that menu instead of just letting it render normally. */
            </style>
        </div>
    </div>
{% endblock %}
