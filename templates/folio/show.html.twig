{% extends app.request.attributes.get('_layout')|default('base.html.twig') %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set folioLabel = app.request.attributes.get('current_folio_title', ctx.folioCode) %}

{% block body_class %}folio-layout{% endblock %}

{#
{% block page_pretitle %}Folio Overview{% endblock %}

{% block page_title %}
    {{ folioLabel }}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    {{ cores|length }} cores
    <span class="mx-1 text-muted">&middot;</span>
    {{ totalRows|number_format }} rows
{% endblock %}
#}

{% block title %}{{ folioLabel }}{% endblock %}

{% block body %}
    {% set installCommand = 'bin/console folio:pull --dataset ' ~ ctx.folioCode %}

    <div class="card mb-4" {{ stimulus_controller('clipboard', { successContent: 'Copied!' }) }}>
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
            <h2 class="card-title mb-0">Install Folio</h2>
            <button
                type="button"
                class="btn btn-sm btn-ghost-secondary"
                {{ stimulus_action('clipboard', 'copy') }}
                {{ stimulus_target('clipboard', 'button') }}
                title="Copy folio pull command"
            >
                {% guard function ux_icon %}{{ ux_icon('clipboard') }} Copy{% else %}Copy{% endguard %}
            </button>
        </div>
        <div class="card-body">
            <code class="d-block text-break" {{ stimulus_target('clipboard', 'source') }}>{{ installCommand }}</code>
        </div>
    </div>

    {# Cores — each is first-class, with its own links and counts. #}
    <div class="row row-cards mb-4">
        {% for summary in coreSummaries %}
            {% set core = summary.core %}

            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div class="min-w-0">
                                {# Always translate (system domain, built by `trans:system`); fall back to the
                                   bare code, never core.label — it's populated with the code and shadows the translation. #}
                                {% set coreKey = 'core.' ~ core.code %}
                                {% set coreLabel = coreKey|trans({}, 'system') %}
                                <div class="h3 mb-0 text-truncate">
                                    {{ ux_icon(core_icon(core.code), {class: 'icon me-1 text-muted'}) }}{{ coreLabel == coreKey ? core.code : coreLabel }}
                                </div>
                                <div class="text-muted font-monospace small">{{ core.code }}</div>
                            </div>

                            <span class="badge text-bg-secondary fw-semibold px-2">
                                {{ core.rowCount|number_format }}
                            </span>
                        </div>

                        <div class="btn-list mt-3">
                            <a class="btn btn-sm btn-primary"
                               href="{{ path('survos_folio_core_search', {
                                   provider: provider,
                                   dataset: dataset,
                                   coreCode: core.code
                               }) }}">
                                Grid
                            </a>

                            <a class="btn btn-sm btn-outline-secondary"
                               href="{{ path('survos_folio_core', {
                                   provider: provider,
                                   dataset: dataset,
                                   coreCode: core.code
                               }) }}">
                                List
                            </a>
                        </div>

                        {% set dtoTypes = summary.dtoChoices|filter(dto => dto.type) %}

                        {% if dtoTypes|length > 0 %}
                            <div class="d-flex flex-wrap gap-1 mt-3">
                                {% for dto in dtoTypes|slice(0, 6) %}
                                    <a class="badge bg-blue-lt text-decoration-none"
                                       href="{{ path('survos_folio_core_dto', {
                                           provider: provider,
                                           dataset: dataset,
                                           coreCode: core.code,
                                           dtoType: dto.type
                                       }) }}">
                                        {{ dto.label }} · {{ dto.count|number_format }}
                                    </a>
                                {% endfor %}

                                {% if dtoTypes|length > 6 %}
                                    <span class="badge bg-secondary-lt">
                                        +{{ dtoTypes|length - 6 }} more
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col">
                <div class="card">
                    <div class="card-body text-muted">
                        No cores loaded.
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row row-cards">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="card-title mb-0">Link Types</h2>
                </div>

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Forward</th>
                                <th>Reverse</th>
                                <th class="text-end">Links</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for linkType in linkTypes %}
                                <tr>
                                    <td>
                                        <span class="font-monospace">{{ linkType.leftCore }}</span>
                                        <span class="mx-1">{{ linkType.label ?: linkType.code }}</span>
                                        <span class="font-monospace">{{ linkType.rightCore }}</span>
                                        <div class="text-muted small font-monospace">{{ linkType.code }}</div>
                                    </td>

                                    <td>
                                        <span class="font-monospace">{{ linkType.rightCore }}</span>
                                        <span class="mx-1">{{ linkType.reverseLabel ?: linkType.reverseCode ?: 'is related to' }}</span>
                                        <span class="font-monospace">{{ linkType.leftCore }}</span>

                                        {% if linkType.reverseCode %}
                                            <div class="text-muted small font-monospace">{{ linkType.reverseCode }}</div>
                                        {% endif %}
                                    </td>

                                    <td class="text-end">{{ linkType.linkCount|number_format }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-muted">
                                        No link types loaded.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="card-title mb-0">Observed Schema</h2>
                </div>

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Core</th>
                                <th>Type</th>
                                <th class="text-end">Rows</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for table in schemaTables|filter(table => table.kind == 'dto') %}
                                <tr>
                                    <td class="font-monospace">{{ table.name }}</td>
                                    <td>{{ table.core_code }}</td>
                                    <td>{{ table.dto_type }}</td>
                                    <td class="text-end">{{ table.row_count|number_format }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-muted">
                                        No observed DTO schema has been generated yet.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if views %}
                    <div class="card-footer">
                        <div class="text-muted small mb-2">Generated SQLite views</div>
                        <div class="d-flex flex-wrap gap-2">
                            {% for view in views %}
                                <span class="badge bg-blue-lt font-monospace">
                                    {{ view }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% if docs %}
        <div class="row row-cards mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title mb-0">Archive Docs</h2>
                    </div>

                    <div class="list-group list-group-flush">
                        {% for doc in docs %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>{{ doc.title }}</strong>
                                    <span class="badge text-bg-secondary">{{ doc.type }}</span>
                                </div>

                                <pre class="small mb-0" style="max-height: 12rem; overflow:auto;{% if doc.type != 'json' %} white-space: pre-wrap;{% endif %}">{{ doc.body }}</pre>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <style>
        .page-header {
            display: none !important;
        }
    </style>
{% endblock %}
