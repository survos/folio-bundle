{% extends app.request.attributes.get('_layout')|default(folio_base_template()) %}

{% set parts = ctx.folioCode|split('/') %}
{% set provider = parts[0] %}
{% set dataset = parts[1] %}
{% set folioLabel = app.request.attributes.get('current_folio_title', ctx.folioCode) %}

{% block body_class %}folio-layout{% endblock %}

{#
{% block page_pretitle %}Folio Overview{% endblock %}

{% block page_title %}
    {{ folioLabel }}
{% endblock %}

{% block page_subtitle %}
    <span class="font-monospace">{{ ctx.folioCode }}</span>
    <span class="mx-1 text-muted">&middot;</span>
    {{ cores|length }} cores
    <span class="mx-1 text-muted">&middot;</span>
    {{ totalRows|number_format }} rows
{% endblock %}
#}

{% block title %}{{ folioLabel }}{% endblock %}

{% block body %}
    {% if timeline %}
        {% set controllerName = 'survos--folio-bundle--slideshow' %}

        <div class="folio-slideshow mb-4" {{ stimulus_controller(controllerName, {slides: timeline.slides}) }}>
            <div class="row g-3 align-items-stretch">
                <div class="col-lg-8">
                    <div class="card h-100 text-white overflow-hidden" style="background: #111;">
                        <div class="ratio ratio-4x3">
                            <img
                                class="w-100 h-100 folio-slideshow-image"
                                style="object-fit: contain; background: #111;"
                                alt=""
                                {{ stimulus_target(controllerName, 'image') }}
                            >
                        </div>
                        <div class="card-footer bg-dark border-secondary d-flex justify-content-between align-items-center gap-2">
                            <button type="button" class="btn btn-outline-light" {{ stimulus_action(controllerName, 'previous') }}>
                                {% guard function ux_icon %}{{ ux_icon('tabler:chevron-left', {class: 'icon me-1'}) }}{% endguard %}
                                Previous
                            </button>
                            <span class="badge text-bg-light" {{ stimulus_target(controllerName, 'index') }}></span>
                            <button type="button" class="btn btn-outline-light" {{ stimulus_action(controllerName, 'next') }}>
                                Next
                                {% guard function ux_icon %}{{ ux_icon('tabler:chevron-right', {class: 'icon ms-1'}) }}{% endguard %}
                            </button>
                        </div>
                    </div>
                </div>

                <div class="col-lg-4">
                    <div class="card h-100">
                        <div class="card-header d-flex align-items-center justify-content-between">
                            <h2 class="card-title mb-0">{{ timeline.core.rowCount|number_format }} photos, {{ timeline.slider.min }}&ndash;{{ timeline.slider.max }}</h2>
                        </div>
                        <div class="card-body">
                            <div class="text-muted" {{ stimulus_target(controllerName, 'detail') }}></div>
                        </div>
                        <div class="card-footer">
                            <a class="btn btn-sm btn-primary w-100"
                               href="{{ path('survos_folio_slideshow', {provider: provider, dataset: dataset, coreCode: timeline.core.code}) }}">
                                View full timeline
                            </a>
                        </div>
                    </div>
                </div>
            </div>

            <div class="folio-thumbnail-strip mt-3">
                {% for slide in timeline.slides|slice(0, 120) %}
                    <button
                        type="button"
                        class="folio-thumbnail"
                        title="#{{ slide.id }}"
                        data-slide-index="{{ loop.index0 }}"
                        {{ stimulus_target(controllerName, 'thumbnail') }}
                        {{ stimulus_action(controllerName, 'jump') }}
                    >
                        {% if slide.thumb %}
                            <img src="{{ slide.thumb|imgproxy('thumb') }}" alt="" loading="lazy" decoding="async">
                        {% else %}
                            <span class="small text-muted">{{ loop.index }}</span>
                        {% endif %}
                    </button>
                {% endfor %}
            </div>

            <collection-slider
                min="{{ timeline.slider.min }}"
                max="{{ timeline.slider.max }}"
                value="{{ timeline.slider.value }}"
                step="1"
                tick-count="10"
                counts="{{ timeline.counts|json_encode }}"
                data-slideshow-numeric="1"
                {{ stimulus_target(controllerName, 'slider') }}
            ></collection-slider>
        </div>

        <style>
            .folio-thumbnail-strip {
                display: flex;
                gap: 0.5rem;
                overflow-x: auto;
                padding: 0.5rem 0;
                scrollbar-width: thin;
            }

            .folio-thumbnail {
                flex: 0 0 auto;
                width: 72px;
                height: 56px;
                padding: 2px;
                border: 2px solid transparent;
                border-radius: 0.5rem;
                background: #fff;
                cursor: pointer;
            }

            .folio-thumbnail img {
                width: 100%;
                height: 100%;
                object-fit: cover;
                border-radius: 0.35rem;
                display: block;
            }

            .folio-thumbnail.is-active {
                border-color: #066fd1;
            }

            .folio-slideshow-image {
                opacity: 1;
                transition: opacity 140ms ease;
            }

            .folio-slideshow-image.is-changing {
                opacity: 0;
            }
        </style>
    {% endif %}

    {% set installCommand = 'bin/console folio:pull --dataset ' ~ ctx.folioCode %}

    <div class="card mb-4" {{ stimulus_controller('clipboard', { successContent: 'Copied!' }) }}>
        <div class="card-header d-flex align-items-center justify-content-between gap-2">
            <h2 class="card-title mb-0">Install Folio</h2>
            <button
                type="button"
                class="btn btn-sm btn-ghost-secondary"
                {{ stimulus_action('clipboard', 'copy') }}
                {{ stimulus_target('clipboard', 'button') }}
                title="Copy folio pull command"
            >
                {% guard function ux_icon %}{{ ux_icon('clipboard') }} Copy{% else %}Copy{% endguard %}
            </button>
        </div>
        <div class="card-body">
            <code class="d-block text-break" {{ stimulus_target('clipboard', 'source') }}>{{ installCommand }}</code>
        </div>
    </div>

    {# Cores — each is first-class, with its own links and counts. #}
    <div class="row row-cards mb-4">
        {% for summary in coreSummaries %}
            {% set core = summary.core %}

            <div class="col-sm-6 col-lg-4">
                <div class="card h-100">
                    <div class="card-body">
                        <div class="d-flex align-items-start justify-content-between gap-2">
                            <div class="min-w-0">
                                {# Always translate (system domain, built by `trans:system`); fall back to the
                                   bare code, never core.label — it's populated with the code and shadows the translation. #}
                                {% set coreKey = 'core.' ~ core.code %}
                                {% set coreLabel = coreKey|trans({}, 'system') %}
                                <div class="h3 mb-0 text-truncate">
                                    {{ ux_icon(core_icon(core.code), {class: 'icon me-1 text-muted'}) }}{{ coreLabel == coreKey ? core.code : coreLabel }}
                                </div>
                                <div class="text-muted font-monospace small">{{ core.code }}</div>
                            </div>

                            <span class="badge text-bg-secondary fw-semibold px-2">
                                {{ core.rowCount|number_format }}
                            </span>
                        </div>

                        <div class="btn-list mt-3">
                            <a class="btn btn-sm btn-primary"
                               href="{{ path('survos_folio_core_search', {
                                   provider: provider,
                                   dataset: dataset,
                                   coreCode: core.code
                               }) }}">
                                Grid
                            </a>

                            <a class="btn btn-sm btn-outline-secondary"
                               href="{{ path('survos_folio_core', {
                                   provider: provider,
                                   dataset: dataset,
                                   coreCode: core.code
                               }) }}">
                                List
                            </a>

                            <a class="btn btn-sm btn-outline-secondary"
                               href="{{ path('survos_folio_slideshow', {
                                   provider: provider,
                                   dataset: dataset,
                                   coreCode: core.code
                               }) }}">
                                {% guard function ux_icon %}{{ ux_icon('tabler:slideshow', {class: 'icon me-1'}) }}{% endguard %}
                                Slideshow
                            </a>
                        </div>

                        {% set dtoTypes = summary.dtoChoices|filter(dto => dto.type) %}

                        {% if dtoTypes|length > 0 %}
                            <div class="d-flex flex-wrap gap-1 mt-3">
                                {% for dto in dtoTypes|slice(0, 6) %}
                                    <span class="badge bg-blue-lt d-inline-flex align-items-center gap-1">
                                        <a class="text-decoration-none text-reset"
                                           href="{{ path('survos_folio_core_dto', {
                                               provider: provider,
                                               dataset: dataset,
                                               coreCode: core.code,
                                               dtoType: dto.type
                                           }) }}">
                                            {{ dto.label }} · {{ dto.count|number_format }}
                                        </a>
                                        <a class="text-decoration-none text-reset ms-1"
                                           href="{{ path('survos_folio_slideshow_filtered', {
                                               provider: provider,
                                               dataset: dataset,
                                               coreCode: core.code,
                                               filter: slideshow_filter({dtoType: dto.type})
                                           }) }}"
                                           title="Slideshow">
                                            {% guard function ux_icon %}{{ ux_icon('tabler:slideshow', {class: 'icon icon-sm'}) }}{% else %}Slides{% endguard %}
                                        </a>
                                    </span>
                                {% endfor %}

                                {% if dtoTypes|length > 6 %}
                                    <span class="badge bg-secondary-lt">
                                        +{{ dtoTypes|length - 6 }} more
                                    </span>
                                {% endif %}
                            </div>
                        {% endif %}
                    </div>
                </div>
            </div>
        {% else %}
            <div class="col">
                <div class="card">
                    <div class="card-body text-muted">
                        No cores loaded.
                    </div>
                </div>
            </div>
        {% endfor %}
    </div>

    <div class="row row-cards">
        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="card-title mb-0">Link Types</h2>
                </div>

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Forward</th>
                                <th>Reverse</th>
                                <th class="text-end">Links</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for linkType in linkTypes %}
                                <tr>
                                    <td>
                                        <span class="font-monospace">{{ linkType.leftCore }}</span>
                                        <span class="mx-1">{{ linkType.label ?: linkType.code }}</span>
                                        <span class="font-monospace">{{ linkType.rightCore }}</span>
                                        <div class="text-muted small font-monospace">{{ linkType.code }}</div>
                                    </td>

                                    <td>
                                        <span class="font-monospace">{{ linkType.rightCore }}</span>
                                        <span class="mx-1">{{ linkType.reverseLabel ?: linkType.reverseCode ?: 'is related to' }}</span>
                                        <span class="font-monospace">{{ linkType.leftCore }}</span>

                                        {% if linkType.reverseCode %}
                                            <div class="text-muted small font-monospace">{{ linkType.reverseCode }}</div>
                                        {% endif %}
                                    </td>

                                    <td class="text-end">{{ linkType.linkCount|number_format }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="3" class="text-muted">
                                        No link types loaded.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>
            </div>
        </div>

        <div class="col-lg-6">
            <div class="card h-100">
                <div class="card-header">
                    <h2 class="card-title mb-0">Observed Schema</h2>
                </div>

                <div class="table-responsive">
                    <table class="table table-vcenter card-table">
                        <thead>
                            <tr>
                                <th>Name</th>
                                <th>Core</th>
                                <th>Type</th>
                                <th class="text-end">Rows</th>
                            </tr>
                        </thead>
                        <tbody>
                            {% for table in schemaTables|filter(table => table.kind == 'dto') %}
                                <tr>
                                    <td class="font-monospace">{{ table.name }}</td>
                                    <td>{{ table.core_code }}</td>
                                    <td>{{ table.dto_type }}</td>
                                    <td class="text-end">{{ table.row_count|number_format }}</td>
                                </tr>
                            {% else %}
                                <tr>
                                    <td colspan="4" class="text-muted">
                                        No observed DTO schema has been generated yet.
                                    </td>
                                </tr>
                            {% endfor %}
                        </tbody>
                    </table>
                </div>

                {% if views %}
                    <div class="card-footer">
                        <div class="text-muted small mb-2">Generated SQLite views</div>
                        <div class="d-flex flex-wrap gap-2">
                            {% for view in views %}
                                <span class="badge bg-blue-lt font-monospace">
                                    {{ view }}
                                </span>
                            {% endfor %}
                        </div>
                    </div>
                {% endif %}
            </div>
        </div>
    </div>

    {% if docs %}
        <div class="row row-cards mt-4">
            <div class="col-12">
                <div class="card">
                    <div class="card-header">
                        <h2 class="card-title mb-0">Archive Docs</h2>
                    </div>

                    <div class="list-group list-group-flush">
                        {% for doc in docs %}
                            <div class="list-group-item">
                                <div class="d-flex justify-content-between align-items-center mb-1">
                                    <strong>{{ doc.title }}</strong>
                                    <span class="badge text-bg-secondary">{{ doc.type }}</span>
                                </div>

                                <pre class="small mb-0" style="max-height: 12rem; overflow:auto;{% if doc.type != 'json' %} white-space: pre-wrap;{% endif %}">{{ doc.body }}</pre>
                            </div>
                        {% endfor %}
                    </div>
                </div>
            </div>
        </div>
    {% endif %}

    <style>
        .page-header {
            display: none !important;
        }
    </style>
{% endblock %}
