{# templates/components/FolioItem.html.twig
   Lean single-photo view (fortepan.hu style: big image + details alongside). See
   src/Twig/Components/FolioItem.php for the props/data contract. NOT a replacement for
   folio/detail.html.twig -- that stays the full power-user viewer. #}
{% if row is null %}
    <div class="alert alert-warning">{{ 'item_not_found'|trans({}, 'folio') }}</div>
{% else %}
    {% set tombstoneTitle = attribute(row.dtoData, 'title')|default(attribute(row.extras, 'dcterms:title')|default(row.label ?: row.localId)) %}
    {% if tombstoneTitle starts with '"' and tombstoneTitle ends with '"' %}
        {% set tombstoneTitle = tombstoneTitle|trim('"') %}
    {% endif %}
    {% set tombstoneDescription = attribute(row.dtoData, 'description')|default(attribute(row.extras, 'dcterms:description')|default(null)) %}
    {% set tombstoneDate = attribute(row.dtoData, 'date')|default(attribute(row.extras, 'dcterms:date')|default(null)) %}
    {% set tombstoneYear = attribute(row.dtoData, 'year')|default(tombstoneDate) %}
    {% set tombstoneCredit = attribute(row.dtoData, 'citation')|default(null) %}
    {% set tombstoneDonor = attribute(row.dtoData, 'donor')|default(null) %}
    {% set tombstoneLocation = [
        attribute(row.dtoData, 'city')|default(null),
        attribute(row.dtoData, 'state')|default(null),
        attribute(row.dtoData, 'country')|default(null),
    ]|filter(v => v is not empty)|join(', ') %}
    {% set sourceCaption = attribute(row.dtoData, 'sourceCaption')|default(attribute(row.extras, 'sourceCaption')|default(null)) %}
    {% set citationUrl = row.citationUrl ?: attribute(row.dtoData, 'citationUrl')|default(null) %}
    {% set imageSource = row.thumbnailSource %}
    {% set downloadUrl = attribute(row.dtoData, 'largeImageUrl')|default(imageSource) %}
    {% set tombstoneLicense = attribute(row.dtoData, 'rightsUri')|default(null) %}
    {% set downloadFilename = dataset ~ '-' ~ row.localId ~ '.jpg' %}
    {% set downloadCitation = [tombstoneTitle, tombstoneCredit, citationUrl]|filter(v => v is not empty)|join(' — ') %}

    {# Same OSD (OpenSeadragon) viewer detail.html.twig uses for its images -- compact toolbar,
       real zoom/pan, and it works on plain (non-IIIF) source images too, not just true IIIF
       endpoints (imgproxy stands in for image tiling/info.json). Falls back to a plain <img>
       when the row has no Page entities (not every ingest populates them). #}
    {% set pages = row.pages %}
    {% if pages|length > 0 %}
        {% set viewerImages = [] %}
        {% set viewerHires = [] %}
        {% set viewerInfoUrls = [] %}
        {% for page in pages %}
            {% set pageImg = page.url %}
            {% set pageHires = page.url %}
            {% set pageInfoUrl = null %}
            {% guard filter imgproxy %}
                {% set pageImg = page.url|imgproxy('thumb') %}
                {% set pageHires = page.url|imgproxy('archive') %}
                {% set pageInfoUrl = path('survos_imgproxy_info', {url: page.url}) %}
            {% endguard %}
            {% set viewerImages = viewerImages|merge([pageImg]) %}
            {% set viewerHires = viewerHires|merge([pageHires]) %}
            {% set viewerInfoUrls = viewerInfoUrls|merge([pageInfoUrl]) %}
        {% endfor %}
    {% endif %}

    {% if fortepanLayout %}
        {# Structural port of fortepan.hu's own /photos/?id=X detail page -- image left
           (flex-grow, dark stage), fixed 280px light sidebar right (real px value confirmed
           against the live site via getBoundingClientRect(), 2026-07-30), field order
           Description/Year/Photo ID/Donor/Tags matching sidebar.scss's carousel-sidebar__*
           classes exactly (fresh class names here, not folio-row__* -- avoids fighting that
           layout's own base <style> block below). Year/Donor/Location aren't links here the
           way fortepan.hu's are (?year=/?donor=/?city= facet filtering isn't wired into
           FolioRowProvider yet) -- Tags still are, via the existing term-browse route. #}
        <div class="fp-detail">
            <div class="fp-detail__image">
                {% if imageSource %}
                    <img src="{{ imageSource|imgproxy('display') }}" alt="{{ tombstoneTitle }}" loading="eager">
                {% endif %}
                {# On-image prev/next -- the old text links tucked at the bottom of the 280px
                   sidebar needed a scroll to even see (2026-08-04 feedback); arrows over the
                   photo itself are the common pattern (any image viewer/carousel) and need no
                   scrolling to find. #}
                {% if prevUrl %}
                    <a href="{{ prevUrl }}" class="fp-detail__image-nav fp-detail__image-nav--prev" aria-label="{{ 'previous'|trans({}, 'folio') }}">
                        {{ ux_icon('tabler:chevron-left', {class: 'icon'}) }}
                    </a>
                {% endif %}
                {% if nextUrl %}
                    <a href="{{ nextUrl }}" class="fp-detail__image-nav fp-detail__image-nav--next" aria-label="{{ 'next'|trans({}, 'folio') }}">
                        {{ ux_icon('tabler:chevron-right', {class: 'icon'}) }}
                    </a>
                {% endif %}
            </div>

            <div class="fp-detail__sidebar">
                <div class="fp-detail__field">
                    <h6>{{ 'description'|trans({}, 'folio')|default('Description') }}</h6>
                    {% if tombstoneLocation %}<h5>{{ tombstoneLocation }}</h5>{% endif %}
                    {% if tombstoneDescription %}<div class="fp-detail__description">{{ tombstoneDescription }}</div>{% endif %}
                    {% if sourceCaption and sourceCaption != tombstoneDescription %}<div class="fp-detail__description">{{ sourceCaption }}</div>{% endif %}
                </div>

                {% if tombstoneYear %}
                    <div class="fp-detail__field fp-detail__field--inline">
                        <h6>{{ 'year'|trans({}, 'folio')|default('Year') }}</h6>
                        <h5>{{ tombstoneYear }}</h5>
                    </div>
                {% endif %}

                <div class="fp-detail__field fp-detail__field--inline">
                    <h6>{{ 'photo_id'|trans({}, 'folio')|default('Photo ID') }}</h6>
                    <h5>{{ row.localId }}</h5>
                </div>

                {% if tombstoneDonor or tombstoneCredit %}
                    {% set donorValue = tombstoneDonor ?: tombstoneCredit %}
                    <div class="fp-detail__field">
                        <h6>{{ 'donor'|trans({}, 'folio')|default('Donor') }}</h6>
                        {% if galleryUrl %}
                            <h5><a href="{{ galleryUrl }}?donor={{ donorValue|url_encode }}">{{ donorValue }}</a></h5>
                        {% else %}
                            <h5>{{ donorValue }}</h5>
                        {% endif %}
                    </div>
                {% endif %}

                {# Raw fortepan tags (row.extras.source_tags), NOT the resolved term-set `terms`
                   var used by the non-fortepan layout below -- these are the exact strings
                   Meilisearch's `tags` array-filter attribute was built from (see
                   FolioMeiliBuildSetCommand's "expose extras.source_tags as tags" step), so a
                   click here filters to precisely the same rows a `tags = 'X'` Meilisearch
                   filter would match. The term-set system resolves/codes values differently and
                   would silently mismatch. #}
                {% set rawTags = attribute(row.extras, 'source_tags')|default([]) %}
                {% if rawTags %}
                    <div class="fp-detail__field">
                        <h6>{{ 'tags'|trans({}, 'folio')|default('Tags') }}</h6>
                        <p class="fp-detail__tags">
                            {% for tagValue in rawTags %}
                                {% if galleryUrl %}<a href="{{ galleryUrl }}?tag={{ tagValue|url_encode }}">{{ tagValue }}</a>{% else %}<span>{{ tagValue }}</span>{% endif %}{% if not loop.last %}, {% endif %}
                            {% endfor %}
                        </p>
                    </div>
                {% endif %}

                <div class="fp-detail__actions">
                    {% if folio_bookmarks_enabled() %}
                        {{ include('@SurvosFolioBundle/bookmark/_widget.html.twig', {
                            folioCode: row.folioCode,
                            coreCode: coreCode,
                            localId: row.localId,
                            dtoType: row.dtoType ?: 'row',
                            label: tombstoneTitle,
                        }) }}
                    {% endif %}

                    {% if downloadUrl %}
                        {% set _sc = survos_stimulus('folio-bundle', 'download-button') %}
                        <button type="button" class="btn btn-outline-secondary"
                            {{ stimulus_controller(_sc, {
                                title: tombstoneTitle,
                                thumbnail: imageSource ? imageSource|imgproxy('display') : '',
                                creator: tombstoneCredit ?: tombstoneDonor,
                                date: tombstoneYear,
                                license: tombstoneLicense,
                                filename: downloadFilename,
                                citation: downloadCitation,
                                url: downloadUrl,
                            }) }}
                            {{ stimulus_action(_sc, 'download') }}
                        >
                            {{ ux_icon('tabler:download', {class: 'icon me-1'}) }}
                            {{ 'download'|trans({}, 'folio') }}
                        </button>
                    {% endif %}

                    {% set _sc = survos_stimulus('folio-bundle', 'share-button') %}
                    <button type="button" class="btn btn-outline-secondary"
                        {{ stimulus_controller(_sc, {url: shareUrl, title: tombstoneTitle}) }}
                        {{ stimulus_action(_sc, 'share') }}
                    >
                        {{ ux_icon('tabler:share-3', {class: 'icon me-1'}) }}
                        {{ 'share'|trans({}, 'folio') }}
                    </button>

                    {% if citationUrl %}
                        <a href="{{ citationUrl }}" class="btn btn-outline-secondary" target="_blank" rel="noopener">
                            {{ ux_icon('tabler:external-link', {class: 'icon me-1'}) }}
                            {{ 'source'|trans({}, 'folio') }}
                        </a>
                    {% endif %}
                </div>

            </div>
        </div>
    {% else %}
    <div class="folio-row">
        <div class="folio-row__image">
            {% if pages|length > 0 and useIiifViewer %}
                <twig:iiif:viewer
                    :images="viewerImages"
                    :hiresImages="viewerHires"
                    :infoUrls="viewerInfoUrls"
                    :manifestUrl="path('survos_folio_iiif_manifest', {folioCode: row.folioCode, coreCode: coreCode, localId: row.localId})"
                    :height="500"
                    :showLinks="false"
                />
            {% elseif imageSource %}
                {# Click-to-zoom disabled for now -- client dislikes OSD/IIIF viewer "bling" but
                   hasn't confirmed what (if any) zoom interaction they actually want, so just show
                   the plain image until that's clarified. simple_zoom_controller.js/CSS are left in
                   place in the bundle, just not wired up here.

                   'display', not 'archive': 'archive' is unbounded (0x0 = original resolution),
                   sized that way specifically for OSD's deep-zoom -- without a viewer, that was
                   downloading the full-res source into a plain <img> and made the page feel slow.
                   'display' is small for now on purpose; revisit sizing once zoom comes back. #}
                <img src="{{ imageSource|imgproxy('display') }}" alt="{{ tombstoneTitle }}" loading="eager">
            {% endif %}
        </div>

        <div class="folio-row__details">
            <h1 class="folio-row__title">{{ tombstoneTitle }}</h1>

            {% if tombstoneYear %}
                <div class="folio-row__date text-secondary">{{ tombstoneYear }}</div>
            {% endif %}

            {# Matches fortepan.hu's own detail panel field (YEAR / PHOTO ID / DONOR / TAGS) --
               row.localId is the same identifier already used for downloadFilename/citation
               above, just also shown here as a plain label since fortepan.hu always does. #}
            <div class="folio-row__local-id text-secondary">{{ 'photo_id'|trans({}, 'folio')|default('Photo ID') }}: {{ row.localId }}</div>

            {% if tombstoneLocation %}
                <div class="folio-row__location text-secondary">
                    {{ ux_icon('tabler:map-pin', {class: 'icon icon-sm me-1'}) }}{{ tombstoneLocation }}
                </div>
            {% endif %}

            {% if tombstoneDescription %}
                <p class="folio-row__description">{{ tombstoneDescription }}</p>
            {% endif %}

            {% if sourceCaption and sourceCaption != tombstoneDescription %}
                <p class="folio-row__source-caption text-secondary">{{ sourceCaption }}</p>
            {% endif %}

            {% if tombstoneCredit or tombstoneDonor %}
                <div class="folio-row__credit text-secondary">
                    {{ tombstoneCredit }}{% if tombstoneCredit and tombstoneDonor and tombstoneDonor != tombstoneCredit %} · {% endif %}
                    {% if tombstoneDonor and tombstoneDonor != tombstoneCredit %}{{ 'donor'|trans({}, 'folio') }}: {{ tombstoneDonor }}{% endif %}
                </div>
            {% endif %}

            {% if terms %}
                <div class="folio-row__terms mt-2">
                    {% for set, values in terms %}
                        {% for value in values %}
                            {% if value.term %}
                                <a
                                    class="badge text-bg-light border me-1 mb-1 text-decoration-none"
                                    href="{{ path('survos_folio_term_show', {folioCode: row.folioCode, setCode: set, termCode: value.code}) }}"
                                >
                                    {{ value.label }}
                                </a>
                            {% else %}
                                <span class="badge text-bg-light border me-1 mb-1">{{ value.label }}</span>
                            {% endif %}
                        {% endfor %}
                    {% endfor %}
                </div>
            {% endif %}

            <div class="folio-row__actions d-flex flex-wrap gap-2 mt-3">
                {% if folio_bookmarks_enabled() %}
                    {{ include('@SurvosFolioBundle/bookmark/_widget.html.twig', {
                        folioCode: row.folioCode,
                        coreCode: coreCode,
                        localId: row.localId,
                        dtoType: row.dtoType ?: 'row',
                        label: tombstoneTitle,
                    }) }}
                {% endif %}

                {% if downloadUrl %}
                    {% set _sc = survos_stimulus('folio-bundle', 'download-button') %}
                    <button type="button" class="btn btn-outline-secondary"
                        {{ stimulus_controller(_sc, {
                            title: tombstoneTitle,
                            thumbnail: imageSource ? imageSource|imgproxy('display') : '',
                            creator: tombstoneCredit ?: tombstoneDonor,
                            date: tombstoneYear,
                            license: tombstoneLicense,
                            filename: downloadFilename,
                            citation: downloadCitation,
                            url: downloadUrl,
                        }) }}
                        {{ stimulus_action(_sc, 'download') }}
                    >
                        {{ ux_icon('tabler:download', {class: 'icon me-1'}) }}
                        {{ 'download'|trans({}, 'folio') }}
                    </button>
                {% endif %}

                {% set _sc = survos_stimulus('folio-bundle', 'share-button') %}
                <button type="button" class="btn btn-outline-secondary"
                    {{ stimulus_controller(_sc, {url: shareUrl, title: tombstoneTitle}) }}
                    {{ stimulus_action(_sc, 'share') }}
                >
                    {{ ux_icon('tabler:share-3', {class: 'icon me-1'}) }}
                    {{ 'share'|trans({}, 'folio') }}
                </button>

                {% if citationUrl %}
                    <a href="{{ citationUrl }}" class="btn btn-outline-secondary" target="_blank" rel="noopener">
                        {{ ux_icon('tabler:external-link', {class: 'icon me-1'}) }}
                        {{ 'source'|trans({}, 'folio') }}
                    </a>
                {% endif %}
            </div>
        </div>
    </div>

    {% if prevUrl or nextUrl %}
        <div class="folio-row__nav d-flex justify-content-between mt-4">
            <div>
                {% if prevUrl %}
                    <a href="{{ prevUrl }}" class="btn btn-link px-0">&larr; {{ 'previous'|trans({}, 'folio') }}</a>
                {% endif %}
            </div>
            <div>
                {% if nextUrl %}
                    <a href="{{ nextUrl }}" class="btn btn-link px-0">{{ 'next'|trans({}, 'folio') }} &rarr;</a>
                {% endif %}
            </div>
        </div>
    {% endif %}
    {% endif %}
{% endif %}

<style>
    .folio-row {
        display: flex;
        flex-wrap: wrap;
        gap: 2rem;
        align-items: flex-start;
    }
    .folio-row__image {
        flex: 1 1 55%;
        min-width: 280px;
    }
    .folio-row__image img {
        width: 100%;
        height: auto;
        border-radius: 0.5rem;
        display: block;
    }
    /* Simplest possible zoom: click fills the viewport with the photo (dimmed backdrop),
       click again or Escape to close -- see simple_zoom_controller.js. */
    .folio-row__zoom {
        cursor: zoom-in;
    }
    .folio-row__zoom.is-zoomed {
        position: fixed;
        inset: 0;
        z-index: 1050;
        display: flex;
        align-items: center;
        justify-content: center;
        background: rgba(0, 0, 0, 0.9);
        cursor: zoom-out;
    }
    .folio-row__zoom.is-zoomed img {
        width: auto;
        height: auto;
        max-width: 96vw;
        max-height: 96vh;
        object-fit: contain;
        border-radius: 0;
    }
    .folio-row__details {
        flex: 1 1 35%;
        min-width: 240px;
    }
    .folio-row__title {
        font-size: clamp(1.5rem, 3vw, 2.25rem);
        margin-bottom: 0.5rem;
    }
    @media screen and (max-width: 767px) {
        .folio-row__image,
        .folio-row__details {
            flex-basis: 100%;
        }
    }
</style>
