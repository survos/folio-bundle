{# templates/components/PhotoGrid.html.twig
   Justified-grid, infinite-scroll photo browser. See src/Twig/Components/PhotoGrid.php
   for the props/data-source contract. #}
{% set controllerName = survos_stimulus('folio-bundle', 'photo-grid') %}

<div
    class="folio-photo-grid"
    {{ stimulus_controller(controllerName, {
        endpoint: endpoint,
        itemsPerPage: itemsPerPage,
        page: 2,
        filters: filters,
    }) }}
>
    <div class="folio-photo-grid__items" {{ stimulus_target(controllerName, 'grid') }}>
        {% for item in items %}
            <a href="{{ item.citationUrl ?? '#' }}"
               class="folio-photo-grid__item"
               title="{{ item.label }}"
               {% if item.citationUrl %}target="_blank" rel="noopener"{% endif %}>
                {% if item.thumbnailUrl %}
                    <img src="{{ item.thumbnailUrl|imgproxy('thumb') }}" alt="{{ item.label }}" loading="lazy" decoding="async">
                {% endif %}
            </a>
        {% endfor %}
    </div>

    <div class="folio-photo-grid__loader" {{ stimulus_target(controllerName, 'loader') }} hidden>
        {{ 'Loading…'|trans }}
    </div>
</div>

<style>
    /* Justified-row grid — same trick fortepan.hu uses (a flex-wrap row with a
       flex-grow trailing spacer), not a masonry/column layout. */
    .folio-photo-grid__items {
        display: flex;
        flex-wrap: wrap;
        gap: 0.5rem;
    }
    .folio-photo-grid__items::after {
        content: '';
        flex-grow: 999999999;
    }
    .folio-photo-grid__item {
        flex: 192 1 0%;
        min-width: 12rem;
        display: block;
        aspect-ratio: 4 / 3;
        overflow: hidden;
        background: var(--tblr-secondary-bg, #f5f6f7);
        border-radius: 0.375rem;
    }
    .folio-photo-grid__item img {
        width: 100%;
        height: 100%;
        object-fit: cover;
        display: block;
    }
    @media screen and (max-width: 639px) {
        .folio-photo-grid__item {
            flex: 128 1 0%;
            min-width: 8rem;
        }
    }
    .folio-photo-grid__loader {
        text-align: center;
        padding: 1rem;
        color: var(--tblr-secondary-color, #8c8c8c);
    }
</style>
