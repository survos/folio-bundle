{# templates/components/PhotoGrid.html.twig
   Masonry-style, infinite-scroll photo browser. See src/Twig/Components/PhotoGrid.php
   for the props/data-source contract. #}
{% set _sc = survos_stimulus('folio-bundle', 'photo-grid') %}
{# Mirrors ImageUrlVerdict::label() (survos/data-contracts) and PLACEHOLDER_LABELS in
   photo_grid_controller.js -- the enum is the source of truth; items reach this template as
   decoded API arrays, so the verdict arrives as a bare string that needs labelling here. #}
{% set imageVerdictLabels = {
    image: 'Image',
    unverifiable: 'Unverified (no extension)',
    document: 'Document (not rasterisable)',
    not_an_image: 'Not an image',
    empty: 'No image URL',
} %}

<div
    class="folio-photo-grid"
    {# If getItems() couldn't server-render page 1 (see PhotoGrid.php's try/catch around the
       self-referential HTTP call), items is empty -- start the client-side fetch at page 1
       instead of 2, so the grid still fills in once the browser mounts. #}
    {{ stimulus_controller(_sc, {
        endpoint: endpoint,
        itemsPerPage: itemsPerPage,
        page: items|length > 0 ? 2 : 1,
        filters: filtersForStimulus,
        rowUrlTemplate: rowUrlTemplate,
        homeCountryCode: homeCountryCode ?? '',
    }) }}
>
    {# Debug-only text filter (FolioRowProvider's crude LIKE `q`, not real Meilisearch search --
       see that provider's own comment) -- lets a year picked on the timeline combine with a
       text query while testing timeline context. Admin/debug-gated, same convention as
       tenant/base.html.twig's admin toolbar -- not meant as a real search feature. #}
    {% if is_granted('ROLE_ADMIN') or app.debug %}
        <div class="folio-photo-grid__debug-search">
            <input
                type="search"
                placeholder="{{ 'debug_search_placeholder'|trans({}, 'folio')|default('Debug: filter by text (combines with the timeline year)') }}"
                {{ stimulus_target(_sc, 'search') }}
                {{ stimulus_action(_sc, 'search', 'input') }}
            >
        </div>
    {% endif %}

    <div class="folio-photo-grid__items" {{ stimulus_target(_sc, 'grid') }}>
        {% for item in items %}
            {# extras.place is already a pre-joined "City, State, Country" string (see the
               ingest pipeline); dtoData.city/state/country is the fallback for items that
               don't have it, same fields the search hit cards use (folio_row.html.twig). #}
            {% set rawPlace = item.extras.place|default(
                [item.dtoData.city|default(null), item.dtoData.state|default(null), item.dtoData.country|default(null)]|filter(v => v is not empty)|join(', ')
            ) %}
            {# A single-country folio (homeCountryCode set, e.g. fpus is always "us") suppresses
               the flag and the trailing ", <country>" for photos actually from that country --
               out-of-region photos are the interesting exceptions, so they're the ones that keep
               the flag/country and stand out. #}
            {# countryFlagCode is only present at all when Row::getCountryFlagCode() resolved a
               real ISO code (skip_null_values omits it entirely for items with no/unmatched
               country) -- |default(null) is required here, not optional, or any item missing
               the key 500s the whole grid. #}
            {% set isHomeCountry = homeCountryCode is defined and homeCountryCode and item.countryFlagCode|default(null) and item.countryFlagCode|lower == homeCountryCode|lower %}
            {% set place = isHomeCountry and item.dtoData.country|default(null)
                ? rawPlace|replace({(', ' ~ item.dtoData.country): ''})
                : rawPlace %}
            {% set year = item.dtoData.year|default(null) %}
            {# No override (the common case): item.rp is exactly survos_folio_row_show's param
               shape (Row::getRp()) — path() needs no placeholder templating at all. A host
               override still uses the placeholder tokens, since its own route rarely matches
               rp's shape (see PhotoGrid.php::$rowUrlTemplate).
               The active filters (q/tag/donor/yearMin) ride along as a query string so the
               detail page a click lands on can compute real prev/next WITHIN this same
               filtered/sorted result set instead of the whole unfiltered folio -- see
               TenantController::photo()'s meiliAdjacentUrls() (2026-08-04). #}
            <a href="{{ rowUrlTemplate is empty
                    ? path('survos_folio_row_show', item.rp)
                    : rowUrlTemplate|replace({
                        '__CORE_CODE__': item.rp.coreCode|default(''),
                        '__DTO_TYPE__': item.rp.dtoType|default(''),
                        '__LOCAL_ID__': item.rp.localId|default(''),
                    }) }}{{ filters is not empty ? '?' ~ filters|url_encode : '' }}"
               class="folio-photo-grid__item"
               title="{{ item.label }}"
               {% if year %}data-year="{{ year }}"{% endif %}>
                {# thumbnailUrl is already a signed imgproxy URL -- FolioRowProvider::resolveThumbnails()
                   resolves it server-side (both for this page-1 render and the client-fetched pages
                   the Stimulus controller appends). Applying |imgproxy() again here would double-proxy
                   every image (imgproxy fetching its own already-proxied output as the "source"). #}
                {% if item.thumbnailUrl %}
                    <img src="{{ item.thumbnailUrl }}" alt="{{ item.label }}" loading="lazy" decoding="async">
                {% else %}
                    {# No renderable image: either the record genuinely has none, or what was
                       harvested is a viewer config/landing page/PDF that imgproxy cannot
                       rasterise. Say which, rather than emitting a request that 403s
                       (survos-sites/musdig#40).

                       NB `item` here is a decoded API array (getItems() returns JSON members,
                       not Row entities), so imageVerdict is the enum's *string* value -- not an
                       enum instance to call .label() on. #}
                    {% set verdict = item.imageVerdict|default('empty') %}
                    <div class="folio-photo-grid__placeholder" data-verdict="{{ verdict }}">
                        <span class="folio-photo-grid__placeholder-label">{{ imageVerdictLabels[verdict]|default(imageVerdictLabels.empty) }}</span>
                    </div>
                {% endif %}
                {% if year or place %}
                    <div class="folio-photo-grid__caption">
                        {% if year %}<span class="folio-photo-grid__caption-year">{{ year }}</span>{% endif %}
                        {% if place %}
                            <span class="folio-photo-grid__caption-place">
                                {% if item.countryFlagCode|default(null) and not isHomeCountry %}<span class="fi fi-{{ item.countryFlagCode|lower }}"></span>{% endif %}
                                {{ place }}
                            </span>
                        {% endif %}
                    </div>
                {% endif %}
            </a>
        {% endfor %}
    </div>

    {# Deliberately NOT `hidden` -- a display:none element can never register as
       intersecting with IntersectionObserver, so the controller's scroll-triggered
       loadMore() would never fire. Visibility is toggled via the is-loading class
       instead, which keeps this in the layout (and therefore observable) at rest. #}
    <div class="folio-photo-grid__loader" {{ stimulus_target(_sc, 'loader') }}>
        {{ 'loading'|trans({}, 'folio') }}
    </div>

    {# Sticky year scrubber (Google Photos-style) -- built entirely from years already present
       in the DOM (SSR items' data-year, then whatever the controller appends), no separate
       "counts per year" endpoint. Ticks are added lazily as new years are encountered, and
       clicking one scrolls to that year's first-seen photo, which is only possible because that
       photo is already loaded -- a year further down that hasn't been fetched yet has no tick. #}
    <div class="folio-photo-grid__timeline" {{ stimulus_target(_sc, 'timeline') }}></div>
</div>

<style>
    .folio-photo-grid__debug-search {
        margin-bottom: 0.75rem;
    }
    .folio-photo-grid__debug-search input {
        width: 100%;
        max-width: 420px;
        padding: 0.375rem 0.75rem;
        font-size: 0.8125rem;
        border: 1px dashed var(--tblr-border-color, #ccc);
        border-radius: 0.25rem;
        background: repeating-linear-gradient(
            45deg,
            transparent, transparent 8px,
            rgba(245, 159, 0, 0.06) 8px, rgba(245, 159, 0, 0.06) 16px
        );
    }
    /* Masonry, laid out by photo_grid_controller.js: items keep their natural aspect ratio
       (no forced crop) AND read left-to-right in sort order. Plain CSS multi-column
       (`columns:`) was tried first and dropped -- it balances by total column height, which
       fills column 1 with the first N items, column 2 with the next N, etc, so a year-sorted
       list no longer *reads* sorted left-to-right even though the underlying order is
       correct. The controller round-robins items into these flex columns instead. */
    .folio-photo-grid__items {
        display: flex;
        align-items: flex-start;
        gap: 0.5rem;
    }
    .folio-photo-grid__column {
        flex: 1 1 0;
        min-width: 0;
        display: flex;
        flex-direction: column;
        gap: 0.5rem;
    }
    .folio-photo-grid__item {
        position: relative;
        display: block;
        overflow: hidden;
        background: var(--tblr-secondary-bg, #f5f6f7);
        border-radius: 0.375rem;
    }
    .folio-photo-grid__item img {
        width: 100%;
        height: auto;
        display: block;
    }
    /* Explicit stand-in for a row with no renderable image. Given a fixed aspect ratio so the
       masonry columns still have something to lay out (an empty <a> would collapse to zero
       height and the tile would silently vanish from the grid). */
    .folio-photo-grid__placeholder {
        display: flex;
        align-items: center;
        justify-content: center;
        aspect-ratio: 4 / 3;
        padding: 0.5rem;
        text-align: center;
        border: 1px dashed var(--tblr-border-color, #ccc);
        border-radius: 0.375rem;
        color: var(--tblr-secondary-color, #667382);
        font-size: 0.75rem;
        line-height: 1.3;
    }
    /* A wrong-field harvest bug, not merely a record without a photo -- worth being visually
       distinct so it reads as "broken" rather than "empty" while browsing. */
    .folio-photo-grid__placeholder[data-verdict="not_an_image"] {
        border-color: var(--tblr-danger, #d63939);
        color: var(--tblr-danger, #d63939);
    }
    /* Overlaid on the bottom of the photo (Unsplash/Pinterest-style caption) rather than
       taking up extra flow height -- keeps the masonry columns driven purely by each
       photo's own aspect ratio. */
    .folio-photo-grid__caption {
        position: absolute;
        left: 0;
        right: 0;
        bottom: 0;
        padding: 1.25rem 0.6rem 0.4rem;
        background: linear-gradient(to top, rgba(0, 0, 0, 0.75), rgba(0, 0, 0, 0));
        color: #fff;
        font-size: 0.75rem;
        line-height: 1.3;
        display: flex;
        flex-direction: column;
        gap: 0.1rem;
    }
    .folio-photo-grid__caption-year {
        font-weight: 600;
    }
    .folio-photo-grid__caption-place {
        opacity: 0.85;
        white-space: nowrap;
        overflow: hidden;
        text-overflow: ellipsis;
    }
    .folio-photo-grid__caption-place .fi {
        width: 0.9rem;
        margin-right: 0.2rem;
        vertical-align: -1px;
    }
    .folio-photo-grid__loader {
        text-align: center;
        padding: 1rem;
        color: var(--tblr-secondary-color, #8c8c8c);
        visibility: hidden;
    }
    .folio-photo-grid__loader.is-loading {
        visibility: visible;
    }
    /* Docked to the viewport edge (not the grid column) so it stays put regardless of the
       grid's own width/scroll position -- same idea as Google Photos' year scrubber. */
    .folio-photo-grid__timeline {
        position: fixed;
        right: 10px;
        top: 50%;
        transform: translateY(-50%);
        z-index: 20;
        display: flex;
        flex-direction: column;
        align-items: flex-end;
        gap: 1px;
        max-height: 70vh;
        overflow-y: auto;
        scrollbar-width: none;
    }
    .folio-photo-grid__timeline::-webkit-scrollbar {
        display: none;
    }
    .folio-photo-grid__timeline-tick {
        border: none;
        background: none;
        padding: 1px 0.6rem;
        font-size: 0.7rem;
        line-height: 1.4;
        color: var(--tblr-secondary-color, #8c8c8c);
        cursor: pointer;
        opacity: 0.55;
        transition: opacity .15s ease, font-size .15s ease;
    }
    .folio-photo-grid__timeline-tick:hover {
        opacity: 1;
    }
    .folio-photo-grid__timeline-tick.is-active {
        opacity: 1;
        font-weight: 700;
        font-size: 0.8rem;
        color: var(--tblr-primary, #206bc4);
    }
    @media screen and (max-width: 767px) {
        /* Not enough horizontal room next to the content alongside a narrow viewport. */
        .folio-photo-grid__timeline {
            display: none;
        }
    }
</style>
