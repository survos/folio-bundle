{
  "name": "@survos/folio-bundle",
  "description": "Folio browsing Stimulus controllers.",
  "keywords": [
    "symfony-ux",
    "ux"
  ],
  "symfony": {
    "controllers": {
      "chat": {
        "main": "controllers/chat_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "slideshow": {
        "main": "controllers/slideshow_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "map": {
        "main": "controllers/map_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "photo-grid": {
        "main": "controllers/photo_grid_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "bookmark": {
        "main": "controllers/bookmark_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "bookmark-badge": {
        "main": "controllers/bookmark_badge_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "share-button": {
        "main": "controllers/share_button_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "download-button": {
        "main": "controllers/download_button_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      },
      "simple-zoom": {
        "main": "controllers/simple_zoom_controller.js",
        "enabled": true,
        "fetch": "lazy",
        "autoimport": []
      }
    }
  },
  "peerDependencies": {
    "@hotwired/stimulus": "^3.2.0",
    "sweetalert2": "^11.0.0"
  }
}
